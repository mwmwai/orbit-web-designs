---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import Pricing from "../components/Pricing.astro";
import CtaBand from "../components/CtaBand.astro";

const faqs = [
	{
		q: "How long does it take to build my website?",
		a: "Starter 48–72 hours, Business ~5 days, Master 7–10 days once we have your photos/text/logo. You approve the design before anything goes live — date in writing.",
	},
	{
		q: "Are revisions included?",
		a: "Yes — you approve the design before launch, we revise until you're happy. If we part ways early, you only pay for work already done.",
	},
	{
		q: "Do you write the content for me?",
		a: "Yes. Copy polishing is included in every tier — we structure and write conversion-focused pages from what you provide. See deliverables on each package.",
	},
	{
		q: "What happens after launch? Orbit Care?",
		a: "Orbit Care keeps it alive: hosting, SSL, security, updates, backups and WhatsApp support — 7,599/mo Starter, 9,599 Business, 11,999 Master. Cancel anytime, site stays yours. Details in our Website Care guide.",
	},
];

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: f.a,
		},
	})),
};
---

<Layout
	title="Packages & Pricing — Websites from KES 29,999 | Orbit Web Designs & Marketing"
	description="Honest flexible pricing in Kenyan shillings. Professional websites from KES 29,999 — pay securely via M-Pesa, card, or PayPal. No hidden fees."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
				<div class="absolute top-20 right-0 h-[360px] w-[360px] rounded-full bg-neon/10 blur-[120px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-10 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Packages · 8 ways to ship</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Simple packages, <span class="text-gradient">serious results.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					Honest KES pricing — websites 29,999–49,999 · SaaS 49,999 · Design 14,999 · Agents 49,999 · Dashboards 19,999. No hidden fees. M-Pesa, card, PayPal.
				</p>
				<div class="mt-8 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
					<div class="glow-border rounded-xl p-3 text-center"><p class="text-gradient text-xl font-extrabold">50+</p><p class="text-xs text-slate-400">sites shipped</p></div>
					<div class="glow-border rounded-xl p-3 text-center"><p class="text-gradient text-xl font-extrabold">48–72h</p><p class="text-xs text-slate-400">Starter live</p></div>
					<div class="glow-border rounded-xl p-3 text-center"><p class="text-gradient text-xl font-extrabold">M-Pesa</p><p class="text-xs text-slate-400">native</p></div>
					<div class="glow-border rounded-xl p-3 text-center"><p class="text-gradient text-xl font-extrabold">Minutes</p><p class="text-xs text-slate-400">reply time</p></div>
				</div>
			</div>
			<div class="border-y border-white/5 bg-charcoal/40">
				<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-5 py-3 font-mono text-xs uppercase tracking-widest text-slate-400">
					<span>★★★★★ 5.0 verified</span><span class="text-electric">·</span><span>Cancel anytime</span><span class="text-electric">·</span><span>Your files, your domain</span><span class="text-electric">·</span><span>Training included</span>
				</div>
			</div>
		</section>

		<Pricing />

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto max-w-7xl px-5">
				<h2 class="text-xl font-bold text-white">What you get — deliverables per package</h2>
				<div class="mt-6 overflow-hidden rounded-xl border border-edge">
					<table class="w-full text-left text-sm"><thead class="bg-panel text-xs uppercase tracking-widest text-slate-400"><tr><th class="px-4 py-3">Deliverable</th><th class="px-4 py-3">Starter 29,999</th><th class="px-4 py-3">Business 39,999</th><th class="px-4 py-3">Master 49,999</th></tr></thead>
					<tbody class="divide-y divide-edge text-slate-300">
						<tr><td class="px-4 py-2 font-semibold text-white">Pages</td><td class="px-4 py-2">1–3</td><td class="px-4 py-2">Up to 7</td><td class="px-4 py-2">Store / booking</td></tr>
						<tr><td class="px-4 py-2 font-semibold text-white">Domain + SSL + hosting setup</td><td class="px-4 py-2">✓</td><td class="px-4 py-2">✓</td><td class="px-4 py-2">✓</td></tr>
						<tr><td class="px-4 py-2 font-semibold text-white">Copy + SEO (titles, GBP)</td><td class="px-4 py-2">Basic</td><td class="px-4 py-2">Full</td><td class="px-4 py-2">Advanced (buyer)</td></tr>
						<tr><td class="px-4 py-2 font-semibold text-white">M-Pesa / payments</td><td class="px-4 py-2">WhatsApp button</td><td class="px-4 py-2">Booking link</td><td class="px-4 py-2">Native Till/Paybill + cards</td></tr>
						<tr><td class="px-4 py-2 font-semibold text-white">Training + docs</td><td class="px-4 py-2">✓ walkthrough</td><td class="px-4 py-2">✓ + handover</td><td class="px-4 py-2">✓ + stock/orders</td></tr>
						<tr><td class="px-4 py-2 font-semibold text-white">Ownership</td><td class="px-4 py-2" colspan="3">Your domain, content, files, credentials — full license per <a href="/terms-of-service" class="text-electric hover:underline">Terms</a></td></tr>
					</tbody></table>
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto max-w-7xl px-5">
				<div class="grid gap-4 md:grid-cols-3">
					<a href="/care" class="glow-border edge-glow card-shine rounded-2xl p-6 flex items-center gap-4 hover-lift">
						<span class="h-10 w-10 rounded-xl bg-gradient-to-br from-electric to-neon flex items-center justify-center text-white">✓</span>
						<div><p class="font-semibold text-white">Orbit Care</p><p class="text-xs text-slate-400">7,599–11,999/mo + custom SaaS/Dash/Agent</p></div>
						<span class="ml-auto text-electric">→</span>
					</a>
					<a href="/automation" class="glow-border edge-glow card-shine rounded-2xl p-6 flex items-center gap-4 hover-lift">
						<span class="h-10 w-10 rounded-xl bg-gradient-to-br from-violet-500 to-electric flex items-center justify-center text-white">◈</span>
						<div><p class="font-semibold text-white">Agents & Workflows</p><p class="text-xs text-slate-400">49,999 · 39,999 + API honesty</p></div>
						<span class="ml-auto text-electric">→</span>
					</a>
					<a href="/dashboards" class="glow-border edge-glow card-shine rounded-2xl p-6 flex items-center gap-4 hover-lift">
						<span class="h-10 w-10 rounded-xl bg-gradient-to-br from-neon to-electric flex items-center justify-center text-white">▦</span>
						<div><p class="font-semibold text-white">Dashboards</p><p class="text-xs text-slate-400">19,999 Add-on · 39,999 Standalone</p></div>
						<span class="ml-auto text-electric">→</span>
					</a>
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-20">
			<div class="mx-auto max-w-7xl px-5">
				<div class="reveal mb-10 max-w-xl">
					<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Frequently asked questions</h2>
					<p class="mt-4 text-slate-400">Everything you need to know before we start building.</p>
				</div>
				<div class="grid gap-4 lg:grid-cols-2">
					{
						faqs.map((f, i) => (
							<details class="reveal glow-border group rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
								<summary class="cursor-pointer list-none font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">
									{f.q}
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-5">
				<span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Keep exploring:</span>
				<a href="/about" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">About Orbit</a>
				<a href="/guides" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Guides</a>
				<a href="/faq" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">FAQ</a>
				<a href="/reviews" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Reviews</a>
			</div>
		</section>

		<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

		<CtaBand />
	</main>
	<Footer />
</Layout>

