---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<div class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3">
	<button
		id="to-top"
		type="button"
		aria-label="Back to top"
		class="grid h-11 w-11 translate-y-3 place-items-center rounded-full border border-edge bg-panel/90 text-slate-300 opacity-0 backdrop-blur transition-all duration-300 hover:border-electric/60 hover:text-white magnetic ripple"
	>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 19V5M5 12l7-7 7 7" />
		</svg>
	</button>

	<a
		id="wa-floating"
		href={whatsappLink(DEFAULT_WA_MESSAGE)}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Chat on WhatsApp"
		class="group relative grid h-14 w-14 scale-0 place-items-center rounded-full bg-[#25D366] text-white shadow-xl shadow-[#25D366]/30 transition-all duration-500 hover:scale-110"
		style="animation: waIn 0.6s cubic-bezier(0.22,1,0.36,1) 1.2s forwards"
	>
		<span class="absolute inset-0 animate-ping rounded-full bg-[#25D366] opacity-20" aria-hidden="true"></span>
		<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91A9.85 9.85 0 0012.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 018.24 8.24c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.69-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.73-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.29z" />
		</svg>
		<span class="pointer-events-none absolute right-full mr-3 hidden whitespace-nowrap rounded-lg border border-edge bg-panel px-3 py-2 text-xs text-slate-200 opacity-0 backdrop-blur transition group-hover:opacity-100 md:block">
			Talk to us — replies in hours
		</span>
	</a>
</div>

<style>
	@keyframes waIn {
		from { transform: scale(0); }
		to { transform: scale(1); }
	}
	#to-top.show {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	function trackWA(eventName) {
		if (typeof window !== "undefined" && window.gtag) {
			window.gtag("event", eventName, { event_category: "WhatsApp", event_label: eventName });
		}
		if (typeof window !== "undefined" && window.fbq) {
			window.fbq("track", "Contact", { content_name: eventName });
		}
	}

	function initFloating() {
		const top = document.getElementById("to-top");
		const wa = document.getElementById("wa-floating");
		if (top && !top.dataset.bound) {
			top.dataset.bound = "1";
			top.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
		}
		if (wa && !wa.dataset.bound) {
			wa.dataset.bound = "1";
			wa.addEventListener("click", () => trackWA("floating_whatsapp"));
		}
	}
	function onScroll() {
		const top = document.getElementById("to-top");
		if (top) top.classList.toggle("show", window.scrollY > 600);
		const bar = document.getElementById("scroll-progress");
		if (bar) {
			const h = document.documentElement;
			const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
			bar.style.width = pct + "%";
		}
	}
	window.addEventListener("scroll", onScroll, { passive: true });
	document.addEventListener("astro:page-load", () => {
		initFloating();
		onScroll();
	});
</script>
