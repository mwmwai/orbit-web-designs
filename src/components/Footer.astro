---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
	<div class="mx-auto max-w-7xl px-5">
		<div class="flex flex-col items-center justify-between gap-8 md:flex-row md:items-start">
			<div class="text-left">
				<a href="#top" class="inline-flex items-center gap-3">
					<img src="/logo.svg" alt="Orbit logo" width={34} height={34} />
					<span class="leading-none">
						<span class="block text-sm font-extrabold tracking-[0.22em] text-slate-200">ORBIT</span>
						<span class="mt-1 block text-[8px] font-semibold uppercase tracking-[0.24em] text-slate-500">Web Designs &amp; Marketing</span>
					</span>
				</a>
				<p class="mt-3 max-w-xs text-sm text-slate-500">
					Websites and digital marketing that grow Kenyan businesses.
				</p>
			</div>

			<nav class="grid grid-cols-2 gap-x-12 gap-y-3 text-sm sm:flex sm:gap-8" aria-label="Footer">
				<a href="#services" class="text-slate-400 transition hover:text-white">Services</a>
				<a href="#why-us" class="text-slate-400 transition hover:text-white">Why Us</a>
				<a href="#work" class="text-slate-400 transition hover:text-white">Our Work</a>
				<a href="#pricing" class="text-slate-400 transition hover:text-white">Pricing</a>
				<a href="#contact" class="text-slate-400 transition hover:text-white">Contact</a>
				<a href="mailto:mwmwai@gmail.com" class="text-slate-400 transition hover:text-white">Email Us</a>
			</nav>
		</div>

		<div class="mt-10 border-t border-white/5 pt-6 text-xs text-slate-500">
			© {year} Orbit Web Designs & Marketing. All rights reserved.
		</div>
	</div>
</footer>


