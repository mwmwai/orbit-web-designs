---
import { whatsappLink } from "../config";
---

<div id="orbit-assistant" class="fixed bottom-6 left-6 z-[110] flex flex-col items-start gap-3" client:load>
	<div id="oa-panel" class="hidden w-[22rem] max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-2xl border border-edge bg-panel/95 shadow-2xl shadow-black/60 backdrop-blur md:w-96">
		<div class="border-b border-white/5 bg-gradient-to-r from-electric/15 to-neon/10 px-5 py-4">
		<div class="flex items-center justify-between gap-2">
			<div class="flex items-center gap-2">
				<div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.6)]"></div>
				<p class="font-semibold text-white">Orbit AI</p>
				<span class="rounded-full bg-electric/10 px-2 py-0.5 text-[10px] font-bold tracking-widest text-electric">POWERED</span>
			</div>
			<span id="oa-status" class="text-[10px] text-slate-500">…</span>
		</div>
			<p class="text-xs text-slate-400">Quotes • M-Pesa math • best fit — then WhatsApp</p>
		</div>
		<div id="oa-log" class="grid max-h-80 gap-3 overflow-y-auto px-5 py-4 text-sm"></div>
		<div id="oa-typing" class="hidden px-5 h-6">
			<div class="flex items-center gap-1.5 text-slate-400 text-xs">
				<span class="h-1.5 w-1.5 rounded-full bg-electric animate-bounce" style="animation-delay: 0ms;"></span>
				<span class="h-1.5 w-1.5 rounded-full bg-electric animate-bounce" style="animation-delay: 150ms;"></span>
				<span class="h-1.5 w-1.5 rounded-full bg-electric animate-bounce" style="animation-delay: 300ms;"></span>
				<span class="ml-2">Orbit is thinking…</span>
			</div>
		</div>
		<div id="oa-actions" class="flex flex-wrap gap-2 px-5 pb-2"></div>
		<div class="flex gap-2 border-t border-white/5 p-3">
			<input id="oa-input" type="text" placeholder="Ask me anything…" aria-label="Ask the assistant" class="min-w-0 flex-1 rounded-full border border-edge bg-charcoal px-4 py-2.5 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-electric" />
			<button id="oa-send" type="button" aria-label="Send" class="shrink-0 rounded-full btn-gradient px-4 py-2.5 text-sm font-semibold text-white">→</button>
		</div>
	</div>
	<button
		id="oa-toggle"
		type="button"
		aria-label="Chat with Orbit AI"
		class="grid h-14 w-14 place-items-center rounded-full border border-electric/40 bg-panel/90 text-electric shadow-xl shadow-electric/20 backdrop-blur transition hover:scale-105"
	>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" /></svg>
	</button>
</div>

<script>
	(() => {
		const STORAGE_KEY = "orbit_assistant_memory";
		const WA = "https://wa.me/254741992308?text=";
		const waLink = (q: string) => WA + encodeURIComponent("Hi Orbit! " + q);

		type Mem = { chat: Array<{ r: string; t: string }>; name: string; email: string; phone: string; interests: Record<string, number>; visits: number; lastTopic: string; qualified: null | { need: string; budget: string; package: string } };
		function loadMemory(): Mem {
			const empty: Mem = { chat: [], name: "", email: "", phone: "", interests: {}, visits: 0, lastTopic: "", qualified: null };
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return empty;
				const m = JSON.parse(raw);
				const chat = Array.isArray(m.chat) ? m.chat.map((e: any) =>
					typeof e === "string"
						? { r: "u", t: e }
						: (e && typeof e.t === "string" ? { r: e.r === "a" ? "a" : "u", t: e.t } : null)
				).filter(Boolean).slice(-20) : [];
				return {
					chat,
					name: m.name || "",
					email: m.email || "",
					phone: m.phone || "",
					interests: m.interests && typeof m.interests === "object" ? m.interests : {},
					visits: typeof m.visits === "number" ? m.visits : 0,
					lastTopic: m.lastTopic || "",
					qualified: m.qualified && m.qualified.package ? m.qualified : null,
				};
			} catch { return empty; }
		}
		function saveMemory(m: Mem) {
			try { localStorage.setItem(STORAGE_KEY, JSON.stringify(m)); } catch {}
		}
		function extractUser(q: string): { name?: string; email?: string; phone?: string } {
			const info: { name?: string; email?: string; phone?: string } = {};
			const emailM = q.match(/[\w.+-]+@[\w-]+\.[\w.+-]+/);
			if (emailM) info.email = emailM[0];
			const phoneM = q.match(/\+?254[\s.-]?\d{3}[\s.-]?\d{3}[\s.-]?\d{3}/);
			if (phoneM) info.phone = phoneM[0].replace(/\s/g, "");
			const nameM = q.match(/(?:my name is|I am|I'm|call me)\s+([A-Z][a-z]+(?:\s[A-Z][a-z]+)?)/i);
			if (nameM) info.name = nameM[1];
			return info;
		}

		const ACTIONS: Array<{ label: string; ask: string; reply: string; link?: [string, string]; wa: string }> = [
			{ label: "🛒 I want an online store", ask: "I want an online store", reply: "Master **KES 59,999** is the store package: native M-Pesa + cards, stock that subtracts itself, WhatsApp order pings, buyer SEO. Live 2 weeks. First, price your margins:", link: ["/mpesa-fee-calculator", "M-Pesa calculator →"], wa: "Hi Orbit! I want an online store (Master 59,999). I sell..." },
			{ label: "📅 I want bookings", ask: "I want to take bookings", reply: "Business **KES 47,999**: up to 7 pages, full SEO, booking integration, copy everywhere. Live 1 week.", link: ["/packages", "See Business →"], wa: "Hi Orbit! I want bookings on my site (Business 47,999). My business is..." },
			{ label: "💬 Just get found", ask: "I just want to get found online", reply: "Starter **KES 35,999**: up to 3 pages, WhatsApp chat, basic SEO, live in 5 days.", link: ["/packages", "See Starter →"], wa: "Hi Orbit! I want a Starter site (35,999). My business is..." },
		];

		const KB: Array<{ keys: string[]; text: string; link?: [string, string]; wa?: string; t?: string }> = [
			{ keys: ["starter", "35,999", "35999", "landing", "cheap", "basic", "5 pages"], t: "Starter", text: "Starter is **KES 35,999** — 5 pages, WhatsApp+call, basic SEO + GBP, copy for 3 pages, Analytics, live 5 days. + Care 7,499/mo. → WhatsApp direct.", link: ["/packages", "See Starter →"], wa: "Hi Orbit! I want the Starter website (35,999) — my business is..." },
			{ keys: ["business", "47,999", "47999", "booking", "10 pages"], t: "Business", text: "Business is **KES 47,999** — 10 pages+blog, full SEO (schema 90+), bookings/Calendly, copy all pages, <2s, live 1 week. Most popular. + Care 10,999/mo.", link: ["/packages", "See Business →"], wa: "Hi Orbit! I want the Business website (47,999) — bookings for..." },
			{ keys: ["master", "59,999", "59999", "store", "shop", "sell", "15 pages"], t: "Master", text: "Master is **KES 59,999** — 15+ pages or store, native M-Pesa Till+Paybill+cards, inventory sync, automations, training, 2 weeks.", link: ["/packages", "See Master →"], wa: "Hi Orbit! I want the Master package (59,999) for my store." },
			{ keys: ["saas", "app", "platform", "software"], t: "SaaS", text: "Custom SaaS from **KES 59,999** — auth/roles, dashboards, M-Pesa, CSV, 3mo support. You own it.", link: ["/saas", "See SaaS →"] },
			{ keys: ["logo", "brand", "design", "17,999", "17999", "graphic", "flyer"], t: "Design", text: "Design from **KES 17,999** — logos, kits to 29,999, social kits, flyers, files included. You own it.", link: ["/design", "See design →"] },
			{ keys: ["agent", "ai", "bot", "chatbot", "responder"], t: "AI Agent", text: "AI Agent **KES 59,999** (WhatsApp/site/email, qualify+book, handover, 30d tuning). WhatsApp Responder **35,999**.", link: ["/automation", "See agents →"] },
			{ keys: ["workflow", "automate", "automation", "zapier", "sheets", "invoice"], t: "Workflows", text: "Workflows **KES 47,999** each — M-Pesa → Sheets, auto-invoices. Bundle 3 = 15% off.", link: ["/automation", "See workflows →"] },
			{ keys: ["dashboard", "18,999", "32,999", "report", "track"], t: "Dashboards", text: "Dashboards: Add-on **18,999** or Standalone **32,999** — M-Pesa feed, bookings, stock on one screen.", link: ["/dashboards", "See dashboards →"] },
			{ keys: ["care", "maintain", "monthly", "hosting", "support", "update"], t: "Care", text: "Care: Starter **7,499** · Business **10,999** · Master **13,999/mo**. Cancel anytime. SaaS 15,999 · Dash 5,999 · Agent 7,999.", link: ["/care", "See Care →"] },
			{ keys: ["price", "cost", "much", "charge", "quote"], text: "Starter **35,999** · Business **47,999** · Master **59,999**. SaaS **59,999+**. Design **17,999+**. Agent **59,999**.", link: ["/packages", "Full pricelist →"] },
			{ keys: ["long", "timeline", "when", "deliver", "live", "launch", "fast"], text: "Starter **5 days**, Business **1 week**, Master **2 weeks** — once we have your photos, text + logo." },
			{ keys: ["mpesa", "m-pesa", "paybill", "till", "stk", "daraja", "pay"], text: "Till = walk-in, Paybill = tracked/online. We wire both natively.", link: ["/blog/mpesa-till-vs-paybill", "Till vs Paybill →"] },
			{ keys: ["seo", "google", "rank", "found", "search"], text: "Every site ships SEO + Google Business Profile. Master adds buyer-keyword SEO.", link: ["/blog/seo-small-business-kenya", "SEO plan →"] },
			{ keys: ["own", "domain", "files", "terms"], text: "You own everything — domain, files, credentials. Pay only for work done if we part ways." },
			{ keys: ["guide", "learn", "calculator", "tutorial"], text: "7 free guides + M-Pesa calculator — steal them even if you never hire us.", link: ["/guides", "All guides →"] },
			{ keys: ["human", "person", "talk", "contact", "phone", "email", "call"], text: "Talk to a human in minutes, Mon–Sat: +254 741 992 308 on WhatsApp." },
			{ keys: ["hello", "hi", "hey", "habari", "niaje", "sasa"], text: "Habari! 👋 I'm Orbit — ask me about prices, timelines, M-Pesa, care, or anything. Or tap an action below." },
			{ keys: ["discount", "offer", "promo", "deal", "off"], text: "Prices are transparent — no hidden fees." },
		];
		const fallback = "I don't have that one yet — try asking about prices, timelines, M-Pesa, or care.";

		const stop = new Set(["a","an","the","is","are","do","does","i","my","me","for","to","of","in","on","and","or","it","this","that","with","what","how","much","can","you","your","we","our","get","want","need","have","has","about","please","hi"]);
		function score(q: string, keys: string[]): number {
			const words = q.toLowerCase().split(/[^a-z0-9]+/).filter(w => w && !stop.has(w));
			let s = 0;
			for (const k of keys) {
				const kl = k.toLowerCase();
				if (q.toLowerCase().includes(kl)) s += 2;
				else if (words.some(w => w.length > 3 && (kl.includes(w) || w.includes(kl)))) s += 1;
			}
			return s;
		}

		function init() {
		const panel = document.getElementById("oa-panel");
		const toggle = document.getElementById("oa-toggle");
		const log = document.getElementById("oa-log");
		const actionsBox = document.getElementById("oa-actions");
		const input = document.getElementById("oa-input") as HTMLInputElement | null;
		const send = document.getElementById("oa-send");
		if (!panel || !toggle || !log || !input || !send || toggle.dataset.bound) return;
		toggle.dataset.bound = "1";

		const mem = loadMemory();
		mem.visits = (mem.visits || 0) + 1;
		saveMemory(mem);

		async function checkAI() {
			const el = document.getElementById("oa-status");
			if (!el) return;
			const basic = () => {
				el.textContent = "● basic";
				el.className = "text-[10px] font-semibold text-amber-400";
			};
			try {
				const res = await fetch("/api/chat");
				const data = await res.json();
				if (data && data.ai) {
					el.textContent = "● live AI";
					el.className = "text-[10px] font-semibold text-emerald-400";
				} else {
					basic();
				}
			} catch {
				basic();
			}
		}
		checkAI();
		mem.visits = (mem.visits || 0) + 1;
		saveMemory(mem);

		function bubble(text: string, mine: boolean, html = false) {
			const d = document.createElement("div");
			d.className = mine
				? "justify-self-end rounded-2xl rounded-br-sm bg-electric/20 px-4 py-2.5 text-slate-100"
				: "justify-self-start rounded-2xl rounded-bl-sm border border-edge bg-charcoal px-4 py-2.5 text-slate-300";
			d.style.maxWidth = "90%";
			if (html) d.innerHTML = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>"); else d.textContent = text;
			log!.appendChild(d);
			log!.scrollTop = log!.scrollHeight;
		}
		function richLink(href: string, label: string) {
			const a = document.createElement("a");
			a.href = href;
			a.className = "justify-self-start text-xs font-semibold text-electric hover:underline";
			a.textContent = label;
			log!.appendChild(a);
			log!.scrollTop = log!.scrollHeight;
		}
		function waButton(q: string, label = "Chat human on WhatsApp") {
			const a = document.createElement("a");
			const ctx = mem.name ? ` (${mem.name})` : "";
			a.href = waLink(q + ctx);
			a.target = "_blank";
			a.rel = "noopener noreferrer";
			a.className = "justify-self-start rounded-full bg-[#25D366] px-4 py-2 text-xs font-semibold text-white";
			a.textContent = label;
			log!.appendChild(a);
			log!.scrollTop = log!.scrollHeight;
		}
		function renderActions() {
			actionsBox!.innerHTML = "";
			for (const a of ACTIONS) {
				const b = document.createElement("button");
				b.type = "button";
				b.className = "w-full rounded-xl border border-electric/30 bg-electric/5 px-4 py-2.5 text-left text-xs font-semibold text-white transition hover:bg-electric/15";
				b.textContent = a.label;
				b.addEventListener("click", () => {
					bubble(a.ask, true);
					addChat("u", a.ask);
					setTimeout(() => {
						bubble(a.reply, false, true);
						addChat("a", a.reply);
						if (a.link) richLink(a.link[0], a.link[1]);
						waButton(a.wa, "Start this on WhatsApp");
					}, 350);
				});
				actionsBox!.appendChild(b);
			}
			const q = document.createElement("button");
			q.type = "button";
			q.className = "w-full rounded-xl border border-neon/40 bg-neon/10 px-4 py-2.5 text-left text-xs font-semibold text-white transition hover:bg-neon/20";
			q.textContent = "🔍 Find my fit — 2 questions";
			q.addEventListener("click", startQualify);
			actionsBox!.appendChild(q);
		}

		function showChoices(options: string[], cb: (choice: string) => void) {
			actionsBox!.innerHTML = "";
			for (const o of options) {
				const c = document.createElement("button");
				c.type = "button";
				c.className = "w-full rounded-xl border border-electric/30 bg-electric/5 px-4 py-2.5 text-left text-xs font-semibold text-white transition hover:bg-electric/15";
				c.textContent = o;
				c.addEventListener("click", () => {
					bubble(o, true);
					addChat("u", o);
					cb(o);
				});
				actionsBox!.appendChild(c);
			}
		}

		function startQualify() {
			bubble("Two quick questions, then I'll point you at the exact package.", false);
			showChoices(["Online store", "Bookings", "Just get found"], (need) => {
				bubble("Noted — and your budget?", false);
				showChoices(["Under 30k", "30–40k", "40k+", "Not sure"], (budget) => {
					const base = need === "Online store"
						? { pkg: "Master", price: "59,999", link: ["/mpesa-fee-calculator", "M-Pesa calculator →"] as [string, string] }
						: need === "Bookings"
						? { pkg: "Business", price: "47,999", link: ["/packages", "See Business →"] as [string, string] }
						: { pkg: "Starter", price: "35,999", link: ["/packages", "See Starter →"] as [string, string] };
					const fit = budget === "Under 30k" && base.pkg !== "Starter"
						? " That's above 30k — **Starter (35,999)** gets you live now, upgrade later."
						: " That fits your budget.";
					const text = `For ${need.toLowerCase()} → **${base.pkg} (${base.price})**.${fit}`;
					bubble(text, false, true);
					addChat("a", text);
					richLink(base.link[0], base.link[1]);
					const wa = `Hi Orbit! I need ${need.toLowerCase()}, budget ${budget}. You recommended ${base.pkg} (${base.price}). My business is...`;
					waButton(wa, "Send this to WhatsApp");
					mem.qualified = { need, budget, package: `${base.pkg} (${base.price})` };
					mem.lastTopic = base.pkg;
					mem.interests[base.pkg] = (mem.interests[base.pkg] || 0) + 1;
					saveMemory(mem);
					setTimeout(renderActions, 600);
				});
			});
		}

		function typingIndicator(show: boolean) {
			const el = document.getElementById("oa-typing");
			if (el) el.classList.toggle("hidden", !show);
		}
		function addChat(role: "u" | "a", msg: string) {
			mem.chat.push({ r: role, t: msg });
			if (mem.chat.length > 20) mem.chat.shift();
			saveMemory(mem);
		}

		function greet() {
			if (log!.childElementCount > 0) return;
			if (mem.visits > 1) {
				const top = Object.entries(mem.interests || {}).sort((a, b) => b[1] - a[1])[0];
				let back = `Welcome back${mem.name ? ", " + mem.name : ""}! `;
				if (mem.qualified) back += `Still thinking about ${mem.qualified.package}?`;
				else if (top) back += `Last time you were looking at ${top[0]} — still interested?`;
				else back += "Pick up where you left off.";
				bubble(back, false);
			} else {
				bubble(`👋 **Habari!** I'm Orbit — your AI sidekick for websites, M-Pesa, SEO, and growth. Ask me anything or tap an action below.`, false);
			}
			renderActions();
		}

		async function answer(q: string) {
			bubble(q, true);
			addChat("u", q);
			const info = extractUser(q);
			if (info.name) mem.name = info.name;
			if (info.email) mem.email = info.email;
			if (info.phone) mem.phone = info.phone;
			saveMemory(mem);

			let best: (typeof KB)[number] | null = null, bestScore = 0;
			for (const entry of KB) {
				const s = score(q, entry.keys);
				if (s > bestScore) { bestScore = s; best = entry; }
			}
			if (best && bestScore > 0 && best.t) {
				mem.lastTopic = best.t;
				mem.interests[best.t] = (mem.interests[best.t] || 0) + 1;
				saveMemory(mem);
			}
			// Every typed question goes to the real AI. Any failure falls back to the KB.
			typingIndicator(true);
			let rateLimited = false;
			try {
				const history = mem.chat.slice(-10).map((m) => ({
					role: m.r === "a" ? "assistant" : "user",
					content: m.t.slice(0, 600),
				}));
				const res = await fetch("/api/chat", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ messages: history, name: mem.name || undefined }),
				});
				if (!res.ok) {
					if (res.status === 429) rateLimited = true;
					throw new Error("ai-off");
				}
				const data = await res.json();
				const reply = typeof data.reply === "string" && data.reply.trim()
					? data.reply.trim().slice(0, 1200)
					: "";
				if (!reply) throw new Error("ai-empty");
				typingIndicator(false);
				bubble(reply, false);
				addChat("a", reply);
				if (best && bestScore >= 4 && best.link) richLink(best.link[0], best.link[1]);
			} catch {
				typingIndicator(false);
				if (rateLimited) {
					bubble("Easy — I've had a lot of chats this hour. Try again in a bit.", false);
					addChat("a", "Rate limited. Human handoff offered.");
				} else if (best && bestScore > 0) {
					bubble(best.text, false, true);
					addChat("a", best.text);
					if (best.link) richLink(best.link[0], best.link[1]);
				} else {
					bubble(fallback, false);
					addChat("a", fallback);
				}
			}
		}

		toggle.addEventListener("click", () => {
			panel.classList.toggle("hidden");
			if (!panel.classList.contains("hidden")) {
				if (log!.childElementCount === 0) greet();
				input.focus();
			}
		});
		// Always usable: keyboard shortcut + auto-prompt
		document.addEventListener("keydown", (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); panel.classList.remove("hidden"); if (log!.childElementCount === 0) greet(); input.focus(); }
			if (e.key === "/" && !["INPUT","TEXTAREA"].includes((document.activeElement as HTMLElement)?.tagName)) { e.preventDefault(); panel.classList.remove("hidden"); if (log!.childElementCount === 0) greet(); input.focus(); }
			if (e.key === "Escape") panel.classList.add("hidden");
		});
		if (!mem.visits || mem.visits <= 1) {
			setTimeout(() => { if (panel.classList.contains("hidden") && !localStorage.getItem("orbit_ai_prompted")) { panel.classList.remove("hidden"); greet(); localStorage.setItem("orbit_ai_prompted","1"); } }, 10000);
		}
		send.addEventListener("click", () => {
			const q = input.value.trim();
			if (!q) return;
			input.value = "";
			answer(q);
		});
		input.addEventListener("keydown", (e) => {
			if (e.key === "Enter") send.click();
		});
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}
		document.addEventListener("astro:page-load", init);
	})();
</script>