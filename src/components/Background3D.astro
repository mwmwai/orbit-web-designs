---
interface Props {
  className?: string;
  theme?: 'electric' | 'neon' | 'violet' | 'emerald';
  intensity?: 'subtle' | 'medium' | 'strong';
}
const { className = '', theme = 'electric', intensity = 'subtle' } = Astro.props;
---

<div class={`absolute inset-0 pointer-events-none overflow-hidden ${className}`} aria-hidden="true">
  <canvas id="bg-canvas-{Math.random().toString(36).slice(2)}" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
  <div class="absolute inset-0 bg-gradient-to-b from-ink/90 via-ink/70 to-ink/95" aria-hidden="true"></div>
</div>

<script is:inline>
  (() => {
    async function initBackground3D() {
      const canvases = document.querySelectorAll('[id^="bg-canvas-"]');
      await new Promise((r) => requestIdleCallback ? requestIdleCallback(r, { timeout: 2000 }) : setTimeout(r, 800));
      const THREE = await import("three");
      canvases.forEach((canvas) => {
        if (canvas.dataset.bound) return;
        canvas.dataset.bound = "1";
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "high-performance" });
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        renderer.setPixelRatio(dpr);
        renderer.setSize(window.innerWidth, window.innerHeight);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 0, 60);

        const themes = {
          electric: { primary: 0x00c8ff, secondary: 0x2f7bff, particles: [0x00c8ff, 0x2f7bff, 0xffffff] },
          neon: { primary: 0x3a8bff, secondary: 0x00c8ff, particles: [0x3a8bff, 0x00c8ff, 0xffffff] },
          violet: { primary: 0x7c3aed, secondary: 0x00c8ff, particles: [0x7c3aed, 0x00c8ff, 0xffffff] },
          emerald: { primary: 0x10b981, secondary: 0x00c8ff, particles: [0x10b981, 0x00c8ff, 0xffffff] },
        };

        const t = themes[theme] || themes.electric;

        const intensitySettings = {
          subtle: { shapes: 10, particles: 400, opacity: 0.1 },
          medium: { shapes: 18, particles: 700, opacity: 0.15 },
          strong: { shapes: 25, particles: 1000, opacity: 0.2 },
        };
        const s = intensitySettings[intensity];

        const shapes = [];
        const shapeGeometries = [
          new THREE.IcosahedronGeometry(1.5, 0),
          new THREE.OctahedronGeometry(1.8, 0),
          new THREE.TetrahedronGeometry(2, 0),
          new THREE.DodecahedronGeometry(1.3, 0),
          new THREE.BoxGeometry(2, 2, 2),
        ];

        const material = new THREE.MeshPhysicalMaterial({
          color: t.primary,
          metalness: 0.1,
          roughness: 0.3,
          transmission: 0.3,
          thickness: 0.5,
          transparent: true,
          opacity: s.opacity,
          wireframe: false,
        });

        const wireMaterial = new THREE.MeshBasicMaterial({
          color: t.primary,
          transparent: true,
          opacity: s.opacity * 0.5,
          wireframe: true,
        });

        for (let i = 0; i < s.shapes; i++) {
          const geom = shapeGeometries[i % shapeGeometries.length];
          const mesh = new THREE.Mesh(geom, material);
          const wire = new THREE.Mesh(geom, wireMaterial);
          wire.scale.setScalar(1.02);

          const group = new THREE.Group();
          group.add(mesh);
          group.add(wire);

          group.position.set(
            (Math.random() - 0.5) * 100,
            (Math.random() - 0.5) * 60,
            (Math.random() - 0.5) * 80 - 30
          );
          group.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
          group.userData = {
            rotSpeed: { x: (Math.random() - 0.5) * 0.0015, y: (Math.random() - 0.5) * 0.002, z: (Math.random() - 0.5) * 0.0008 },
            floatOffset: Math.random() * Math.PI * 2,
            floatSpeed: 0.0004 + Math.random() * 0.0006,
            initialY: group.position.y,
          };
          scene.add(group);
          shapes.push(group);
        }

        const particleCount = s.particles;
        const particleGeom = new THREE.BufferGeometry();
        const positions = new Float32Array(particleCount * 3);
        const colors = new Float32Array(particleCount * 3);
        const sizes = new Float32Array(particleCount);
        for (let i = 0; i < particleCount; i++) {
          positions[i * 3] = (Math.random() - 0.5) * 250;
          positions[i * 3 + 1] = (Math.random() - 0.5) * 150;
          positions[i * 3 + 2] = (Math.random() - 0.5) * 180 - 40;
          const colorChoice = Math.random();
          if (colorChoice < 0.5) {
            colors[i * 3] = 0; colors[i * 3 + 1] = 0.78; colors[i * 3 + 2] = 1;
          } else if (colorChoice < 0.75) {
            colors[i * 3] = 0.74; colors[i * 3 + 1] = 0.95; colors[i * 3 + 2] = 1;
          } else {
            colors[i * 3] = 1; colors[i * 3 + 1] = 1; colors[i * 3 + 2] = 1;
          }
          sizes[i] = Math.random() * 2 + 0.5;
        }
        particleGeom.setAttribute("position", new THREE.BufferAttribute(positions, 3));
        particleGeom.setAttribute("color", new THREE.BufferAttribute(colors, 3));
        particleGeom.setAttribute("size", new THREE.BufferAttribute(sizes, 1));
        const particleMat = new THREE.PointsMaterial({
          size: 2,
          vertexColors: true,
          transparent: true,
          opacity: s.opacity * 0.8,
          sizeAttenuation: true,
        });
        const particles = new THREE.Points(particleGeom, particleMat);
        scene.add(particles);

        const ambient = new THREE.AmbientLight(0xffffff, 0.3);
        scene.add(ambient);
        const dirLight = new THREE.DirectionalLight(t.primary, 0.25);
        dirLight.position.set(15, 25, 20);
        scene.add(dirLight);
        const dirLight2 = new THREE.DirectionalLight(t.secondary, 0.15);
        dirLight2.position.set(-15, -15, -15);
        scene.add(dirLight2);

        let mouseX = 0, mouseY = 0;
        let targetX = 0, targetY = 0;
        document.addEventListener("mousemove", (e) => {
          mouseX = (e.clientX / window.innerWidth) * 2 - 1;
          mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
        }, { passive: true });

        function animate(time) {
          const t = time * 0.001;
          targetX = mouseX * 0.12;
          targetY = mouseY * 0.12;
          camera.position.x += (targetX - camera.position.x) * 0.015;
          camera.position.y += (targetY - camera.position.y) * 0.015;
          camera.lookAt(0, 0, 0);

          shapes.forEach((g) => {
            g.rotation.x += g.userData.rotSpeed.x;
            g.rotation.y += g.userData.rotSpeed.y;
            g.rotation.z += g.userData.rotSpeed.z;
            g.position.y = g.userData.initialY + Math.sin(time * 0.001 * 1000 * g.userData.floatSpeed + g.userData.floatOffset) * 1.2;
          });

          particles.rotation.y += 0.00002;
          particles.rotation.x += 0.000008;

          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        }

        function onResize() {
          const w = window.innerWidth, h = window.innerHeight;
          renderer.setSize(w, h);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }
        window.addEventListener("resize", onResize, { passive: true });

        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) requestAnimationFrame(animate);
        }, { rootMargin: "200px" });
        observer.observe(canvas);

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) observer.unobserve(canvas);
          else observer.observe(canvas);
        });

        requestAnimationFrame(animate);
      });
    }

      const start = () => {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initBackground3D, { once: true });
        } else {
          initBackground3D();
        }
        document.addEventListener("astro:page-load", initBackground3D);
      };
      start();
    })();
</script>