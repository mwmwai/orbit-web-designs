---
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, SITE_URL, SITE_EMAIL, WHATSAPP_NUMBER, BUSINESS_INFO, SITE_DESCRIPTION, SITE_OG_IMAGE, GA_MEASUREMENT_ID, META_PIXEL_ID } from "../config";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import OrbitBackground from "../components/OrbitBackground.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = SITE_NAME + " — Web Design & Digital Marketing",
	description = SITE_DESCRIPTION,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const gaId = GA_MEASUREMENT_ID && GA_MEASUREMENT_ID !== "G-XXXXXXXXXX" ? GA_MEASUREMENT_ID : "";
const metaPixelId = META_PIXEL_ID || "";

// Comprehensive JSON-LD Schema
const jsonLd = [
	// Organization / LocalBusiness
	{
		"@context": "https://schema.org",
		"@type": ["LocalBusiness", "WebDesignAgency", "ProfessionalService"],
		"name": BUSINESS_INFO.name,
		"url": BUSINESS_INFO.url,
		"logo": BUSINESS_INFO.logo,
		"email": BUSINESS_INFO.email,
		"telephone": BUSINESS_INFO.telephone,
		"description": description,
		"address": BUSINESS_INFO.address,
		"geo": BUSINESS_INFO.geo,
		"openingHoursSpecification": {
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
			"opens": "08:00",
			"closes": "22:00",
		},
		"priceRange": BUSINESS_INFO.priceRange,
		"areaServed": BUSINESS_INFO.areaServed,
		"sameAs": BUSINESS_INFO.sameAs,
		"hasOfferCatalog": {
			"@type": "OfferCatalog",
			"name": "Web Design & Marketing Services",
			"itemListElement": [
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "Custom Website Design",
						"description": "Futuristic, accessible, Core Web Vitals optimized websites from KES 20,000",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "20000",
					"priceCurrency": "KES",
				},
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "Landing Page Development",
						"description": "High-converting, PPC-ready landing pages with A/B testing",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "15000",
					"priceCurrency": "KES",
				},
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "E-Commerce & M-Pesa Integration",
						"description": "Daraja API, Lipa na M-Pesa, PayPal, Stripe - native, zero bloat",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "40000",
					"priceCurrency": "KES",
				},
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "Digital Presence Setup",
						"description": "GBP optimization, citations, schema, social profiles - from KES 12,000",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "12000",
					"priceCurrency": "KES",
				},
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "Website Updates & Maintenance",
						"description": "99.9% uptime, security patches, content edits - from KES 5,000/mo",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "5000",
					"priceCurrency": "KES",
				},
				{
					"@type": "Offer",
					"itemOffered": {
						"@type": "Service",
						"name": "Social Media Marketing",
						"description": "Content, ads, community management - from KES 25,000/mo",
						"provider": { "@type": "LocalBusiness", "name": BUSINESS_INFO.name },
					},
					"price": "25000",
					"priceCurrency": "KES",
				},
			],
		},
	},
	// WebSite with SearchAction
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": BUSINESS_INFO.name,
		"url": BUSINESS_INFO.url,
		"potentialAction": {
			"@type": "SearchAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": `${BUSINESS_INFO.url}/search?q={search_term_string}`,
			},
			"query-input": "required name=search_term_string",
		},
	},
];
---

<!doctype html>
<html lang="en-KE">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/logo-mark.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://wa.me" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="web design Kenya, website design Nairobi, e-commerce developer Kenya, M-Pesa integration, landing page design, PageSpeed optimization, digital marketing agency Nairobi" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og-image.png", SITE_URL).href} />
		<meta property="og:locale" content="en_KE" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/og-image.png", SITE_URL).href} />
		<meta name="robots" content="index, follow" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<ClientRouter />
		{jsonLd.map((schema, i) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} key={i} />
		))}
	</head>
	<body class="bg-ink text-slate-200 antialiased">
		<OrbitBackground />
		<a href="#main" class="sr-only z-[110] rounded-lg border border-electric bg-ink px-4 py-2 text-sm text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
		<div id="scroll-progress" class="fixed left-0 top-0 z-[90] h-[2px] w-0 bg-gradient-to-r from-electric to-neon" aria-hidden="true"></div>
		<div id="cursor-dot" class="pointer-events-none fixed left-0 top-0 z-[95] hidden h-2.5 w-2.5 rounded-full bg-electric shadow-[0_0_14px_4px_rgba(0,200,255,0.45)] lg:block" aria-hidden="true"></div>
		<div id="cursor-ring" class="pointer-events-none fixed left-0 top-0 z-[95] hidden h-9 w-9 rounded-full border border-electric/40 lg:block" aria-hidden="true"></div>
		<div class="aurora" aria-hidden="true"><span></span><span></span></div>
		<ScrollIndicator />
		<slot />
		<script>
			function initTilt() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				document.querySelectorAll("[data-tilt]").forEach((el) => {
					if (el.dataset.tiltBound) return;
					el.dataset.tiltBound = "1";
					el.classList.add("tilt");
					el.addEventListener("mousemove", (e) => {
						const r = el.getBoundingClientRect();
						const px = (e.clientX - r.left) / r.width - 0.5;
						const py = (e.clientY - r.top) / r.height - 0.5;
						el.style.setProperty("--ry", (px * 10).toFixed(2) + "deg");
						el.style.setProperty("--rx", (-py * 8).toFixed(2) + "deg");
						el.classList.add("is-tilting");
					});
					el.addEventListener("mouseleave", () => {
						el.style.setProperty("--ry", "0deg");
						el.style.setProperty("--rx", "0deg");
						el.classList.remove("is-tilting");
					});
				});
			}
			function initReveal() {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
				);
				document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
			}
			function initCounters() {
				document.querySelectorAll("[data-counter]").forEach((el) => {
					if (el.dataset.counted) return;
					el.dataset.counted = "1";
					const original = el.textContent.trim();
					const m = original.match(/^([^\d]*)(\d+)(.*)$/);
					if (!m) return;
					const [, prefix, numStr, suffix] = m;
					const target = parseInt(numStr, 10);
					if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
					const io = new IntersectionObserver((entries) => {
						if (!entries[0].isIntersecting) return;
						io.disconnect();
						const t0 = performance.now();
						const dur = 1200;
						function tick(t: number) {
							const p = Math.min((t - t0) / dur, 1);
							const eased = 1 - Math.pow(1 - p, 3);
							el.textContent = prefix + Math.round(target * eased) + suffix;
							if (p < 1) requestAnimationFrame(tick);
						}
						requestAnimationFrame(tick);
					}, { threshold: 0.4 });
					io.observe(el);
				});
			}
			function initCursor() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
				const dot = document.getElementById("cursor-dot");
				const ring = document.getElementById("cursor-ring");
				if (!dot || !ring || dot.dataset.bound) { if (dot) dot.dataset.bound = "1"; return; }
				dot.dataset.bound = "1";
				let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
				addEventListener("mousemove", (e) => {
					mx = e.clientX; my = e.clientY;
					dot.style.transform = `translate(${mx - 5}px, ${my - 5}px)`;
					dot.style.opacity = "1";
					ring.style.opacity = "1";
				});
				(function loop() {
					rx += (mx - rx) * 0.14;
					ry += (my - ry) * 0.14;
					ring.style.transform = `translate(${rx - 18}px, ${ry - 18}px)`;
					requestAnimationFrame(loop);
				})();
				document.querySelectorAll("a, button, [data-tilt]").forEach((el) => {
					el.addEventListener("mouseenter", () => { ring.style.borderColor = "rgba(0,200,255,0.9)"; ring.style.transform += " scale(1.4)"; });
					el.addEventListener("mouseleave", () => { ring.style.borderColor = "rgba(0,200,255,0.4)"; });
				});
			}
			function initParallax() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				const orbit = document.querySelector(".hero-orbit");
				if (!orbit || orbit.dataset.parallaxBound) return;
				orbit.dataset.parallaxBound = "1";
				let ticking = false;
				window.addEventListener("scroll", () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						orbit.style.marginTop = (window.scrollY * 0.1) + "px";
						ticking = false;
					});
				}, { passive: true });
			}
			function initMagnetic() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				document.querySelectorAll(".magnetic").forEach((el) => {
					if (el.dataset.magneticBound) return;
					el.dataset.magneticBound = "1";
					el.addEventListener("mousemove", (e) => {
						const r = el.getBoundingClientRect();
						const x = (e.clientX - r.left - r.width / 2) * 0.3;
						const y = (e.clientY - r.top - r.height / 2) * 0.3;
						el.style.transform = `translate(${x}px, ${y}px)`;
					});
					el.addEventListener("mouseleave", () => {
						el.style.transform = "";
					});
				});
			}
			function initStagger() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
				);
				document.querySelectorAll(".stagger").forEach((el) => io.observe(el));
			}
			function initPageReveal() {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				requestAnimationFrame(() => {
					document.querySelectorAll(".page-reveal").forEach((el, i) => {
						setTimeout(() => el.classList.add("is-visible"), i * 60);
					});
				});
			}
document.addEventListener("astro:page-load", () => {
			initReveal();
			initTilt();
			initCounters();
			initCursor();
			initParallax();
			initMagnetic();
			initStagger();
			initPageReveal();
			// Analytics init
			if (typeof window !== "undefined") {
				if (gaId && !window.gtag) {
					window.dataLayer = window.dataLayer || [];
					window.gtag = function gtag() { window.dataLayer.push(arguments); };
					window.gtag("js", new Date());
					window.gtag("config", gaId, { page_path: window.location.pathname });
				}
				if (metaPixelId && !window.fbq) {
					!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
						n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
						n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
						t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
						document,'script','https://connect.facebook.net/en_US/fbevents.js');
					window.fbq("init", metaPixelId);
					window.fbq("track", "PageView");
				}
			}
		});
		</script>
	</body>
</html>

