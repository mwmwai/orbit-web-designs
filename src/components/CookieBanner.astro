---
---

<div id="cookie-banner" class="fixed bottom-0 inset-x-0 z-[100] hidden border-t border-white/10 bg-ink/95 backdrop-blur-md">
	<div class="mx-auto max-w-7xl px-5 py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
		<p class="text-sm text-slate-400">We use cookies for analytics to improve your experience. See our <a href="/cookie-policy" class="text-electric hover:underline">cookie policy</a> and <a href="/privacy-policy" class="text-electric hover:underline">privacy</a>.</p>
		<div class="flex gap-3 shrink-0">
			<button id="cookie-accept" class="rounded-full btn-gradient px-6 py-2 text-sm font-semibold text-white">Accept</button>
			<button id="cookie-decline" class="rounded-full border border-edge bg-panel px-6 py-2 text-sm font-semibold text-slate-200">Decline</button>
		</div>
	</div>
</div>
<script>
	(() => {
		const k = "orbit_cookie_consent";
		const banner = document.getElementById("cookie-banner");
		if (!banner) return;
		const consent = localStorage.getItem(k);
		if (!consent) banner.classList.remove("hidden");
		if (consent === "accepted") (window as any).orbitAnalyticsOK = true;
		document.getElementById("cookie-accept")?.addEventListener("click", () => {
			localStorage.setItem(k, "accepted");
			document.cookie = "orbit_cookie_consent=accepted; path=/; max-age=31536000; SameSite=Lax";
			(window as any).orbitAnalyticsOK = true;
			banner.classList.add("hidden");
			// Load GA if not already loaded
			if (import.meta.env.PUBLIC_GA_ID && !(window as any).gtag) {
				const script = document.createElement("script");
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`;
				document.head.appendChild(script);
				window.dataLayer = window.dataLayer || [];
				function gtag() { dataLayer.push(arguments); }
				(window as any).gtag = gtag;
				gtag('js', new Date());
				gtag('config', import.meta.env.PUBLIC_GA_ID, { anonymize_ip: true });
			}
			banner.classList.add("hidden");
		});
		document.getElementById("cookie-decline")?.addEventListener("click", () => {
			localStorage.setItem(k, "declined");
			document.cookie = "orbit_cookie_consent=declined; path=/; max-age=31536000; SameSite=Lax";
			banner.classList.add("hidden");
		});
	})();
</script>
