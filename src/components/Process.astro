---
const steps = [
	{
		num: "01",
		title: "Ignite",
		text: "We map your goals, audience and the orbit you want to own.",
	},
	{
		num: "02",
		title: "Blueprint",
		text: "Wireframes and mockups you approve before a single line of code.",
	},
	{
		num: "03",
		title: "Build",
		text: "Hand-crafted build with SEO, schema and performance baked in.",
	},
	{
		num: "04",
		title: "Lift-off",
		text: "Go live, get trained, and climb — analytics and SEO from day one.",
	},
];
---

<section id="process" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ How we'll work</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				From ignition to orbit in four moves.
			</h2>
		</div>

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((s, i) => (
					<div class="reveal relative border border-edge/70 bg-charcoal/50 p-8 card-shine edge-glow hover-lift magnetic" style={`transition-delay:${i * 70}ms`}>
						<span class="font-display text-5xl font-medium text-electric/20">{s.num}</span>
						<h3 class="mt-4 text-lg font-semibold text-white">{s.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{s.text}</p>
						{i < steps.length - 1 && (
							<svg class="process-line absolute -right-3 top-1/2 hidden h-6 w-6 -translate-y-1/2 lg:block" viewBox="0 0 24 24" fill="none" stroke="rgb(0 200 255 / 0.5)" stroke-width="2" stroke-linecap="round" aria-hidden>
								<path d="M4 12h16m-6-6l6 6-6 6" />
							</svg>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>


