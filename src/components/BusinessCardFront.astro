---
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<style>
	.card-front {
		width: 3.5in;
		height: 2in;
		position: relative;
		overflow: hidden;
		background: #0A0F1D;
		color: #E7E9F2;
		border-radius: 0.125in;
		box-shadow:
			0 0 0 1px rgba(0, 200, 255, 0.08) inset,
			0 20px 50px rgba(0, 0, 0, 0.5),
			0 0 60px -10px rgba(0, 200, 255, 0.1);
	}

	.card-front::before {
		content: "";
		position: absolute;
		inset: 0;
		opacity: 0.04;
		background-image:
			linear-gradient(to right, #23233a 1px, transparent 1px),
			linear-gradient(to bottom, #23233a 1px, transparent 1px);
		background-size: 0.28in 0.28in;
		pointer-events: none;
	}

	.card-front::after {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 30%, transparent 40%, rgba(10, 15, 29, 0.9) 100%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		text-align: center;
		padding: 0.25in;
	}

	.logo-wrapper {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.brand-name {
		margin-top: 0.12in;
		font-size: 22pt;
		font-weight: 900;
		letter-spacing: 0.32em;
		line-height: 1;
		background: linear-gradient(90deg, #F1F5F9, #CBD5E1 55%, #94A3B8);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-indent: 0.32em;
	}

	.divider {
		width: 1.15in;
		height: 2px;
		margin: 0.1in auto 0.09in;
		border-radius: 2px;
		background: linear-gradient(90deg, #00C8FF, #2F7BFF);
	}

	.tagline {
		font-size: 7pt;
		font-weight: 600;
		letter-spacing: 0.30em;
		text-transform: uppercase;
		color: #94A3B8;
		text-indent: 0.30em;
	}
</style>

<div class={`card-front ${className}`} role="img" aria-label="Orbit Web Designs business card front">
	<div class="content">
		<div class="logo-wrapper">
			<img src="/logo-lockup-cropped.png" width="320" alt="Orbit — Web Designs and Marketing" style="mix-blend-mode:screen;max-width:80%;height:auto" />
		</div>
	</div>
</div>