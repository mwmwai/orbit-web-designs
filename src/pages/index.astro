---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Portfolio from "../components/Portfolio.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
---

<Layout>
	<Navbar client:load />
	<main id="main">
		<Hero />
		<Services />
		<Portfolio />
		<Pricing only={["Starter", "Business", "Master"]} />
		<Process />
		<Testimonials />
		<FAQ />
		<CtaBand title="Your competitors are online. Are you?" text="One message. One website. More customers. 10% off new orders ends 30 September." />
	</main>
	<FloatingActions />
	<Footer />
</Layout>

