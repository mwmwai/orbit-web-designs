---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{ "@type": "Question", name: "How long does it take?", acceptedAnswer: { "@type": "Answer", text: "Starter sites go live in 5 days once we have your photos, text and logo. Business takes 1 week, Master 2 weeks. You approve the design before anything goes live." } },
		{ "@type": "Question", name: "Do I need to pay monthly?", acceptedAnswer: { "@type": "Answer", text: "Orbit Care keeps your site fast, safe and online: hosting, security, updates and priority support at KES 6,999/month (Starter), 9,999 (Business) or 12,999 (Master). No surprise bills, cancel anytime." } },
		{ "@type": "Question", name: "What do you need from me?", acceptedAnswer: { "@type": "Answer", text: "Only 3 things: photos of your business, text about what you do, and your logo. No logo? We design one for you from KES 16,999." } },
		{ "@type": "Question", name: "How much does a website cost?", acceptedAnswer: { "@type": "Answer", text: "Starter KES 33,999 (5 pages), Business KES 45,999 (10 pages) and Master KES 57,999 (online store or booking system)." } },
		{ "@type": "Question", name: "Will customers find me on Google?", acceptedAnswer: { "@type": "Answer", text: "Every site ships with SEO setup — titles, descriptions and Google Business Profile. Master adds advanced SEO that targets the searches bringing paying customers." } },
		{ "@type": "Question", name: "What if I don't like the design?", acceptedAnswer: { "@type": "Answer", text: "You approve the design before anything goes live — we revise until you're happy. If we part ways early, you only pay for work already done." } },
		{ "@type": "Question", name: "Can I pay in parts?", acceptedAnswer: { "@type": "Answer", text: "Yes. 50% to start, 50% on launch. After that, a small monthly covers hosting, security and support — no big surprise bills." } },
		{ "@type": "Question", name: "Who owns my website?", acceptedAnswer: { "@type": "Answer", text: "You do — your content, your domain, your business. You get a full license to use everything we build." } },
	],
};
---

<Layout
	title="FAQ — Frequently Asked Questions | Orbit Web Designs & Marketing"
	description="Answers about Orbit pricing (Starter 33,999, Business 45,999, Master 57,999), 3–5 day delivery, monthly care, M-Pesa and Google ranking."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ FAQ</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Questions? <span class="text-gradient">Answered.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					Everything about pricing, timelines, payments and support — straight answers, no fine print.
				</p>
			</div>
		</section>

		<FAQ />

		<CtaBand title="Still unsure? Ask on WhatsApp." text="Honest advice, no pitch — reply in minutes, Mon–Sat." />
	</main>
	<Footer />
</Layout>
