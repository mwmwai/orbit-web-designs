---
---

<div id="loading-screen" class="fixed inset-0 z-[200] items-center justify-center bg-ink overflow-hidden" style="display:none">
  <!-- Ambient glow layers -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute -top-1/2 left-1/2 w-[600px] h-[600px] -translate-x-1/2 rounded-full bg-electric/10 blur-[200px]" style="animation: ambientFloat 8s ease-in-out infinite;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] rounded-full bg-neon/10 blur-[150px]" style="animation: ambientFloat 10s ease-in-out infinite reverse;"></div>
  </div>

  <div class="relative flex flex-col items-center justify-center gap-10 z-10">
    <!-- Cinematic logo reveal -->
    <div class="relative w-36 h-36">
      <svg class="w-full h-full" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="electricGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00c8ff" />
            <stop offset="50%" stop-color="#00c8ff" />
            <stop offset="100%" stop-color="#2f7bff" />
          </linearGradient>
          <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00c8ff" />
            <stop offset="100%" stop-color="#5fe6ff" />
          </linearGradient>
          <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
          <filter id="glowStrong" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="6" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <!-- Outer atmospheric ring -->
        <circle class="atmosphere-ring" cx="36" cy="36" r="32" stroke="url(#electricGradient)" stroke-width="1" fill="none" stroke-opacity="0.15" style="animation: atmospherePulse 4s ease-in-out infinite; transform-origin: 36px 36px;" />

        <!-- Main orbit ring with gradient -->
        <circle class="orbit-ring" cx="36" cy="36" r="28" stroke="url(#electricGradient)" stroke-width="3" fill="none" stroke-dasharray="175.9" stroke-dashoffset="175.9" stroke-linecap="round" filter="url(#glow)" style="animation: orbitDraw 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards, orbitRotate 8s linear infinite 1.4s; transform-origin: 36px 36px;" />

        <!-- Secondary orbit ring (counter-rotate) -->
        <circle class="orbit-ring-secondary" cx="36" cy="36" r="22" stroke="#00c8ff" stroke-width="1.5" fill="none" stroke-dasharray="8 12" stroke-opacity="0.4" style="animation: orbitRotateReverse 12s linear infinite; transform-origin: 36px 36px;" />

        <!-- Particle trail -->
        <g class="particle-trail" style="animation: particleOrbit 6s linear infinite; transform-origin: 36px 36px;">
          <circle cx="36" cy="4" r="2.5" fill="#00c8ff" opacity="0.8" filter="url(#glowStrong)" />
          <circle cx="68" cy="36" r="1.8" fill="#5fe6ff" opacity="0.6" filter="url(#glow)" />
          <circle cx="36" cy="68" r="2" fill="#00c8ff" opacity="0.7" filter="url(#glow)" />
          <circle cx="4" cy="36" r="1.5" fill="#2f7bff" opacity="0.5" filter="url(#glow)" />
        </g>

        <!-- Core logo mark with ring -->
        <circle class="logo-ring" cx="36" cy="36" r="18" stroke="url(#logoGradient)" stroke-width="2" fill="none" stroke-dasharray="113.1" stroke-dashoffset="113.1" stroke-linecap="round" filter="url(#glow)" style="animation: logoRingDraw 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards; transform-origin: 36px 36px; opacity: 0;" />
        
        <!-- Logo center -->
        <circle class="logo-core" cx="36" cy="36" r="12" fill="url(#logoGradient)" filter="url(#glowStrong)" style="animation: logoCoreReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards; transform-origin: 36px 36px; opacity: 0;" />

        <!-- Orbit text with tracking -->
        <text x="36" y="56" class="orbit-text" text-anchor="middle" font-family="system-ui, sans-serif" font-size="4" font-weight="800" letter-spacing="0.3em" fill="#00c8ff" style="animation: textFade 0.4s ease-out 1.4s forwards; opacity: 0;">ORBIT</text>

        <!-- Subtle tagline -->
        <text x="36" y="62" class="orbit-tagline" text-anchor="middle" font-family="system-ui, sans-serif" font-size="1.5" font-weight="400" fill="#5fe6ff" style="animation: textFade 0.3s ease-out 1.7s forwards; opacity: 0;">WEB DESIGNS & MARKETING</text>
      </svg>
    </div>

    <!-- Progress indicator -->
    <div class="loading-progress-container">
      <div class="loading-progress">
        <div class="progress-bar" style="animation: progressFill 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;"></div>
        <div class="progress-glow" style="animation: progressGlow 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;"></div>
      </div>
      <p class="loading-text font-mono text-xs uppercase tracking-widest text-slate-500">Initializing orbit...</p>
    </div>
  </div>

  <style>
    @keyframes atmospherePulse {
      0%, 100% { transform: scale(1); opacity: 0.15; }
      50% { transform: scale(1.08); opacity: 0.25; }
    }
    @keyframes orbitDraw {
      to { stroke-dashoffset: 0; }
    }
    @keyframes orbitRotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes orbitRotateReverse {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }
    @keyframes pulseRing {
      0%, 100% { transform: scale(0.9); opacity: 0.2; }
      50% { transform: scale(1.15); opacity: 0.05; }
    }
    @keyframes particleOrbit {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }
    @keyframes logoScale {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1.3); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes logoRingDraw {
      to { stroke-dashoffset: 0; opacity: 1; }
    }
    @keyframes logoCoreReveal {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes textFade {
      to { opacity: 1; }
    }
    @keyframes progressFill {
      from { width: 0%; }
      to { width: 100%; }
    }
    @keyframes progressGlow {
      from { width: 0%; opacity: 0; }
      50% { opacity: 1; }
      to { width: 100%; opacity: 1; }
    }
    @keyframes ambientFloat {
      0%, 100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
      25% { transform: translate(-45%, -55%) scale(1.05) rotate(90deg); }
      50% { transform: translate(-50%, -50%) scale(1) rotate(180deg); }
      75% { transform: translate(-55%, -45%) scale(1.05) rotate(270deg); }
    }
    @keyframes logoRingPulse {
      0%, 100% { filter: url(#glow); }
      50% { filter: url(#glowStrong); }
    }
    @keyframes logoCorePulse {
      0%, 100% { transform: scale(1); filter: url(#glowStrong); }
      50% { transform: scale(1.05); filter: url(#glow); }
    }

    .loading-progress-container {
      width: 200px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }
    .loading-progress {
      width: 100%;
      height: 4px;
      background: rgba(255,255,255,0.06);
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }
    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #00c8ff, #2f7bff, #5fe6ff);
      background-size: 200% 100%;
      border-radius: 9999px;
      box-shadow: 0 0 30px rgba(0, 200, 255, 0.6);
      animation: progressFill 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards, barShimmer 2s linear infinite 1.8s;
    }
    @keyframes barShimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    .progress-glow {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(90deg, transparent, rgba(0,200,255,0.4), transparent);
      border-radius: 9999px;
      opacity: 0;
    }
    .loading-text {
      animation: textFade 0.3s ease-out 2s forwards;
      opacity: 0;
    }
    .loading-subtext {
      animation: textFade 0.3s ease-out 2.2s forwards;
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .atmosphere-ring, .orbit-ring, .orbit-ring-secondary, .pulse-ring, 
      .particle-trail, .logo-ring, .logo-core, .orbit-text, .orbit-tagline,
      .progress-bar, .progress-glow, .loading-text, .loading-subtext {
        animation: none !important;
        stroke-dashoffset: 0;
        opacity: 1;
        transform: none;
        width: 100%;
      }
      .progress-bar { width: 100%; }
    }

    /* Post-load idle animations */
    .logo-ring.loaded { animation: logoRingPulse 3s ease-in-out infinite; }
    .logo-core.loaded { animation: logoCorePulse 3s ease-in-out infinite; }
    .orbit-ring.loaded { animation: orbitRotate 8s linear infinite; }
  </style>
</div>
<script>
  (() => {
    const loadingScreen = document.getElementById('loading-screen');
    if (!loadingScreen) return;

    // Only ever show on the very first load of this tab. Default is hidden,
    // so view transitions (home -> services etc.) never flash the loader.
    if (sessionStorage.getItem('orbit-loading-seen') === 'true') {
      loadingScreen.remove();
      return;
    }
    // First visit: claim the flag immediately so quick navigations can't retrigger,
    // then reveal the loader and run the cinematic.
    sessionStorage.setItem('orbit-loading-seen', 'true');
    loadingScreen.style.display = 'flex';

    const elements = {
      atmosphereRing: loadingScreen.querySelector('.atmosphere-ring'),
      orbitRing: loadingScreen.querySelector('.orbit-ring'),
      orbitRingSecondary: loadingScreen.querySelector('.orbit-ring-secondary'),
      pulseRing: loadingScreen.querySelector('.pulse-ring'),
      particleTrail: loadingScreen.querySelector('.particle-trail'),
      logoRing: loadingScreen.querySelector('.logo-ring'),
      logoCore: loadingScreen.querySelector('.logo-core'),
      orbitText: loadingScreen.querySelector('.orbit-text'),
      orbitTagline: loadingScreen.querySelector('.orbit-tagline'),
      progressBar: loadingScreen.querySelector('.progress-bar'),
      progressGlow: loadingScreen.querySelector('.progress-glow'),
      loadingText: loadingScreen.querySelector('.loading-text'),
      loadingSubtext: loadingScreen.querySelector('.loading-subtext'),
    };

    let hideScheduled = false;

    const hideLoading = () => {
      if (hideScheduled) return;
      hideScheduled = true;
      
      // Add loaded classes for idle animations
      elements.orbitRing?.classList.add('loaded');
      elements.logoRing?.classList.add('loaded');
      elements.logoCore?.classList.add('loaded');

      loadingScreen.style.opacity = '0';
      loadingScreen.style.transition = 'opacity 0.5s ease-out';
      setTimeout(() => loadingScreen.remove(), 500);
    };

    const minDisplayTime = 1200;
    const maxDisplayTime = 4000;
    const startTime = Date.now();

    const checkReady = () => {
      const elapsed = Date.now() - startTime;
      
      if (document.readyState === 'complete') {
        const remaining = minDisplayTime - elapsed;
        if (remaining > 0) {
          setTimeout(hideLoading, remaining);
        } else {
          hideLoading();
        }
      } else {
        window.addEventListener('load', () => {
          const elapsed = Date.now() - startTime;
          const remaining = minDisplayTime - elapsed;
          
          // Also respect max display time
          const maxWait = maxDisplayTime - elapsed;
          const waitTime = Math.max(0, Math.min(remaining, maxWait));
          
          setTimeout(hideLoading, waitTime);
        }, { once: true });
      }
    };

    checkReady();
  })();
</script>