---
import { SITE_NAME, SITE_EMAIL, SITE_PHONE_DISPLAY, NAV_LINKS } from "../config";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-16">
	<div class="mx-auto max-w-7xl px-5">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<a href="/" class="inline-flex items-center gap-4">
					<img src="/logo-mark.png" alt="Orbit logo" width={44} height={44} />
					<span class="leading-none">
						<span class="block bg-gradient-to-r from-slate-100 via-slate-300 to-slate-400 bg-clip-text text-xl font-black tracking-[0.3em] text-transparent">ORBIT</span>
						<span class="mt-1.5 block text-[10px] font-semibold uppercase tracking-[0.26em] text-slate-500">Web Designs &amp; Marketing</span>
					</span>
				</a>
				<p class="mt-6 max-w-sm text-sm leading-relaxed text-slate-500">
					{SITE_NAME} builds fast, secure websites and marketing that help
					businesses get found, get trusted, and get paid.
				</p>
				<a href="/contact" class="link-underline mt-6">
					Get a website quote <span aria-hidden>→</span>
				</a>
			</div>

			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Company</h3>
				<ul class="mt-5 grid gap-3 text-sm">
					{NAV_LINKS.map((l) => (
						<li><a href={l.href} class="text-slate-400 transition hover:text-white">{l.label}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Contact</h3>
				<ul class="mt-5 grid gap-3 text-sm text-slate-400">
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Phone / WhatsApp</span>
						<a href="tel:+254741992308" class="transition hover:text-white">{SITE_PHONE_DISPLAY}</a>
					</li>
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Email</span>
						<a href={`mailto:${SITE_EMAIL}`} class="transition hover:text-white">{SITE_EMAIL}</a>
					</li>
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Working hours</span>
						Mon – Sat · Flexible worldwide
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-white/5 pt-6 text-xs text-slate-500 md:flex-row md:items-center">
			<p>© {year} {SITE_NAME}. All rights reserved.</p>
			<p class="font-mono tracking-widest">Built fast. Shipped calm.</p>
		</div>
	</div>
</footer>
