---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<section id="top" class="relative overflow-hidden bg-ink py-20 lg:py-28">
	<div class="relative mx-auto max-w-7xl px-4 md:px-5">
		<div class="inline-flex items-center gap-2 rounded-full border border-edge bg-panel px-4 py-1.5 text-xs font-medium text-slate-300 mb-6">
			<span class="h-2 w-2 rounded-full bg-electric"></span>
			Web Design & M-Pesa Integration in Kenya
		</div>

		<h1 class="max-w-4xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl">
			Websites that actually bring you <span class="text-gradient">customers in Kenya.</span>
		</h1>

		<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
			No fluff, no complicated templates. We build fast, professional business websites with direct M-Pesa checkout — live in days, not months.
		</p>

		<div class="mt-10 flex flex-col sm:flex-row gap-4">
			<a
				href={whatsappLink("Hi Orbit! I want a website for my business. Let's talk.")}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-xl btn-gradient px-8 py-4 font-semibold text-white shadow-xl shadow-electric/20 hover:opacity-95 text-center transition"
			>
				Chat with us on WhatsApp
			</a>
			<a
				href="/packages"
				class="rounded-xl border border-edge bg-panel px-8 py-4 font-semibold text-slate-200 transition hover:border-electric/50 text-center"
			>
				See packages & prices
			</a>
		</div>

		<div class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4 border-t border-edge pt-12">
			<div>
				<p class="text-3xl font-extrabold text-white">50+</p>
				<p class="mt-1 text-sm text-slate-400">Websites launched</p>
			</div>
			<div>
				<p class="text-3xl font-extrabold text-white">M-Pesa</p>
				<p class="mt-1 text-sm text-slate-400">Direct till/paybill setup</p>
			</div>
			<div>
				<p class="text-3xl font-extrabold text-white">5-7 Days</p>
				<p class="mt-1 text-sm text-slate-400">Average turnaround</p>
			</div>
			<div>
				<p class="text-3xl font-extrabold text-white">100%</p>
				<p class="mt-1 text-sm text-slate-400">You own everything</p>
			</div>
		</div>
	</div>
</section>
