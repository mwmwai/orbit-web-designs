---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Portfolio from "../components/Portfolio.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import { SITE_URL, SITE_NAME } from "../config";

const homepageSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"item": {
				"@type": "Service",
				"name": "Custom Website Design",
				"url": `${SITE_URL}/services`,
				"description": "Futuristic, accessible websites engineered for PageSpeed 95+ and Core Web Vitals",
			},
		},
		{
			"@type": "ListItem",
			"position": 2,
			"item": {
				"@type": "Service",
				"name": "E-Commerce & M-Pesa Integration",
				"url": `${SITE_URL}/packages`,
				"description": "Online stores with native M-Pesa STK Push, PayPal & card checkout",
			},
		},
		{
			"@type": "ListItem",
			"position": 3,
			"item": {
				"@type": "Service",
				"name": "SEO & Growth Marketing",
				"url": `${SITE_URL}/services`,
				"description": "Technical, on-page & local SEO that ranks you for searches that pay",
			},
		},
		{
			"@type": "ListItem",
			"position": 4,
			"item": {
				"@type": "Service",
				"name": "Landing Page Development",
				"url": `${SITE_URL}/services`,
				"description": "High-converting, PPC-ready pages with A/B testing and M-Pesa pay buttons",
			},
		},
		{
			"@type": "ListItem",
			"position": 5,
			"item": {
				"@type": "Service",
				"name": "Digital Presence Setup",
				"url": `${SITE_URL}/contact`,
				"description": "GBP optimization, 40+ citation building, LocalBusiness schema, review automation",
			},
		},
		{
			"@type": "ListItem",
			"position": 6,
			"item": {
				"@type": "Service",
				"name": "Website Updates & Maintenance",
				"url": `${SITE_URL}/contact`,
				"description": "99.9% uptime, daily backups, security hardening, Core Web Vitals monitoring",
			},
		},
	],
};
---

<Layout>
	<script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
	<Navbar client:load />
	<main id="main">
		<Hero />
		<Services />
		<Portfolio />
		<Pricing />
		<Process />
		<Testimonials />
		<FAQ />
		<CtaBand title="Ready to build something your customers actually love?" text="Tell us about your project — we reply with honest advice, a timeline and a clear quote." />
	</main>
	<FloatingActions />
	<Footer />
</Layout>

