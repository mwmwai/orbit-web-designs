# Public template — copy to .env for local dev. NO real values here, ever.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Already used by the site (Supabase):
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Money dashboard — server only, NEVER prefix with PUBLIC_, never ship to browser:
SUPABASE_SERVICE_ROLE_KEY=

# Daraja (reserved for future token use; C2B callbacks work without code):
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Shortcode -> shop and forwarding-phone -> shop (JSON, exact shop names):
#   {"600111":"Aggmart","600222":"Trade Star Shop"}
TILL_SHOP_MAP=
#   {"0741992308":"Aggmart","0741000000":"Trade Star Shop"}
POCHI_SHOP_MAP=

# Shared secret the SMS forwarder must send as { "secret": ... }:
INGEST_SECRET=
