---
const services = [
	{
		icon: "M8 6l-4 6 4 6M16 6l4 6-4 6M13 4l-2 16",
		title: "Web Design & Development",
		description:
			"Landing pages, business sites, and fully custom web apps built for speed and conversion.",
		tags: ["Landing pages", "Business sites", "Custom web apps"],
	},
	{
		icon: "M3 11l18-7-7 18-2.5-7.5zM14 12l7-8",
		title: "Digital Marketing",
		description:
			"Targeted online marketing strategies to grow your customer base and boost visibility.",
		tags: ["Social ads", "SEO", "Email campaigns"],
	},
	{
		icon: "M3 6h18l-1.5 9h-15zM6 6V4h12v2M9 20a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z",
		title: "E-commerce & Custom Features",
		description:
			"Online stores, payment integrations, and tailored digital solutions for how you sell.",
		tags: ["Online stores", "Payments", "Integrations"],
	},
];
---

<section id="services" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="reveal mb-14 max-w-xl">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">What We Do</h2>
			<p class="mt-4 text-slate-400">
				End-to-end digital services designed to grow your business.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			{
				services.map((s, i) => (
				<article
					class="reveal glow-border group relative overflow-hidden rounded-2xl p-8 transition duration-300 hover:shadow-2xl hover:shadow-electric/10"
					style={`transition-delay:${i * 80}ms`}
					data-tilt
				>
						<div class="mb-6 inline-flex rounded-xl bg-gradient-to-br from-electric/20 to-neon/20 p-3.5 ring-1 ring-electric/30">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<path d={s.icon} stroke="#8fb8ff" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-white">{s.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{s.description}</p>
						<ul class="mt-6 flex flex-wrap gap-2">
							{s.tags.map((t) => (
								<li class="rounded-full border border-edge bg-charcoal px-3 py-1 text-xs text-slate-300">{t}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>


