---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<Layout title="Case — M-Pesa Store 100s Payments/Month | Orbit" description="E-commerce store: native Till/Paybill, stock auto, WhatsApp pings. 100s M-Pesa payments/month, zero gateway calls.">
	<Navbar />
	<main id="main">
		<section class="border-b border-white/5 py-16 pt-24">
			<div class="mx-auto max-w-3xl px-5">
				<p class="font-mono text-xs uppercase tracking-widest text-electric">■ Case · E-commerce · M-Pesa</p>
				<h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">100s of M-Pesa payments/month. Zero gateway calls.</h1>
				<p class="mt-4 text-slate-400">Native Daraja checkout (Paybill + Till), inventory auto-subtract, low-stock alerts, WhatsApp order push. Master 57,999 live in 8 days.</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-3 text-sm">
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Stack</p><p class="text-slate-400">Master, Paybill API, STK</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Ops</p><p class="text-slate-400">Stock -1, WhatsApp ping</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Care</p><p class="text-slate-400">Master Care 12,999/mo</p></div>
				</div>
				<p class="mt-6 text-sm"><a href="/mpesa-fee-calculator" class="text-electric hover:underline">Price your margins →</a></p>
			</div>
		</section>
		<CtaBand />
	</main>
	<Footer />
</Layout>
