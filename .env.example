# Orbit Web Designs & Marketing - Environment Variables
# Copy to .env and fill in your values

# Site
SITE_URL=https://orbitwebdesigns.co.ke

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel ID (for Facebook/Instagram ads tracking)
PUBLIC_META_PIXEL_ID=

# Optional: WhatsApp Business API (if you upgrade from click-to-chat)
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=