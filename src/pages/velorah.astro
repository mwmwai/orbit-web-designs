---
import VelorahHero from "../components/react/VelorahHero";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Velorah® — Where dreams rise through the silence.</title>
    <meta
      name="description"
      content="We're designing tools for deep thinkers, bold creators, and quiet rebels. Amid the chaos, we build digital spaces for sharp focus and inspired work."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      .velorah-root {
        --velorah-background: 201 100% 13%;
        --velorah-foreground: 0 0% 100%;
        --velorah-muted-foreground: 240 4% 66%;
        --velorah-primary: 0 0% 100%;
        --velorah-primary-foreground: 0 0% 4%;
        --velorah-secondary: 0 0% 10%;
        --velorah-muted: 0 0% 10%;
        --velorah-accent: 0 0% 10%;
        --velorah-border: 0 0% 18%;
        --velorah-input: 0 0% 18%;
        --font-display: 'Instrument Serif', serif;
        --font-body: 'Inter', sans-serif;
        font-family: var(--font-body);
        background-color: hsl(var(--velorah-background));
      }
      .velorah-root .text-foreground {
        color: hsl(var(--velorah-foreground));
      }
      .velorah-root .text-muted-foreground {
        color: hsl(var(--velorah-muted-foreground));
      }

      .liquid-glass {
        background: rgba(255, 255, 255, 0.01);
        background-blend-mode: luminosity;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border: none;
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
      }
      .liquid-glass::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1.4px;
        background: linear-gradient(180deg,
          rgba(255,255,255,0.45) 0%, rgba(255,255,255,0.15) 20%,
          rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%,
          rgba(255,255,255,0.15) 80%, rgba(255,255,255,0.45) 100%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
      }

      @keyframes fade-rise {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-rise { animation: fade-rise 0.8s ease-out both; }
      .animate-fade-rise-delay { animation: fade-rise 0.8s ease-out 0.2s both; }
      .animate-fade-rise-delay-2 { animation: fade-rise 0.8s ease-out 0.4s both; }

      @media (prefers-reduced-motion: reduce) {
        .animate-fade-rise,
        .animate-fade-rise-delay,
        .animate-fade-rise-delay-2 {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <VelorahHero client:load />
  </body>
</html>
