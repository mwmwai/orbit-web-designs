---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import Comments from "../../components/Comments.astro";
import { whatsappLink } from "../../config";
---

<Layout
	title="WhatsApp Business Kenya: Setup Tutorial (Copy-Paste) | Orbit"
	description="Turn WhatsApp into sales: Business profile, catalog, quick replies, labels and click-to-chat — copy-paste setup, free DIY."
>
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides · WhatsApp · 5 min</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Turn WhatsApp into <span class="text-gradient">your best salesperson.</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">Free setup you can do this afternoon — templates to copy.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<h2 class="text-xl font-bold text-white">1) Business profile (5 min)</h2>
			<ul class="mt-3 grid gap-2 text-sm text-slate-300">
				<li>→ Logo, exact location, hours, catalog with prices. Empty profile = no trust.</li>
				<li>→ Short description with what you sell + estate (e.g. "Thrift dresses in Gikomba, delivery countrywide").</li>
			</ul>

			<h2 class="mt-8 text-xl font-bold text-white">2) Greeting + away messages</h2>
			<div class="mt-3 rounded-xl bg-panel border border-edge p-4 text-sm text-slate-300">
				<p class="font-mono text-xs text-electric">Greeting</p><p class="mt-1">Hi! Thanks for chatting with [Biz]. We reply in minutes 8am–7pm. Tell me what you need — price, size, delivery?</p>
				<p class="mt-3 font-mono text-xs text-electric">Away</p><p class="mt-1">Hey! We're offline 7pm–8am but left your message starred — first reply at 8am. For urgent: [alt number].</p>
			</div>

			<h2 class="mt-8 text-xl font-bold text-white">3) Quick replies + labels</h2>
			<p class="mt-3 text-sm text-slate-400">Business → Quick replies:</p>
			<div class="mt-3 grid gap-2 font-mono text-xs">
				<div class="rounded-lg border border-edge bg-panel p-3 text-slate-300"><span class="text-electric">/price</span> — It's KES [ ] + delivery [ ]. M-Pesa Paybill [ ] Acc [your phone]. Want invoice?</div>
				<div class="rounded-lg border border-edge bg-panel p-3 text-slate-300"><span class="text-electric">/location</span> — We're at [exact], open [hours]. Pin: [maps link]</div>
				<div class="rounded-lg border border-edge bg-panel p-3 text-slate-300"><span class="text-electric">/hours</span> — Mon–Sat 8–7, Sun 10–4.</div>
			</div>
			<p class="mt-3 text-sm text-slate-400">Labels: <span class="text-white">New</span> · <span class="text-white">Quoted</span> · <span class="text-white">Paid</span> · <span class="text-white">Shipped</span> · <span class="text-white">VIP</span> — filter daily, never lose a lead.</p>

			<h2 class="mt-8 text-xl font-bold text-white">4) Click-to-chat everywhere</h2>
			<p class="mt-3 text-sm text-slate-400">Link pattern to put on every page/receipt/flyer:</p>
			<div class="mt-3 rounded-xl bg-panel border border-edge p-4 font-mono text-xs text-slate-300">https://wa.me/2547XXXXXXXX?text=Hi!%20I%20want%20[product]%20size%20[colour]%20delivered%20to%20[estate]</div>
			<p class="mt-2 text-xs text-slate-500">Put YOUR number and message — prefilled text triples replies.</p>

			<div class="mt-10 rounded-2xl border border-edge bg-panel p-6">
				<p class="text-sm font-semibold text-white">Where Orbit fits</p>
				<p class="mt-1 text-sm text-slate-400">DIY above in an afternoon, or WhatsApp Responder 29,999: we do profile + catalog + labels + quick replies + site buttons in one go. <a href={whatsappLink("Hi Orbit! Set up my WhatsApp Business properly.")} target="_blank" rel="noopener noreferrer" class="text-electric hover:underline">Set mine up →</a></p>
			</div>
		</article>

		<Comments slug="whatsapp-business-kenya" />
		<CtaBand title="Your customers are already chatting." text="Be the business that answers first — in minutes, Mon–Sat." />
	</main>
	<Footer />
</Layout>
