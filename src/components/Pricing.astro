---
const plans = [
	{
		name: "Starter",
		price: "KES 15,000",
		blurb: "For new businesses going online.",
		features: [
			"One polished landing page",
			"Mobile-responsive design",
			"WhatsApp & contact integration",
			"Basic on-page SEO",
			"1 round of revisions",
			"1 month of maintenance",
		],
		cta: "Choose Starter",
		featured: false,
	},
	{
		name: "Business",
		price: "KES 25,000",
		blurb: "For growing brands ready to scale.",
		features: [
			"Up to 6 custom pages",
			"Custom layouts & animations",
			"Advanced SEO setup",
			"Integrations (Maps, socials)",
			"3 rounds of revisions",
			"3 months of maintenance",
			"Free domain setup",
		],
		cta: "Choose Business",
		featured: true,
	},
	{
		name: "Commerce / Custom",
		price: "KES 35,000+",
		blurb: "For brands going all in.",
		features: [
			"Full online store or web app",
			"M-Pesa & card checkout",
			"Product & inventory management",
			"Order notifications",
			"Custom features on request",
			"6 months of support",
		],
		cta: "Choose Commerce",
		featured: false,
	},
];
---

<section id="pricing" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Pricelist</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Straight-line pricing. Clear as the night sky.
			</h2>
			<p class="mt-4 max-w-xl text-slate-400">
				Three packages built for growing businesses — one-time payment, delivered fast.
			</p>
		</div>

		<div class="grid items-stretch gap-6 lg:grid-cols-3">
			{
				plans.map((p, i) => (
					<article class="reveal" style={`transition-delay:${i * 70}ms`}>
						<div
							data-tilt
							class={`relative flex h-full flex-col rounded-2xl p-8 ${
								p.featured
									? "border border-electric/50 bg-gradient-to-b from-electric/10 to-transparent shadow-2xl shadow-electric/10"
									: "glow-border"
							}`}
						>
							{p.featured && (
								<span class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">
									Most popular
								</span>
							)}
							<h3 class="text-lg font-semibold text-white">{p.name}</h3>
							<p class="mt-2 text-sm text-slate-400">{p.blurb}</p>
							<p class="mt-6">
								<span class="text-gradient text-4xl font-extrabold tracking-tight">{p.price}</span>
							</p>
							<ul class="mt-8 grid flex-1 content-start gap-3">
								{p.features.map((f) => (
									<li class="flex items-start gap-3 text-sm text-slate-300">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0">
											<path d="M20 6L9 17l-5-5" />
										</svg>
										{f}
									</li>
								))}
							</ul>
							<a
								href="/contact"
								class={`mt-8 block rounded-full py-3 text-center font-semibold transition ${
									p.featured
										? "btn-gradient text-white shadow-lg shadow-electric/25 hover:-translate-y-0.5"
										: "border border-edge bg-panel text-slate-200 hover:border-electric/60 hover:text-white"
								}`}
							>
								{p.cta}
							</a>
						</div>
					</article>
				))
			}
		</div>

		<p class="reveal mt-8 text-sm text-slate-500">
			Need something different? <a href="/contact" class="text-electric hover:underline">Ask for a custom quote</a> — or browse care plans on request.
		</p>
	</div>
</section>

<section id="payments" class="border-t border-white/5 pb-8 pt-4">
	<div class="mx-auto max-w-7xl px-5">
		<div class="glow-border reveal flex flex-col items-start gap-6 rounded-2xl px-8 py-8 md:flex-row md:items-center md:justify-between">
			<div>
				<h3 class="text-lg font-semibold text-white">Payments, handled quietly.</h3>
				<p class="mt-1 max-w-md text-sm text-slate-400">M-Pesa, cards and PayPal — secure, verified, no drama.</p>
			</div>
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest">
				<span class="border border-edge px-4 py-2 text-stone">M-Pesa</span>
				<span class="border border-edge px-4 py-2 text-stone">Card</span>
				<span class="border border-edge px-4 py-2 text-stone">PayPal</span>
			</div>
		</div>
	</div>
</section>


