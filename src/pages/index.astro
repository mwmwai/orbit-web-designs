---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
---

<Layout>
	<Navbar client:load />
	<main id="main">
		<Hero />
		<Services />
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute left-1/2 top-0 h-[300px] w-[700px] -translate-x-1/2 rounded-full bg-electric/10 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="text-reveal mb-10 max-w-2xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Why Orbit</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Built different, on purpose.</h2>
				</div>
				<div class="grid gap-6 md:grid-cols-3">
					{[
						["Live in days", "Starter sites go live in 48–72 hours. Business in days, Master in a week or so. No month-long sagas."],
						["M-Pesa native", "Paybill, Till, cards and PayPal wired from day one — checkout in under a minute."],
						["Human on WhatsApp", "Reply in minutes, Mon–Sat. Talk to the builder, not a ticket queue."],
					].map(([t, d], i) => (
						<article data-tilt class="reveal glow-border edge-glow group relative flex flex-col rounded-2xl p-8 transition duration-300 hover:-translate-y-1.5 hover-lift magnetic" style={`transition-delay:${i * 80}ms`}>
							<span class="text-gradient text-3xl font-extrabold">0{i + 1}</span>
							<h3 class="mt-4 text-xl font-semibold text-white">{t}</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{d}</p>
						</article>
					))}
				</div>
			</div>
		</section>
		<Pricing only={["Starter", "Business", "Master"]} />
		<Process />
		<Testimonials />
		<!-- Proof: anonymized outcomes (no stock photos) -->
		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-7xl px-5">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Outcomes · anonymized</p>
				<div class="mt-8 grid gap-6 md:grid-cols-3">
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">Law firm · Nairobi</p><p class="mt-3 text-3xl font-extrabold text-white">Page 5 → 1</p><p class="mt-2 text-sm text-slate-400">Main service term in 3 months. Inquiries from searches they never ranked for before.</p></article>
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">E-commerce · M-Pesa store</p><p class="mt-3 text-3xl font-extrabold text-white">100s / month</p><p class="mt-2 text-sm text-slate-400">M-Pesa checkout never called about gateway. Stock auto-subtracts, orders ping WhatsApp.</p></article>
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">Advocacy · 12 months later</p><p class="mt-3 text-3xl font-extrabold text-white">&lt;2s load</p><p class="mt-2 text-sm text-slate-400">Still under 2s after a year. Speed kept via monthly Care tuning.</p></article>
				</div>
				<p class="mt-4 text-xs text-slate-500">Full names on request — <a href="/reviews" class="text-electric hover:underline">reviews →</a> · <a href="https://g.page/r/CS264QqxfOvBECE/review" target="_blank" rel="noopener noreferrer" class="text-electric hover:underline">Google reviews →</a></p>
			</div>
		</section>
		<!-- Surfaced: SaaS -->
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Custom SaaS Apps</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Your idea as a real app.</h2>
					<p class="mt-4 text-slate-400">Auth, roles, dashboards and M-Pesa payments — shipped from KES 49,999 with docs, training and 3 months support. No template locking you in.</p>
				</div>
				<div class="flex shrink-0 flex-wrap gap-3">
					<a href="/packages" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20">See SaaS — 49,999</a>
					<a href="/contact" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Start yours</a>
				</div>
			</div>
		</section>
		<!-- Surfaced: Graphic Design -->
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Brand & Graphic Design</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Look like the price you charge.</h2>
					<p class="mt-4 text-slate-400">Logos from 14,999, full kits to 24,999 — social kits, flyers, one-page guidelines. Source files included.</p>
				</div>
				<div class="flex shrink-0 flex-wrap gap-3">
					<a href="/packages" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Design from 14,999</a>
					<a href="/contact" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Get a quote</a>
				</div>
			</div>
		</section>
		<!-- Surfaced: Orbit Care -->
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto max-w-7xl px-5">
				<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
					<div class="max-w-xl">
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Orbit Care — recurring revenue, made visible</p>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">A site you never worry about.</h2>
						<p class="mt-4 text-slate-400">Hosting, security patches, speed tuning, backups and human WhatsApp support — 7,599/mo Starter · 9,599 Business · 11,999 Master. Cancel anytime, your site stays yours.</p>
					</div>
					<a href="/care" class="shrink-0 rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20">See Care — from 7,599</a>
				</div>
				<div class="mt-8 grid gap-3 sm:grid-cols-3">
					<div class="glow-border rounded-2xl p-5"><p class="text-sm font-semibold text-white">Starter Care</p><p class="mt-1 text-2xl font-extrabold text-gradient">7,599<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="mt-1 text-xs text-slate-400">For 29,999 sites</p></div>
					<div class="glow-border rounded-2xl p-5 border-electric/30"><p class="text-sm font-semibold text-white">Business Care</p><p class="mt-1 text-2xl font-extrabold text-gradient">9,599<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="mt-1 text-xs text-slate-400">For 39,999 sites · most popular</p></div>
					<div class="glow-border rounded-2xl p-5"><p class="text-sm font-semibold text-white">Master Care</p><p class="mt-1 text-2xl font-extrabold text-gradient">11,999<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="mt-1 text-xs text-slate-400">For stores & booking</p></div>
				</div>
			</div>
		</section>
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ About</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Built hungry, based in Nairobi.</h2>
					<p class="mt-4 text-slate-400">No bloated agency, no hand-offs — you talk to the person building your site.</p>
				</div>
				<a href="/about" class="shrink-0 rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Meet Orbit</a>
			</div>
		</section>
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Learn the game. Then win it.</h2>
					<p class="mt-4 text-slate-400">7 honest, actionable guides — pricing, care, SEO, M-Pesa and WhatsApp with checklists and real numbers.</p>
				</div>
				<a href="/guides" class="shrink-0 rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Read guides</a>
			</div>
		</section>
		<!-- Surfaced: Agents + Workflows split -->
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto max-w-7xl px-5">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Agents & Workflows</p>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">AI that does the work.</h2>
				<div class="mt-8 grid gap-6 md:grid-cols-2">
					<div class="glow-border rounded-2xl p-8 flex flex-col"><h3 class="text-xl font-semibold text-white">Custom AI Agents — 49,999</h3><p class="mt-2 text-sm text-slate-400">Trained on your business — WhatsApp/site chat/email, qualifies leads, books, hands to human.</p><a href="/automation" class="mt-6 inline-flex w-fit rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 hover:border-electric/60 hover:text-white">See agents →</a></div>
					<div class="glow-border rounded-2xl p-8 flex flex-col"><h3 class="text-xl font-semibold text-white">Workflow Automation — 39,999</h3><p class="mt-2 text-sm text-slate-400">M-Pesa → Sheets/CRM, inquiry → WhatsApp → calendar, invoices auto-sent. You own it.</p><a href="/automation" class="mt-6 inline-flex w-fit rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 hover:border-electric/60 hover:text-white">See workflows →</a></div>
				</div>
			</div>
		</section>
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Dashboards</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Your numbers, one screen.</h2>
					<p class="mt-4 text-slate-400">M-Pesa sales, bookings and stock at a glance — from 35,000, no app install.</p>
				</div>
				<a href="/dashboards" class="shrink-0 rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">See dashboards</a>
			</div>
		</section>
		<FAQ />
		<CtaBand title="Your competitors are online. Are you?" text="One message. One website. More customers. 10% off new orders ends 30 September." />
	</main>
	<FloatingActions />
	<Footer />
</Layout>

