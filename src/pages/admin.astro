---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Admin — Orbit">
  <main class="mx-auto max-w-3xl px-5 py-24">
    <h1 class="text-3xl font-bold text-white">Orbit Admin</h1>
    <p class="mt-2 text-slate-400">Edit everything manually — no GitHub login needed for preview. Use Decap at <a href="/admin/" class="text-electric underline">/admin/</a> after OAuth is configured.</p>
    <div class="mt-8 grid gap-4">
      <a href="https://github.com/mwmwai/orbit-web-designs" target="_blank" class="rounded-xl border border-edge bg-panel p-6 hover:border-electric/60">Open GitHub — edit src/data/*.json directly</a>
      <div class="rounded-xl border border-edge bg-panel p-6"><p class="font-semibold text-white">Quick edits</p><p class="text-sm text-slate-400">Tell me what to change — e.g. "Starter to 22k" — and I push it.</p></div>
    </div>
  </main>
</Layout>
