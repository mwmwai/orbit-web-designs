{
  "name": "marketing-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "generate": "node src/generate.mjs",
    "review": "node src/review.mjs",
    "render": "node src/render.mjs",
    "publish": "node src/publish.mjs",
    "idea": "node src/idea.mjs",
    "app": "node src/app.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis portable",
    "studio": "remotion studio video/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "co.orbitwebdesigns.marketingagent",
    "productName": "Marketing Agent",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "video/**",
      "topics.json",
      "remotion.config.ts",
      "tsconfig.json"
    ],
    "asarUnpack": [
      "node_modules/@remotion/**",
      "node_modules/remotion/**",
      "node_modules/esbuild/**",
      "node_modules/@esbuild/**"
    ],
    "win": {
      "target": [
        {"target": "nsis"},
        {"target": "portable"}
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
