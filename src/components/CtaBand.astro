---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
interface Props { title?: string; text?: string; }
const { title = "Ready to grow?", text = "A short conversation. A clear quote. No pitch." } = Astro.props;
---

<section class="border-t border-edge/40 py-20 md:py-28">
	<div class="reveal mx-auto flex max-w-7xl flex-col items-start justify-between gap-10 border border-edge bg-panel px-8 py-12 md:flex-row md:items-center md:px-12">
		<div>
			<h2 class="font-display text-2xl leading-none tracking-tight text-cream md:text-3xl">{title}</h2>
			<p class="mt-3 max-w-lg leading-relaxed text-stone">{text}</p>
		</div>
		<a href={whatsappLink(DEFAULT_WA_MESSAGE)} target="_blank" rel="noopener noreferrer" class="link-underline">
			Get a free quote <span aria-hidden>→</span>
		</a>
	</div>
</section>
