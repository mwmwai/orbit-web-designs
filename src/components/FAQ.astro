---
const faqs = [
	{
		q: "How long does it take?",
		a: "Starter sites go live in 5 days once we have your photos, text and logo. Business takes 1 week, Master 2 weeks. You approve the design before anything goes live.",
	},
	{
		q: "Do I need to pay monthly?",
		a: "Yes — Orbit Care keeps your site fast, safe and online: hosting, security, updates and priority support at KES 7,499/month (Starter), 10,999 (Business) or 13,999 (Master). No surprise bills, cancel anytime.",
	},
	{
		q: "What do you need from me?",
		a: "Only 3 things: photos of your business, text about what you do, and your logo. No logo? We design one for you from KES 17,999.",
	},
	{
		q: "How much does a website cost?",
		a: "Starter KES 35,999 (5 pages), Business KES 47,999 (10 pages) and Master KES 59,999 (online store or booking system).",
	},
	{
		q: "Will customers find me on Google?",
		a: "Yes. Every site ships with SEO setup — titles, descriptions and Google Business Profile. Master adds advanced SEO that targets the searches bringing paying customers.",
	},
	{
		q: "What if I don't like the design?",
		a: "You approve the design before anything goes live — we revise until you're happy. If we part ways early, you only pay for work already done.",
	},
	{
		q: "Can I pay in parts?",
		a: "Yes. 50% to start, 50% on launch. After that, a small monthly covers hosting, security and support — no big surprise bills.",
	},
	{
		q: "Who owns my website?",
		a: "You do — your content, your domain, your business. You get a full license to use everything we build; the full details are in our Terms page.",
	},
];
---

<section id="faq" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="grid gap-12 lg:grid-cols-5">
			<div class="text-reveal lg:col-span-2">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ FAQ</p>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Everything clients ask before lift-off.
				</h2>
				<p class="mt-4 max-w-md text-slate-400">
					Still unsure? Ask on WhatsApp — honest advice, no pitch.
				</p>
			</div>
			<div class="grid content-start gap-4 lg:col-span-3">
				{
					faqs.map((f, i) => (
						<details class="reveal group border border-edge/70 bg-charcoal/50 px-6 py-5 open:border-electric/30 card-shine edge-glow hover-lift magnetic" style={`transition-delay:${i * 50}ms`}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-white [&::-webkit-details-marker]:hidden">
								{f.q}
								<span class="font-mono text-electric transition duration-300 group-open:rotate-45">＋</span>
							</summary>
							<p class="mt-4 text-sm leading-relaxed text-slate-400">{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>


