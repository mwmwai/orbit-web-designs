---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config";
---

<Layout
	title="M-Pesa E-commerce Websites Kenya — Online Stores That Sell | Orbit"
	description="E-commerce websites in Kenya with M-Pesa Paybill/Till, card and PayPal checkout. Stores from KES 49,999, live in 2–3 weeks. Chat on WhatsApp."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ M-Pesa · Kenya</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Online stores with <span class="text-gradient">M-Pesa checkout.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					Your customers pay with M-Pesa Paybill or Till, cards or PayPal — checkout in under a minute, orders ping your WhatsApp instantly. Stores from KES 49,999.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a href={whatsappLink("Hi Orbit! I want an online store with M-Pesa checkout. What do you need from me?")} target="_blank" rel="noopener noreferrer" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white magnetic ripple">Sell online this month — chat now</a>
					<a href="/packages" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">View pricing</a>
				</div>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto grid max-w-7xl gap-6 px-5 md:grid-cols-2 lg:grid-cols-4">
				{[
					["M-Pesa first", "Paybill & Till checkout your customers already trust — plus cards and PayPal."],
					["Inventory that behaves", "Stock counts itself down with every sale. Low-stock alerts before you run dry."],
					["Orders on WhatsApp", "Every order pings your phone instantly with items, amount and delivery details."],
					["Found on Google", "Product pages built to rank for what Kenyans actually search."],
				].map(([t, d]) => (
					<div class="glow-border rounded-2xl p-6">
						<h2 class="font-semibold text-white">{t}</h2>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">{d}</p>
					</div>
				))}
			</div>
		</section>

		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-3xl px-5">
				<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">An honest note on STK Push</h2>
				<p class="mt-4 leading-relaxed text-slate-400">Paybill and Till checkout work out of the box. Automatic STK phone prompts need your own Safaricom Daraja approval — we wire it the day your credentials land. Use our free <a href="/mpesa-fee-calculator" class="text-electric hover:underline">M-Pesa fee calculator</a> to price your margins.</p>
			</div>
		</section>

		<CtaBand title="Ready to sell online?" text="Tell us what you sell — we reply with package, timeline and honest price." />
	</main>
	<Footer />
</Layout>
