---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Packages Template — Screenshot for IG | Orbit" description="Poster template for packages. Screenshot at 1080 wide.">
  <main class="min-h-screen bg-ink flex items-center justify-center p-4 md:p-8">
    <!-- Poster: screenshot this box. Set browser to 1080 wide for perfect IG -->
    <div id="poster" class="w-full max-w-[1080px] rounded-[32px] border border-white/10 bg-gradient-to-b from-[#0F172A] to-[#080B14] overflow-hidden shadow-2xl">
      <!-- Top bar -->
      <div class="flex items-center justify-between px-8 py-6 md:px-10 border-b border-white/5">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-gradient-to-br from-electric to-neon grid place-items-center font-black text-white text-sm">O</div>
          <div>
            <p class="font-extrabold tracking-tight text-white leading-none">ORBIT</p>
            <p class="text-[10px] tracking-[0.18em] text-slate-400">WEB DESIGNS & MARKETING</p>
          </div>
        </div>
        <span class="rounded-full bg-electric/10 px-3 py-1 text-xs font-bold tracking-widest text-electric">2026 PRICES</span>
      </div>

      <!-- Headline -->
      <div class="px-8 md:px-10 pt-8 pb-2 text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Websites that <span class="text-gradient">sell while you sleep.</span>
        </h1>
        <p class="mt-3 text-sm md:text-base text-slate-400">M-Pesa Till + Paybill wired natively · Live in days, not months</p>
      </div>

      <!-- 3 Packages -->
      <div class="grid md:grid-cols-3 gap-5 px-6 md:px-8 py-8">
        <!-- Starter -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col hover:border-white/15 transition-colors">
          <p class="text-[11px] tracking-[0.18em] font-semibold text-slate-400">STARTER</p>
          <p class="mt-3 text-[34px] font-black tracking-tight text-white leading-none">35,999<span class="text-sm font-bold text-slate-400 ml-1">KES</span></p>
          <p class="text-xs text-slate-500 mt-1">5 days · 5 pages</p>
          <div class="mt-1 h-px bg-white/10"></div>
          <ul class="mt-4 grid gap-2.5 text-[13px] leading-none text-slate-300">
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> WhatsApp + call</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Basic SEO + GBP</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Copy for 3 pages</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Analytics</li>
          </ul>
          <p class="mt-5 text-xs font-medium text-slate-500">Perfect to prove demand</p>
        </div>
        <!-- Business - popular -->
        <div class="rounded-2xl border-2 border-cyan-400/50 bg-gradient-to-b from-cyan-400/[0.12] via-cyan-400/[0.04] to-transparent p-7 flex flex-col relative overflow-hidden shadow-[0_0_40px_rgba(34,211,238,0.15)]">
          <span class="absolute top-4 right-4 rounded-full bg-cyan-400 px-3 py-1 text-[10px] font-black tracking-widest text-ink shadow-lg">MOST PICKED</span>
          <p class="text-[11px] tracking-[0.18em] font-black text-cyan-400">BUSINESS</p>
          <p class="mt-3 text-[34px] font-black tracking-tight text-white leading-none">47,999<span class="text-sm font-bold text-slate-400 ml-1">KES</span></p>
          <p class="text-xs text-slate-400 mt-1">1 week · 10 pages + blog</p>
          <div class="mt-1 h-px bg-cyan-400/20"></div>
          <ul class="mt-4 grid gap-2.5 text-[13px] leading-none text-slate-100">
            <li class="flex gap-2"><span class="text-cyan-400">✓</span> Full SEO (90+)</li>
            <li class="flex gap-2"><span class="text-cyan-400">✓</span> Bookings / Calendly</li>
            <li class="flex gap-2"><span class="text-cyan-400">✓</span> Copy all pages</li>
            <li class="flex gap-2"><span class="text-cyan-400">✓</span> &lt;2 sec loads</li>
          </ul>
          <p class="mt-5 text-xs font-bold text-cyan-400">Best value for most SMEs</p>
        </div>
        <!-- Master -->
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col hover:border-white/15 transition-colors">
          <p class="text-[11px] tracking-[0.18em] font-semibold text-slate-400">MASTER</p>
          <p class="mt-3 text-[34px] font-black tracking-tight text-white leading-none">59,999<span class="text-sm font-bold text-slate-400 ml-1">KES</span></p>
          <p class="text-xs text-slate-500 mt-1">2 weeks · 15+ or store</p>
          <div class="mt-1 h-px bg-white/10"></div>
          <ul class="mt-4 grid gap-2.5 text-[13px] leading-none text-slate-300">
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> M-Pesa + cards / PayPal</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Inventory sync</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Automations</li>
            <li class="flex gap-2"><span class="text-emerald-400">✓</span> Training video</li>
          </ul>
          <p class="mt-5 text-xs font-medium text-slate-500">For stores & bookings</p>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="mx-6 md:mx-8 mb-8 rounded-2xl bg-gradient-to-r from-electric to-neon p-[1px]">
        <div class="rounded-2xl bg-ink px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="text-center md:text-left">
            <p class="font-bold text-white">Get your fit on WhatsApp — reply in minutes, Mon–Sat</p>
            <p class="text-sm text-slate-400">orbitwebdesigns.co.ke · +254 741 992 308</p>
          </div>
          <span class="rounded-full bg-white px-6 py-3 text-sm font-black text-ink whitespace-nowrap">WHATSAPP US →</span>
        </div>
      </div>

      <p class="text-center text-[10px] tracking-widest text-slate-500 pb-6">CARE FROM 7,499/MO · YOU OWN EVERYTHING · CANCEL ANYTIME</p>
    </div>
  </main>

  <div class="mx-auto max-w-3xl px-5 py-8 text-center">
    <p class="text-sm text-slate-400">Screenshot the poster above — set browser to <span class="text-white font-semibold">1080px wide</span> (Ctrl+Shift+M in Chrome) for perfect IG post. Or print to PDF.</p>
    <p class="mt-2 text-xs text-slate-500">Tip: On phone, long-press poster → screenshot → crop to poster. Use as feed post + story.</p>
  </div>
</Layout>
