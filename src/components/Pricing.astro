			"Basic SEO so Google finds you",
			"Selling copy polished for you",
			"Free domain setup",
			"Google Business Profile setup",
			"Live in 48–72 hours",
		],
		cta: "Claim 10% off",
		featured: false,
	},
	{
		name: "Business",
		price: "KES 39,999",
		usd: "≈ $310",
		eur: "≈ €285",
		care: "+ KES 9,599/mo Orbit Care",
		blurb: "Up to 7 pages that rank, plus bookings while you sleep.",
		features: [
