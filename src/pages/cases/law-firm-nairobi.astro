---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<Layout title="Case — Law Firm Page 5 → 1 in 3 Months | Orbit" description="Nairobi law firm: buyer keywords + GBP + speed, page 5 to 1 in 3 months. Anonymized case.">
	<Navbar client:load />
	<main id="main">
		<section class="border-b border-white/5 py-16 pt-24">
			<div class="mx-auto max-w-3xl px-5">
				<p class="font-mono text-xs uppercase tracking-widest text-electric">■ Case · Law firm · Nairobi</p>
				<h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Page 5 → 1 for main service term — 3 months.</h1>
				<p class="mt-4 text-slate-400">Buyer phrase targeting + Business Profile + 95+ speed. Inquiries from searches they never ranked for before. Starter → Business upgrade after.</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-3 text-sm">
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Before</p><p class="text-slate-400">Page 5, no GBP posts, 3.8s load</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Moves</p><p class="text-slate-400">GBP rebuild, titles/H1s, compress, reviews</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">After</p><p class="text-slate-400">Page 1, 4.9★, &lt;2s</p></div>
				</div>
				<p class="mt-6 text-xs text-slate-500">Anonymized — full name on request. <a href="/reviews" class="text-electric hover:underline">Reviews →</a></p>
			</div>
		</section>
		<CtaBand />
	</main>
	<Footer />
</Layout>
