  <style>
    .o3d-reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
    .o3d-reveal.is-visible { opacity: 1; transform: none; }
    [data-tilt] { transition: transform .35s ease, box-shadow .35s ease; will-change: transform; }
    .o3d-word { display: inline-block; opacity: 0; transform: translateY(0.6em) rotate(2deg); animation: o3dWordIn .8s cubic-bezier(0.22,1,0.36,1) forwards; animation-delay: calc(var(--i, 0) * 70ms + 150ms); }
    .o3d-grad { background: linear-gradient(90deg, #00c8ff, #2f7bff); -webkit-background-clip: text; background-clip: text; color: transparent; }
    @keyframes o3dWordIn { to { opacity: 1; transform: none; } }
    [data-magnetic] { transition: transform .35s cubic-bezier(0.22,1,0.36,1); display: inline-block; }
    .o3d-grain { position: fixed; inset: 0; z-index: 40; pointer-events: none; opacity: .05; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); }
    .o3d-vignette { position: fixed; inset: 0; z-index: 39; pointer-events: none; background: radial-gradient(80% 70% at 50% 40%, transparent 45%, rgb(0 0 0 / 0.5) 100%); }
    @media (prefers-reduced-motion: reduce) { .o3d-reveal, .o3d-word { opacity: 1 !important; transform: none !important; animation: none !important; } }
  </style>

  <script>
    function initO3D() {
      // loader
      const loader = document.getElementById("o3d-loader");
      const loadbar = document.getElementById("o3d-loadbar");
      if (loader && !loader.dataset.done) {
        loader.dataset.done = "1";
        if (loadbar) {
          loadbar.style.transition = "width 0.9s ease";
          requestAnimationFrame(() => { loadbar.style.width = "100%"; });
        }
        window.setTimeout(() => {
          loader.style.opacity = "0";
          window.setTimeout(() => loader.remove(), 750);
        }, 950);
      }
      // custom cursor (desktop, fine pointer only)
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        const dot = document.getElementById("o3d-dot");
        const ring = document.getElementById("o3d-ring");
        if (dot && ring && !dot.dataset.bound) {
          dot.dataset.bound = "1";
          let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
          addEventListener("mousemove", (ev) => {
            const e = ev as MouseEvent;
            mx = e.clientX; my = e.clientY;
            dot.style.transform = `translate(${mx - 4}px, ${my - 4}px)`;
          });
          (function loop() {
            rx += (mx - rx) * 0.16;
            ry += (my - ry) * 0.16;
            ring.style.transform = `translate(${rx - 16}px, ${ry - 16}px)`;
            requestAnimationFrame(loop);
          })();
        }
      }
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll(".o3d-reveal").forEach((el) => io.observe(el));
      // scroll progress
      const bar = document.getElementById("o3d-progress");
      function onScroll() {
        if (!bar) return;
        const h = document.documentElement.scrollHeight - innerHeight;
        bar.style.width = (h > 0 ? (scrollY / h) * 100 : 0) + "%";
      }
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      // animated counters (copied behavior from main site)
      document.querySelectorAll("[data-counter]").forEach((el) => {
        const node = el as HTMLElement;
        if (node.dataset.counted) return;
        node.dataset.counted = "1";
        const m = (node.textContent || "").trim().match(/^([^\d]*)(\d+)(.*)$/);
        if (!m) return;
        const pre = m[1], target = parseInt(m[2], 10), suf = m[3];
        const cio = new IntersectionObserver((es) => {
          if (!es[0].isIntersecting) return;
          cio.disconnect();
          const t0 = performance.now();
          (function tick(t) {
            const p = Math.min((t - t0) / 1200, 1);
            node.textContent = pre + Math.round(target * (1 - Math.pow(1 - p, 3))) + suf;
            if (p < 1) requestAnimationFrame(tick);
          })(t0);
        }, { threshold: 0.4 });
        cio.observe(node);
      });
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      document.querySelectorAll("[data-tilt]").forEach((el) => {
        const card = el as HTMLElement;
        if (card.dataset.bound) return;
        card.dataset.bound = "1";
        card.addEventListener("mousemove", (ev) => {
          const e = ev as MouseEvent;
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          card.style.transform = `perspective(900px) rotateX(${(-py * 8).toFixed(2)}deg) rotateY(${(px * 10).toFixed(2)}deg) translateY(-4px)`;
        });
        card.addEventListener("mouseleave", () => { card.style.transform = ""; });
      });
      // magnetic buttons
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll("[data-magnetic]").forEach((el) => {
          const m = el as HTMLElement;
          if (m.dataset.mag) return;
          m.dataset.mag = "1";
          m.addEventListener("mousemove", (ev) => {
            const e = ev as MouseEvent;
            const r = m.getBoundingClientRect();
            m.style.transform = `translate(${((e.clientX - r.left - r.width / 2) * 0.25).toFixed(1)}px, ${((e.clientY - r.top - r.height / 2) * 0.25).toFixed(1)}px)`;
          });
          m.addEventListener("mouseleave", () => { m.style.transform = ""; });
        });
      }
      // press W anywhere for warp
      if (!document.body.dataset.warpKey) {
        document.body.dataset.warpKey = "1";
        addEventListener("keydown", (ev) => {
          const e = ev as KeyboardEvent;
          if (e.key.toLowerCase() === "w" && !(e.target as HTMLElement)?.closest("input, textarea")) {
            document.getElementById("o3d-warp-zone")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
          }
        });
      }
    }
    document.addEventListener("astro:page-load", initO3D);
    initO3D();
  </script>
</body>
</html>
