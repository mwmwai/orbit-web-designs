---
import { SITE_NAME, SITE_EMAIL, NAV_LINKS } from "../config";
const year = new Date().getFullYear();
---

<footer class="border-t border-edge/40 py-16 md:py-20">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="flex flex-col items-start justify-between gap-12 md:flex-row">
			<div>
				<a href="/" class="inline-flex items-center gap-4">
					<img src="/logo-mark.png" alt="Orbit logo" width={40} height={40} class="opacity-90" />
					<span class="leading-none">
						<span class="block font-display text-lg tracking-[0.22em] text-cream">ORBIT</span>
						<span class="mt-1 block font-mono text-xs uppercase tracking-[0.18em] text-stone">Web Designs &amp; Marketing</span>
					</span>
				</a>
				<p class="mt-6 max-w-xs text-sm leading-relaxed text-stone">Websites that feel quiet, load fast, and convert.</p>
			</div>
			<nav class="grid grid-cols-2 gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-widest text-stone sm:flex sm:gap-8" aria-label="Footer">
				{NAV_LINKS.map((l) => (<a href={l.href} class="transition hover:text-cream">{l.label}</a>))}
				<a href={`mailto:${SITE_EMAIL}`} class="transition hover:text-cream">Email</a>
			</nav>
		</div>
		<div class="mt-16 border-t border-edge/40 pt-6 font-mono text-xs tracking-widest text-stone">
			© {year} {SITE_NAME}. Worldwide.
		</div>
	</div>
</footer>
