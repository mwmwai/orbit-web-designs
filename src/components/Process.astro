---
const steps = [
	{
		num: "01",
		title: "Discover",
		text: "A focused call to map your goals, audience, competitors and brand voice.",
	},
	{
		num: "02",
		title: "Design",
		text: "Wireframes & high-fidelity mockups you approve before a single line of code.",
	},
	{
		num: "03",
		title: "Build",
		text: "Hand-crafted build with SEO, schema and performance baked in.",
	},
	{
		num: "04",
		title: "Launch & grow",
		text: "Go live, get trained, and start a growth loop with analytics & SEO.",
	},
];
---

<section id="process" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ How we'll work</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				A calm, four-step path from idea to launch.
			</h2>
		</div>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((s, i) => (
					<div class="reveal relative border border-edge/70 bg-charcoal/50 p-8" style={`transition-delay:${i * 70}ms`}>
						<span class="font-display text-5xl font-medium text-electric/20">{s.num}</span>
						<h3 class="mt-4 text-lg font-semibold text-white">{s.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{s.text}</p>
						{i < steps.length - 1 && (
							<span class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-electric/40 lg:block" aria-hidden>→</span>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
