---
const projects = [
	{
		name: "Genthub Barbershop",
		type: "Booking",
		description:
			"A calm booking flow with gallery and deposit payments — no phone tag, fewer no-shows.",
		image:
			"https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=70&w=900&auto=format&fit=crop",
		alt: "Barber at work in a barbershop",
	},
	{
		name: "Sokoni Fresh",
		type: "E-commerce",
		description:
			"Farm-to-door groceries with M-Pesa checkout, live inventory and smart delivery zones.",
		image:
			"https://images.unsplash.com/photo-1542838132-92c53300491e?q=70&w=900&auto=format&fit=crop",
		alt: "Fresh produce on a market stall",
	},
	{
		name: "Zawadi Crafts",
		type: "Storefront",
		description:
			"An artisan storefront that tripled wholesale inquiries within two months of launch.",
		image:
			"https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=70&w=900&auto=format&fit=crop",
		alt: "Minimal product shot of a wristwatch",
	},
	{
		name: "Tatu Heights",
		type: "Real Estate",
		description:
			"Filtered listings, agent profiles and one-tap WhatsApp viewing requests.",
		image:
			"https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=70&w=900&auto=format&fit=crop",
		alt: "Modern apartment building exterior",
	},
	{
		name: "Mama Oliech",
		type: "Hospitality",
		description:
			"Digital menu, reservations and maps for a busy eatery — updated in minutes, not days.",
		image:
			"https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=70&w=900&auto=format&fit=crop",
		alt: "Warm restaurant interior with set tables",
	},
	{
		name: "FitZone",
		type: "Landing",
		description:
			"A single-page machine: schedules, memberships and sign-up without friction.",
		image:
			"https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=70&w=900&auto=format&fit=crop",
		alt: "Modern gym with weights and equipment",
	},
];
---

<section id="work" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Selected work</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Recent launches, still climbing.
			</h2>
			<p class="mt-4 max-w-xl text-slate-400">
				A slice of the 50+ builds we have in orbit right now.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((p, i) => (
					<article
						data-tilt
						class="reveal card-shine glow-border group overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-electric/15"
						style={`transition-delay:${(i % 3) * 80}ms`}
					>
						<div class="relative h-52 overflow-hidden">
							<img
								src={p.image}
								alt={p.alt}
								loading="lazy"
								class="ken-burns h-full w-full object-cover"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
							<span class="absolute left-4 top-4 rounded-full bg-ink/70 px-3 py-1 font-mono text-xs uppercase tracking-widest text-slate-200 backdrop-blur">
								{p.type}
							</span>
						</div>
						<div class="p-6">
							<h3 class="text-lg font-semibold text-white">{p.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{p.description}</p>
						</div>
					</article>
				))
			}
		</div>

		<div class="reveal mt-10 flex flex-col items-start justify-between gap-6 border border-edge/70 bg-charcoal/50 px-8 py-8 md:flex-row md:items-center">
			<div>
				<p class="text-gradient text-3xl font-extrabold">50+ <span class="text-lg font-semibold text-slate-300">and counting</span></p>
				<p class="mt-2 max-w-md text-sm text-slate-400">
					More live projects across beauty, energy, healthcare, travel and education — see them all.
				</p>
			</div>
			<a href="/portfolio" class="link-underline">
				View the full portfolio <span aria-hidden>→</span>
			</a>
		</div>
	</div>
</section>




