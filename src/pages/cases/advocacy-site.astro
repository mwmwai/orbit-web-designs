---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<Layout title="Case — Advocacy Site Still <2s After 12 Months | Orbit" description="Advocacy site built for speed — still under 2s after a year via monthly Care tuning.">
	<Navbar />
	<main id="main">
		<section class="border-b border-white/5 py-16 pt-24">
			<div class="mx-auto max-w-3xl px-5">
				<p class="font-mono text-xs uppercase tracking-widest text-electric">■ Case · Advocacy · 12 months later</p>
				<h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Still &lt;2s after a year.</h1>
				<p class="mt-4 text-slate-400">Built 95+ speed, kept fast via monthly Care re-checks as content grew. No bloat, no plugin tax.</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-3 text-sm">
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Launch</p><p class="text-slate-400">Business 39,999, 5 days</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Care</p><p class="text-slate-400">Business Care 9,599/mo</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Now</p><p class="text-slate-400"><span data-counter>95</span>+ PageSpeed, 12mo later</p></div>
				</div>
				<p class="mt-6 text-xs text-slate-500"><a href="/care" class="text-electric hover:underline">How Care keeps speed →</a></p>
			</div>
		</section>
		<CtaBand />
	</main>
	<Footer />
</Layout>
