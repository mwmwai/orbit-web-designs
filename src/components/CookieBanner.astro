---
---

<div id="cookie-banner" class="fixed bottom-4 inset-x-4 z-[100] hidden">
	<div class="glow-border edge-glow mx-auto flex max-w-3xl flex-col gap-4 rounded-2xl bg-panel/95 p-5 shadow-2xl shadow-black/50 backdrop-blur-md md:flex-row md:items-center md:justify-between" style="box-shadow: 0 8px 40px rgb(0 0 0 / 0.5), 0 0 30px -10px rgb(0 200 255 / 0.25);">
		<div class="flex items-start gap-3">
			<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-electric to-neon text-sm font-bold text-white shadow-lg shadow-electric/30">◈</span>
			<div>
				<p class="text-sm font-semibold text-white">Cookies, your call.</p>
				<p class="mt-0.5 text-xs leading-relaxed text-slate-400">We use cookies for analytics to improve your experience. See our <a href="/cookie-policy" class="text-electric hover:underline">cookie policy</a> and <a href="/privacy-policy" class="text-electric hover:underline">privacy policy</a>.</p>
			</div>
		</div>
		<div class="flex shrink-0 gap-2 pl-12 md:pl-0">
			<button id="cookie-accept" class="rounded-full btn-gradient px-6 py-2 text-sm font-semibold text-white shadow-lg shadow-electric/25 transition hover:-translate-y-0.5">Accept</button>
			<button id="cookie-decline" class="rounded-full border border-edge bg-charcoal px-6 py-2 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Decline</button>
		</div>
	</div>
</div>
<script>
	(() => {
		const k = "orbit_cookie_consent";
		const banner = document.getElementById("cookie-banner");
		if (!banner || banner.dataset.bound) return;
		banner.dataset.bound = "1";
		const consent = localStorage.getItem(k);
		// Always show immediately on every page load, per site owner.
		banner.classList.remove("hidden");
		if (consent === "accepted") (window as any).orbitAnalyticsOK = true;
		document.getElementById("cookie-accept")?.addEventListener("click", () => {
			localStorage.setItem(k, "accepted");
			document.cookie = "orbit_cookie_consent=accepted; path=/; max-age=31536000; SameSite=Lax";
			(window as any).orbitAnalyticsOK = true;
			banner.classList.add("hidden");
			// Load GA if not already loaded
			if (import.meta.env.PUBLIC_GA_ID && !(window as any).gtag) {
				const script = document.createElement("script");
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`;
				document.head.appendChild(script);
				window.dataLayer = window.dataLayer || [];
				function gtag() { dataLayer.push(arguments); }
				(window as any).gtag = gtag;
				gtag('js', new Date());
				gtag('config', import.meta.env.PUBLIC_GA_ID, { anonymize_ip: true });
			}
		});
		document.getElementById("cookie-decline")?.addEventListener("click", () => {
			localStorage.setItem(k, "declined");
			document.cookie = "orbit_cookie_consent=declined; path=/; max-age=31536000; SameSite=Lax";
			banner.classList.add("hidden");
		});
	})();
</script>
