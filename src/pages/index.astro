---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Portfolio from "../components/Portfolio.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
---

<Layout>
	<Navbar client:load />
	<main id="main" class="page-reveal stagger">
		<Hero />
		<Services />
		<Portfolio />
		<Pricing />
		<Process />
		<Testimonials />
		<FAQ />
		<CtaBand title="Ready to build something your customers actually love?" text="Tell us about your project — we reply with honest advice, a timeline and a clear quote." />
	</main>
	<FloatingActions />
	<Footer />
</Layout>

