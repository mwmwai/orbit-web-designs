---
import ContactForm from "./react/ContactForm";
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<section id="contact" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="grid gap-12 lg:grid-cols-2">
			<div class="reveal">
				<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Let's Build Something
					<span class="text-gradient">Great Together</span>
				</h2>
				<p class="mt-5 max-w-md text-slate-400">
					Fill in the form or chat with us directly on WhatsApp. We reply within
					minutes during business hours.
				</p>

				<a
					href={whatsappLink(DEFAULT_WA_MESSAGE)}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#25D366] px-7 py-3.5 font-semibold text-white shadow-lg shadow-[#25D366]/25 transition hover:brightness-110 magnetic ripple hover-lift"
				>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91A9.85 9.85 0 0012.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 018.24 8.24c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.69-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.73-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.29z" />
					</svg>
					Chat on WhatsApp Now
				</a>

				<div class="mt-10 grid gap-4 text-sm text-slate-400">
					<p class="magnetic hover-lift">
						<span class="font-semibold text-white">Email:</span>
						<a href="mailto:mwmwai@gmail.com" class="transition hover:text-electric magnetic ripple">
							mwmwai@gmail.com
						</a>
					</p>
					<p class="magnetic hover-lift"><span class="font-semibold text-white">Serving:</span> Clients worldwide — 100% remote</p>
					<p class="magnetic hover-lift"><span class="font-semibold text-white">Hours:</span> Mon–Sat, flexible across time zones</p>
				</div>
			</div>

			<div class="glow-border edge-glow hover-lift reveal rounded-2xl p-8 sm:p-10 card-shine">
				<ContactForm client:visible />
			</div>
		</div>
	</div>
</section>


