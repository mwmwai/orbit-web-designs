---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config";
---

<Layout
	title="Orbit Care — Hosting, Security & Support from 7,599/mo | Orbit"
	description="Orbit Care: hosting, SSL, backups, security patches, speed tuning and WhatsApp support. 7,599/mo Starter, 9,599 Business, 11,999 Master — cancel anytime."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Orbit Care</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					A site you <span class="text-gradient">never worry about.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">Hosting, SSL, daily backups, weekly security, monthly speed tuning and human WhatsApp support — the recurring work that keeps you found, trusted and paid.</p>
				<p class="mt-4 text-sm text-slate-400">Cancel anytime. Your site, domain and files stay yours — we just stop watching it.</p>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto max-w-7xl px-5">
				<div class="grid gap-6 md:grid-cols-3">
					<div class="glow-border rounded-2xl p-8">
						<h3 class="text-lg font-semibold text-white">Starter Care</h3>
						<p class="mt-2 text-3xl font-extrabold text-gradient">7,599<span class="text-sm font-normal text-slate-400">/mo</span></p>
						<p class="mt-1 text-xs text-slate-400">For Starter 29,999 sites</p>
						<ul class="mt-6 grid gap-2 text-sm text-slate-300">
							<li class="flex gap-2"><span class="text-electric">✓</span> Hosting + SSL + daily backups</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Weekly security patches</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Monthly speed check</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> WhatsApp support Mon–Sat</li>
						</ul>
						<a href={whatsappLink("Hi Orbit! I want Starter Care 7,599/mo for my site.")} target="_blank" rel="noopener noreferrer" class="mt-6 block rounded-full border border-edge bg-panel py-3 text-center font-semibold text-slate-200 hover:border-electric/60 hover:text-white">Get Starter Care</a>
					</div>
					<div class="glow-border rounded-2xl p-8 border-electric/30 bg-gradient-to-b from-electric/10 to-transparent">
						<span class="mb-3 inline-flex rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">Most popular</span>
						<h3 class="text-lg font-semibold text-white">Business Care</h3>
						<p class="mt-2 text-3xl font-extrabold text-gradient">9,599<span class="text-sm font-normal text-slate-400">/mo</span></p>
						<p class="mt-1 text-xs text-slate-400">For Business 39,999 sites</p>
						<ul class="mt-6 grid gap-2 text-sm text-slate-300">
							<li class="flex gap-2"><span class="text-electric">✓</span> Everything in Starter</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Uptime monitored (alert in minutes)</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Content updates (2 small tasks/mo)</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Priority queue</li>
						</ul>
						<a href={whatsappLink("Hi Orbit! I want Business Care 9,599/mo.")} target="_blank" rel="noopener noreferrer" class="mt-6 block rounded-full btn-gradient py-3 text-center font-semibold text-white shadow-lg shadow-electric/20">Get Business Care</a>
					</div>
					<div class="glow-border rounded-2xl p-8">
						<h3 class="text-lg font-semibold text-white">Master Care</h3>
						<p class="mt-2 text-3xl font-extrabold text-gradient">11,999<span class="text-sm font-normal text-slate-400">/mo</span></p>
						<p class="mt-1 text-xs text-slate-400">For stores, bookings & SaaS</p>
						<ul class="mt-6 grid gap-2 text-sm text-slate-300">
							<li class="flex gap-2"><span class="text-electric">✓</span> Everything in Business</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> M-Pesa / payment monitoring</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> Inventory/booking sanity checks</li>
							<li class="flex gap-2"><span class="text-electric">✓</span> 4 content tasks/mo</li>
						</ul>
						<a href={whatsappLink("Hi Orbit! I want Master Care 11,999/mo for my store.")} target="_blank" rel="noopener noreferrer" class="mt-6 block rounded-full border border-edge bg-panel py-3 text-center font-semibold text-slate-200 hover:border-electric/60 hover:text-white">Get Master Care</a>
					</div>
				</div>
				<p class="mt-6 text-center text-xs text-slate-500">DIY instead? See the 30-min/month routine in <a href="/blog/website-care-kenya" class="text-electric hover:underline">Website Care guide →</a></p>
			</div>
		</section>

		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-3xl px-5">
				<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">What you actually get</h2>
				<div class="mt-8 overflow-hidden rounded-xl border border-edge">
					<table class="w-full text-left text-sm"><thead class="bg-panel text-xs uppercase tracking-widest text-slate-400"><tr><th class="px-4 py-2">Task</th><th class="px-4 py-2">DIY</th><th class="px-4 py-2">Orbit Care</th></tr></thead>
					<tbody class="divide-y divide-edge text-slate-300"><tr><td class="px-4 py-2">Hosting + SSL + backups</td><td class="px-4 py-2">You buy/manage</td><td class="px-4 py-2 text-white">Included, daily off-site</td></tr><tr><td class="px-4 py-2">Security</td><td class="px-4 py-2">You patch</td><td class="px-4 py-2 text-white">Weekly, scanned</td></tr><tr><td class="px-4 py-2">Speed</td><td class="px-4 py-2">You test</td><td class="px-4 py-2 text-white">Monthly re-checked, tuned</td></tr><tr><td class="px-4 py-2">Support</td><td class="px-4 py-2">—</td><td class="px-4 py-2 text-white">WhatsApp, minutes, Mon–Sat</td></tr></tbody></table>
				</div>
			</div>
		</section>

		<CtaBand title="Keep it alive without thinking about it." text="One message — your site is watched, backed up and fast from 7,599/mo." />
	</main>
	<Footer />
</Layout>
