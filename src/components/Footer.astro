---
import { SITE_NAME, SITE_EMAIL, SITE_PHONE_DISPLAY, NAV_LINKS, MORE_LINKS } from "../config";

const year = new Date().getFullYear();
const TS_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<footer class="border-t border-white/5 py-16">
	<div class="mx-auto max-w-7xl px-5">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
			<div class="lg:col-span-2">
				<a href="/" class="inline-flex items-center gap-4">
					<img src="/logo-mark.webp" alt="Orbit logo" width={44} height={44} />
					<span class="leading-none">
						<span class="block bg-gradient-to-r from-slate-100 via-slate-300 to-slate-400 bg-clip-text text-xl font-black tracking-[0.3em] text-transparent">ORBIT</span>
						<span class="mt-1.5 block text-[10px] font-semibold uppercase tracking-[0.26em] text-slate-400">Web Designs &amp; Marketing</span>
					</span>
				</a>
			<p class="mt-6 max-w-sm text-sm leading-relaxed text-slate-400">
				{SITE_NAME} builds fast, secure websites and marketing that help
				businesses get found, get trusted, and get paid.
			</p>
			<form id="newsletter-form" class="mt-6 flex max-w-sm gap-2">
				<input
					id="newsletter-email"
					type="email"
					required
					maxlength="120"
					placeholder="Email for growth tips"
					aria-label="Email for growth tips"
					class="min-w-0 flex-1 rounded-full border border-edge bg-charcoal px-4 py-2.5 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-electric"
				/>
				<button type="submit" class="shrink-0 rounded-full btn-gradient px-5 py-2.5 text-sm font-semibold text-white">Join</button>
			</form>
			{TS_SITE_KEY && <div id="nl-turnstile" class="mt-3" data-sitekey={TS_SITE_KEY}></div>}
			<p id="newsletter-msg" role="status" aria-live="polite" class="mt-2 hidden text-xs text-slate-400"></p>
			<script>
				(() => {
					const form = document.getElementById("newsletter-form");
					const input = document.getElementById("newsletter-email") as HTMLInputElement | null;
					const msg = document.getElementById("newsletter-msg");
					const widget = document.getElementById("nl-turnstile");
					if (!form || !input || !msg || (form as HTMLFormElement & { dataset: DOMStringMap }).dataset.bound) return;
					(form as HTMLElement).dataset.bound = "1";
					let token = "";
					let widgetId: number | string | null = null;
					const boot = () => {
						const t = (window as unknown as { turnstile?: { render: (sel: string, opts: Record<string, unknown>) => number | string; reset: (id: number | string) => void } }).turnstile;
						if (!t || !widget || widgetId !== null) return;
						widgetId = t.render("#nl-turnstile", {
							sitekey: widget.getAttribute("data-sitekey"),
							callback: (tok: string) => { token = tok; },
							"expired-callback": () => { token = ""; },
						});
					};
					if (document.readyState === "complete") boot();
					window.addEventListener("load", boot);
					const iv = window.setInterval(() => {
						if (widgetId !== null || !(window as unknown as { turnstile?: unknown }).turnstile) return;
						boot();
						if (widgetId !== null) window.clearInterval(iv);
					}, 500);
					form.addEventListener("submit", async (e) => {
						e.preventDefault();
						const email = input.value.trim();
						if (!email) return;
						if (widget && !token) {
							msg.classList.remove("hidden");
							msg.textContent = "One quick human check first — tick the box above, then Join.";
							boot();
							return;
						}
						msg.classList.remove("hidden");
						msg.textContent = "Joining…";
						try {
							const res = await fetch("/api/supabase/submit", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ table: "newsletter", data: { email, turnstile_token: token || undefined } }),
							});
							const data = await res.json().catch(() => ({}));
							if (res.ok) {
								msg.textContent = "You're in — check your inbox for a welcome email.";
								input.value = "";
								token = "";
								const t = (window as unknown as { turnstile?: { reset: (id: number | string) => void } }).turnstile;
								if (t && widgetId !== null) t.reset(widgetId);
							} else if (res.status === 409 || data.duplicate) {
								msg.textContent = "Already subscribed — you're on the list.";
							} else {
								msg.textContent = "Couldn't save that — tap the green bubble and we'll add you on WhatsApp.";
							}
						} catch {
							msg.textContent = "Couldn't save that — tap the green bubble and we'll add you on WhatsApp.";
						}
					});
				})();
			</script>
				<a href="/contact" class="link-underline mt-6 inline-block py-1">
					Get a website quote <span aria-hidden="true">→</span>
				</a>
			</div>

			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Company</h3>
				<ul class="mt-5 grid gap-3 text-sm">
					{NAV_LINKS.map((l) => (
						<li><a href={l.href} class="text-slate-400 transition hover:text-white">{l.label}</a></li>
					))}
					<li><a href="/faq" class="text-slate-400 transition hover:text-white">FAQ</a></li>
				</ul>
			</div>

			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-stone">More</h3>
				<ul class="mt-5 grid gap-3 text-sm">
					{MORE_LINKS.map((l) => (
						<li><a href={l.href} class="text-slate-400 transition hover:text-white">{l.label}</a></li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Contact</h3>
				<ul class="mt-5 grid gap-3 text-sm text-slate-400">
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Phone / WhatsApp</span>
						<a href="tel:+254741992308" class="transition hover:text-white">{SITE_PHONE_DISPLAY}</a>
					</li>
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Email</span>
						<a href={`mailto:${SITE_EMAIL}`} class="transition hover:text-white">{SITE_EMAIL}</a>
					</li>
					<li>
						<span class="block font-mono text-xs uppercase tracking-widest text-stone">Working hours</span>
						Mon – Sat · Flexible worldwide
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-white/5 pt-6 text-xs text-slate-400 md:flex-row md:items-center">
			<p>© {year} {SITE_NAME}. All rights reserved. · Prices in KES, USD & EUR accepted.</p>
			<p class="flex flex-wrap gap-x-4 gap-y-1 text-slate-400">
				<a href="https://g.page/r/CS264QqxfOvBECE/review" target="_blank" rel="noopener noreferrer" class="transition hover:text-white"><span class="text-electric" aria-hidden="true">★</span> Review us</a>
				<a href="/blog/website-cost-kenya" class="transition hover:text-white">Pricing guide</a>
				<a href="/faq" class="transition hover:text-white">FAQ</a>
				<a href="/web-design-nairobi" class="transition hover:text-white">Nairobi</a>
				<a href="/mpesa-ecommerce-kenya" class="transition hover:text-white">M-Pesa stores</a>
				<a href="/privacy-policy" class="transition hover:text-white">Privacy</a>
				<a href="/terms-of-service" class="transition hover:text-white">Terms</a>
				<a href="/cookie-policy" class="transition hover:text-white">Cookies</a>
				<a href="/security-policy" class="transition hover:text-white">Security</a>
				<a href="/accessibility" class="transition hover:text-white">Accessibility</a>
			</p>
		</div>
	</div>
</footer>
