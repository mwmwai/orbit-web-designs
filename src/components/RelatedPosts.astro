---

<aside class="mt-16" aria-labelledby="related-heading">
	<h2 id="related-heading" class="text-xl font-bold text-white mb-4">Related guides</h2>
	<div class="grid gap-4 md:grid-cols-3">
		{related.map((p) => (
			<a href={`/blog/${p.slug}`} class="glow-border group rounded-2xl p-6 transition duration-300 hover:-translate-y-1">
				<h3 class="text-lg font-bold text-white group-hover:text-electric transition">{p.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-slate-400">{p.blurb}</p>
				<p class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-electric">Read <span aria-hidden="true">→</span></p>
			</a>
		))}
	</div>
</aside>