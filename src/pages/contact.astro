---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{ "@type": "Question", name: "How do I contact Orbit Web Designs?", acceptedAnswer: { "@type": "Answer", text: "Chat on WhatsApp (+254 741 992 308) — that's where we're fastest — or use the contact form on this page." } },
		{ "@type": "Question", name: "What information should I include in my inquiry?", acceptedAnswer: { "@type": "Answer", text: "Your business name, what you need (website, e-commerce, SaaS, etc.), your budget range, and any design preferences or examples you like." } },
		{ "@type": "Question", name: "How long does it take to get a quote?", acceptedAnswer: { "@type": "Answer", text: "You get a free quote and a clear timeline as soon as we understand your project." } },
		{ "@type": "Question", name: "Do you work with businesses outside Nairobi?", acceptedAnswer: { "@type": "Answer", text: "Yes — fully remote, serving businesses worldwide." } },
	],
};
---

<Layout
	title="Contact Us — Get a Free Quote | Orbit Web Designs & Marketing"
	description="Get a free quote for your website or marketing project. Chat with us on WhatsApp or send a message through our contact form."
>
	<Navbar />
	<main id="main">
		<Contact />
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
	<Footer />
</Layout>

