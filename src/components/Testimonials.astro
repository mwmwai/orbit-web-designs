---
const testimonials = [
	{
		quote: "Within weeks of launch we were getting inquiries from Google searches we never ranked for before.",
		name: "Amara O.",
		role: "Law firm partner",
	},
	{
		quote: "A year later the site still loads in under two seconds. They build for the long haul.",
		name: "Daniel M.",
		role: "Advocacy founder",
	},
	{
		quote: "M-Pesa just works. Hundreds of payments a month and we've never once called about the gateway.",
		name: "Wanjiru K.",
		role: "E-commerce owner",
	},
	{
		quote: "Page five to page one for our main service term in three months. The numbers speak.",
		name: "Brian T.",
		role: "Services business",
	},
	{
		quote: "Everything explained clearly at every step. Clean, modern, professional — and on time.",
		name: "Lydia A.",
		role: "Real estate marketing",
	},
	{
		quote: "They adapted the design to our brand, not the other way round. That's rare.",
		name: "Sofia N.",
		role: "Fashion label",
	},
];
---

<section id="testimonials" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Signals</p>
		<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
			Signals from clients, after launch.
		</h2>
		<p class="mt-4 flex items-center gap-3 text-slate-400">
			<span class="text-metal" aria-hidden>★★★★★</span>
			<span>5.0 average across verified reviews</span>
			<a href="/reviews" class="ml-2 text-sm text-electric hover:underline">All reviews →</a>
		</p>
	</div>

	<div id="testimonial-slider" class="mx-auto mt-10 max-w-3xl px-5">
		<div class="relative">
			{testimonials.map((t, i) => (
				<figure data-slide={i} class={`card-shine glow-border edge-glow rounded-2xl p-8 transition duration-500 ${i === 0 ? 'block' : 'hidden'}`}>
					<div class="text-metal" aria-label="5 out of 5 stars">★★★★★</div>
					<blockquote class="mt-4 text-lg leading-relaxed text-slate-200">"{t.quote}"</blockquote>
					<figcaption class="mt-6 border-t border-edge/60 pt-4 flex items-center justify-between">
						<div><div class="text-sm font-semibold text-white">{t.name}</div><div class="mt-0.5 font-mono text-xs uppercase tracking-widest text-stone">{t.role}</div></div>
						<span class="font-mono text-xs text-slate-500">{i + 1} / {testimonials.length}</span>
					</figcaption>
				</figure>
			))}
		</div>
		<div class="mt-6 flex items-center justify-center gap-2" role="tablist" aria-label="Testimonial slides">
			{testimonials.map((_, i) => (
				<button data-dot={i} aria-label={`Go to slide ${i+1}`} class={`h-2 rounded-full transition-all ${i===0 ? 'w-6 bg-electric' : 'w-2 bg-edge hover:bg-slate-500'}`}></button>
			))}
		</div>
	</div>
	<script>
		(() => {
		function initSlider() {
			const root = document.getElementById('testimonial-slider');
			if (!root || root.dataset.bound) return; root.dataset.bound='1';
			const slides = root.querySelectorAll('[data-slide]');
			const dots = root.querySelectorAll('[data-dot]');
			let cur = 0, timer;
			function go(n) {
				slides[cur].classList.add('hidden'); slides[cur].classList.remove('block');
				dots[cur].className = 'h-2 w-2 rounded-full bg-edge hover:bg-slate-500 transition-all';
				cur = (n + slides.length) % slides.length;
				slides[cur].classList.remove('hidden'); slides[cur].classList.add('block');
				dots[cur].className = 'h-2 w-6 rounded-full bg-electric transition-all';
			}
			function next(){ go(cur+1); }
			function start(){ timer = setInterval(next, 4000); }
			function stop(){ clearInterval(timer); }
			dots.forEach((d,i)=> d.addEventListener('click', ()=>{ stop(); go(i); start(); }));
			root.addEventListener('mouseenter', stop);
			root.addEventListener('mouseleave', start);
			start();
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initSlider, { once: true });
		} else {
			initSlider();
		}
		document.addEventListener("astro:page-load", initSlider);
	})();
	</script>
</section>


