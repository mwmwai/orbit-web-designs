---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import Comments from "../../components/Comments.astro";
import { whatsappLink } from "../../config";
---

<Layout
	title="Website Care in Kenya: What Keeps Your Site Alive | Orbit"
	description="Website maintenance in Kenya: Orbit Care from KES 7,599/month — hosting, security, updates and support. What happens without it, and what to demand."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides · Maintenance</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Your website needs care. <span class="text-gradient">Here's what that means.</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">A site without care rots: slow loads, hacked forms, dead plugins. Orbit Care (7,599–11,999/mo) covers hosting, security, updates and support — here's exactly what you're paying for.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<div class="grid gap-6">
				{[
					["Hosting that answers", "Fast Kenyan-friendly servers, SSL kept valid, uptime watched. When hosting dies at 2am, someone notices — that someone is us."],
					["Security patches", "Weekly updates to every dependency, malware scans, locked-down forms. Most hacked SME sites were simply never updated."],
					["Speed kept fast", "Core Web Vitals re-checked monthly. Sites slow down as content grows — we trim before Google notices."],
					["Human support", "WhatsApp us and get an answer in minutes, Mon–Sat. No tickets, no queues, no bots pretending to care."],
				].map(([t, d]) => (
					<div class="glow-border rounded-2xl p-8">
						<h2 class="text-xl font-bold text-white">{t}</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{d}</p>
					</div>
				))}
			</div>
			<p class="mt-10 leading-relaxed text-slate-400">Starter care is KES 7,599/month, Business 9,599, Master 11,999. Cancel anytime — your site stays yours, we just stop watching it.</p>
			<div class="mt-8">
				<a href={whatsappLink("Hi Orbit! I want Orbit Care for my website. What tier fits me?")} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full btn-gradient px-8 py-3.5 font-semibold text-white">Get Orbit Care</a>
			</div>
		</article>

		<Comments slug="website-care-kenya" />
		<CtaBand title="Rather just have it handled?" text="One message and your site is watched, updated and backed up — from 7,599/month." />
	</main>
	<Footer />
</Layout>
