---
const projects = [
	{
		name: "Genthub Barbershop",
		type: "Business Website + Booking",
		description:
			"A sleek booking site with gallery and M-Pesa deposit payments for a Nairobi barbershop.",
		gradient: "from-electric/40 via-electric/10 to-transparent",
		initial: "G",
	},
	{
		name: "Sokoni Fresh",
		type: "E-commerce Store",
		description:
			"Farm-to-door grocery store with M-Pesa checkout, live inventory, and delivery zones.",
		gradient: "from-neon/40 via-neon/10 to-transparent",
		initial: "S",
	},
	{
		name: "Zawadi Crafts",
		type: "Brand Page",
		description:
			"An artisan brand showcase that tripled wholesale inquiries within two months of launch.",
		gradient: "from-cyan-500/40 via-cyan-500/10 to-transparent",
		initial: "Z",
	},
];
---

<section id="work" class="border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="mb-14 max-w-xl">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Featured Projects</h2>
			<p class="mt-4 text-slate-400">
				Real results for real businesses.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			{
				projects.map((p) => (
					<article class="glow-border group overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-neon/10">
						<div class={`relative flex h-44 items-center justify-center bg-gradient-to-br ${p.gradient}`}>
							<span class="text-6xl font-black text-white/15 transition duration-300 group-hover:scale-110">{p.initial}</span>
							<span class="absolute left-4 top-4 rounded-full bg-ink/70 px-3 py-1 text-xs font-medium text-slate-300 backdrop-blur">
								{p.type}
							</span>
						</div>
						<div class="p-6">
							<h3 class="text-lg font-semibold text-white">{p.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{p.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
