---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Pricing from "../components/Pricing.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
---

<Layout>
	<Navbar client:load />
	<main id="main">
		<Hero />
		<Services />
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute left-1/2 top-0 h-[300px] w-[700px] -translate-x-1/2 rounded-full bg-electric/10 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="text-reveal mb-10 max-w-2xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Why Orbit</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Built different, on purpose.</h2>
				</div>
				<div class="grid gap-6 md:grid-cols-3">
					{[
						["Live in days", "Starter sites go live in 48–72 hours. Business in days, Master in a week or so. No month-long sagas."],
						["M-Pesa native", "Paybill, Till, cards and PayPal wired from day one — checkout in under a minute."],
						["Human on WhatsApp", "Reply in minutes, Mon–Sat. Talk to the builder, not a ticket queue."],
					].map(([t, d], i) => (
						<article data-tilt class="reveal glow-border edge-glow group relative flex flex-col rounded-2xl p-8 transition duration-300 hover:-translate-y-1.5 hover-lift magnetic" style={`transition-delay:${i * 80}ms`}>
							<span class="text-gradient text-3xl font-extrabold">0{i + 1}</span>
							<h3 class="mt-4 text-xl font-semibold text-white">{t}</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{d}</p>
						</article>
					))}
				</div>
			</div>
		</section>
		<Pricing only={["Starter", "Business", "Master"]} />
		<Process />
		<Testimonials />
		<!-- Proof: anonymized outcomes (no stock photos) -->
		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-7xl px-5">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Outcomes · anonymized</p>
				<div class="mt-8 grid gap-6 md:grid-cols-3">
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">Law firm · Nairobi</p><p class="mt-3 text-3xl font-extrabold text-white">Page 5 → 1</p><p class="mt-2 text-sm text-slate-400">Main service term in 3 months. Inquiries from searches they never ranked for before.</p></article>
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">E-commerce · M-Pesa store</p><p class="mt-3 text-3xl font-extrabold text-white">100s / month</p><p class="mt-2 text-sm text-slate-400">M-Pesa checkout never called about gateway. Stock auto-subtracts, orders ping WhatsApp.</p></article>
					<article class="glow-border rounded-2xl p-6"><p class="text-xs font-mono uppercase tracking-widest text-slate-400">Advocacy · 12 months later</p><p class="mt-3 text-3xl font-extrabold text-white">&lt;2s load</p><p class="mt-2 text-sm text-slate-400">Still under 2s after a year. Speed kept via monthly Care tuning.</p></article>
				</div>
				<p class="mt-4 text-xs text-slate-500"><a href="/cases/law-firm-nairobi" class="text-electric hover:underline">Law case →</a> · <a href="/cases/mpesa-store" class="text-electric hover:underline">M-Pesa case →</a> · <a href="/cases/advocacy-site" class="text-electric hover:underline">Speed case →</a> · <a href="/reviews" class="text-electric hover:underline">reviews →</a></p>
			</div>
		</section>
		<!-- Surfaced: SaaS — jacked -->
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/10 blur-[130px]"></div></div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="grid gap-8 lg:grid-cols-2 lg:items-center">
					<div>
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Custom SaaS Apps — KES 49,999</p>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Your idea as a real app.</h2>
						<p class="mt-4 text-slate-400">Auth, roles, onboarding, admin + user dashboards and M-Pesa — deployed, documented, handed over with 3 months support.</p>
						<div class="mt-6 flex flex-wrap gap-2">
							{["Auth & roles","Admin dashboards","M-Pesa + cards","CSV + reports"].map(t=> <span class="rounded-full border border-edge bg-charcoal px-3 py-1 font-mono text-xs text-slate-300">{t}</span>)}
						</div>
						<p class="mt-3 text-xs text-slate-500">Stay live with <a href="/care" class="text-electric hover:underline">SaaS Care 14,999/mo</a> — DB, auth & bug watch</p>
						<div class="mt-8 flex flex-wrap gap-3">
							<a href="/packages" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20 magnetic">See SaaS — 49,999</a>
							<a href="/contact" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Start yours</a>
						</div>
					</div>
					<div data-tilt class="reveal glow-border edge-glow card-shine rounded-2xl p-6 magnetic hover-lift">
						<div class="flex items-center justify-between"><span class="font-mono text-xs uppercase tracking-widest text-slate-500">orbit.app — dashboard</span><span class="h-2 w-2 rounded-full bg-electric shadow-[0_0_10px_rgba(0,200,255,0.6)]"></span></div>
						<div class="mt-6 grid grid-cols-3 gap-3">
							<div class="rounded-xl bg-charcoal p-4 border border-white/5"><p class="text-xs text-slate-400">MRR</p><p class="text-lg font-extrabold text-white">KES 84k</p><p class="text-xs text-electric">↑ 12%</p></div>
							<div class="rounded-xl bg-charcoal p-4 border border-white/5"><p class="text-xs text-slate-400">Users</p><p class="text-lg font-extrabold text-white">1,204</p><p class="text-xs text-slate-500">+38 today</p></div>
							<div class="rounded-xl bg-charcoal p-4 border border-white/5"><p class="text-xs text-slate-400">M-Pesa</p><p class="text-lg font-extrabold text-white">KES 32k</p><p class="text-xs text-slate-500">today</p></div>
						</div>
						<div class="mt-4 h-20 rounded-xl bg-gradient-to-r from-electric/20 to-neon/20 border border-electric/20 flex items-end gap-1 p-3"><div class="flex-1 rounded-t bg-electric/60" style="height:40%"></div><div class="flex-1 rounded-t bg-electric/80" style="height:65%"></div><div class="flex-1 rounded-t bg-electric" style="height:90%"></div><div class="flex-1 rounded-t bg-neon/70" style="height:55%"></div><div class="flex-1 rounded-t bg-electric/70" style="height:75%"></div></div>
					</div>
				</div>
			</div>
		</section>
		<!-- Surfaced: Graphic Design — jacked -->
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute -top-40 right-1/4 h-[380px] w-[520px] rounded-full bg-neon/10 blur-[130px]"></div></div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="grid gap-8 lg:grid-cols-2 lg:items-center">
					<div>
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Brand & Graphic Design — from 14,999</p>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Look like the price you charge.</h2>
						<p class="mt-4 text-slate-400">Logos, full kits to 24,999 — social kits, flyers, one-page guidelines. Source files included, revisions included.</p>
						<div class="mt-6 flex flex-wrap gap-2">
							{["Logos 14,999","Kits 24,999","Social + flyers","Source files"].map(t=> <span class="rounded-full border border-edge bg-charcoal px-3 py-1 font-mono text-xs text-slate-300">{t}</span>)}
						</div>
						<p class="mt-3 text-xs text-slate-500">Stay fresh with <a href="/care" class="text-electric hover:underline">Design Retainer 9,999/mo</a> — 8 creatives/mo</p>
						<div class="mt-8 flex flex-wrap gap-3">
							<a href="/packages" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white magnetic">Design from 14,999</a>
							<a href="/contact" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20">Get a quote</a>
						</div>
					</div>
					<div class="grid gap-4">
						<div data-tilt class="reveal glow-border edge-glow card-shine rounded-2xl p-6 flex items-center gap-4 magnetic hover-lift">
							<div class="h-14 w-14 rounded-xl bg-gradient-to-br from-electric to-neon flex items-center justify-center text-xl font-black text-white">O</div>
							<div><p class="font-bold text-white tracking-[0.2em]">ORBIT</p><p class="text-xs text-slate-400 tracking-[0.2em]">WEB DESIGNS & MARKETING</p><div class="mt-2 flex gap-1.5"><span class="h-3 w-3 rounded-full bg-electric"></span><span class="h-3 w-3 rounded-full bg-neon"></span><span class="h-3 w-3 rounded-full bg-white"></span><span class="h-3 w-3 rounded-full bg-charcoal border border-white/10"></span></div></div>
							<span class="ml-auto font-mono text-xs text-slate-500">A</span>
						</div>
						<div class="grid grid-cols-3 gap-4">
							<div class="glow-border rounded-xl p-3 text-center"><div class="h-16 rounded-lg bg-gradient-to-br from-electric/30 to-neon/30 border border-white/5"></div><p class="mt-2 text-xs text-slate-400">Poster</p></div>
							<div class="glow-border rounded-xl p-3 text-center"><div class="h-16 rounded-lg bg-charcoal border border-white/5 flex items-center justify-center"><span class="text-electric">◈</span></div><p class="mt-2 text-xs text-slate-400">Social kit</p></div>
							<div class="glow-border rounded-xl p-3 text-center"><div class="h-16 rounded-lg bg-white text-ink flex items-center justify-center font-black text-xs tracking-widest">B&G</div><p class="mt-2 text-xs text-slate-400">Guideline</p></div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- Surfaced: Orbit Care — jacked -->
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute left-1/2 top-0 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-electric/10 blur-[130px]"></div></div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
					<div class="max-w-xl">
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Orbit Care — custom for every product</p>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">A site you never worry about.</h2>
						<p class="mt-4 text-slate-400">Hosting, security, speed, backups and WhatsApp support — tuned per product. Website Care plus SaaS 14,999 · Dashboard 5,999 · Agent 7,999 · Design 9,999.</p>
					</div>
					<a href="/care" class="shrink-0 rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20 magnetic">See all Care →</a>
				</div>
				<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-6 magnetic hover-lift"><div class="flex items-center justify-between"><p class="text-sm font-semibold text-white">Starter Care</p><span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]"></span></div><p class="mt-2 text-2xl font-extrabold text-gradient">7,599<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="text-xs text-slate-400">For 29,999 sites</p><div class="mt-4 h-1.5 rounded-full bg-white/5 overflow-hidden"><div class="h-full w-[92%] bg-gradient-to-r from-electric to-neon"></div></div><p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">Uptime 99.9%</p></div>
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-6 border-electric/40 bg-gradient-to-b from-electric/10 to-transparent magnetic hover-lift"><div class="flex items-center justify-between"><p class="text-sm font-semibold text-white">Business Care</p><span class="rounded-full bg-electric px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest text-white">Popular</span></div><p class="mt-2 text-2xl font-extrabold text-gradient">9,599<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="text-xs text-slate-400">For 39,999 sites</p><div class="mt-4 flex gap-1"><span class="h-1.5 flex-1 rounded-full bg-electric"></span><span class="h-1.5 flex-1 rounded-full bg-electric"></span><span class="h-1.5 flex-1 rounded-full bg-white/10"></span></div><p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">2 tasks/mo included</p></div>
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-6 magnetic hover-lift"><div class="flex items-center justify-between"><p class="text-sm font-semibold text-white">Master Care</p><span class="h-2 w-2 rounded-full bg-electric"></span></div><p class="mt-2 text-2xl font-extrabold text-gradient">11,999<span class="text-sm font-normal text-slate-400">/mo</span></p><p class="text-xs text-slate-400">Stores & bookings</p><div class="mt-4 h-1.5 rounded-full bg-white/5 overflow-hidden"><div class="h-full w-[88%] bg-neon"></div></div><p class="mt-1 text-[10px] font-mono uppercase tracking-widest text-slate-500">M-Pesa watched</p></div>
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-6 magnetic hover-lift"><p class="text-sm font-semibold text-white">Custom Care</p><p class="mt-1 text-xs text-electric">SaaS 14,999 · Dash 5,999</p><p class="mt-1 text-xs text-slate-400">Agent 7,999 · Design 9,999</p><div class="mt-4 grid grid-cols-2 gap-2 text-[10px] font-mono"><span class="rounded-full bg-charcoal border border-white/5 px-2 py-1 text-center text-slate-300">SaaS</span><span class="rounded-full bg-charcoal border border-white/5 px-2 py-1 text-center text-slate-300">Dash</span><span class="rounded-full bg-charcoal border border-white/5 px-2 py-1 text-center text-slate-300">Agent</span><span class="rounded-full bg-charcoal border border-white/5 px-2 py-1 text-center text-slate-300">Design</span></div></div>
				</div>
				<p class="mt-4 text-center text-xs text-slate-500">Cancel anytime · <a href="/blog/website-care-kenya" class="text-electric hover:underline">DIY checklist →</a></p>
			</div>
		</section>
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ About</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Built hungry, based in Nairobi.</h2>
					<p class="mt-4 text-slate-400">No bloated agency, no hand-offs — you talk to the person building your site.</p>
				</div>
				<a href="/about" class="shrink-0 rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Meet Orbit</a>
			</div>
		</section>
		<section class="border-t border-white/5 py-20">
			<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center">
				<div class="max-w-xl">
					<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides</p>
					<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Learn the game. Then win it.</h2>
					<p class="mt-4 text-slate-400">7 honest, actionable guides — pricing, care, SEO, M-Pesa and WhatsApp with checklists and real numbers.</p>
				</div>
				<a href="/guides" class="shrink-0 rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Read guides</a>
			</div>
		</section>
		<!-- Surfaced: Agents + Workflows — jacked -->
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute -top-40 right-1/3 h-[380px] w-[600px] rounded-full bg-violet-500/10 blur-[130px]"></div></div>
			<div class="relative mx-auto max-w-7xl px-5">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Agents & Workflows — you pay APIs, we wire it</p>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">AI that does the work.</h2>
				<div class="mt-8 grid gap-6 lg:grid-cols-2">
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-8 flex flex-col magnetic hover-lift">
						<div class="inline-flex w-fit rounded-xl bg-gradient-to-br from-electric to-neon p-3 ring-1 ring-white/10"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round"><path d="M12 8V4H8M12 8l4-4M12 8v8m-4 4h8M9 16h6"/></svg></div>
						<h3 class="mt-5 text-xl font-semibold text-white">Custom AI Agents — 49,999</h3>
						<p class="mt-2 text-sm text-slate-400">Trained on your data — WhatsApp / site chat / email, qualifies & books, hands to human. <span class="text-slate-300">+ Agent Care 7,999/mo</span></p>
						<div class="mt-4 flex flex-wrap gap-2">{["WhatsApp","Site chat","Email","Booking"].map(t=> <span class="rounded-full border border-edge bg-charcoal px-3 py-1 font-mono text-xs text-slate-300">{t}</span> )}</div>
						<a href="/automation" class="mt-6 inline-flex w-fit rounded-full btn-gradient px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-electric/20">See agents →</a>
					</div>
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-8 flex flex-col magnetic hover-lift">
						<div class="inline-flex w-fit rounded-xl bg-gradient-to-br from-violet-500 to-electric p-3 ring-1 ring-white/10"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
						<h3 class="mt-5 text-xl font-semibold text-white">Workflow Automation — 39,999</h3>
						<p class="mt-2 text-sm text-slate-400">M-Pesa → Sheets/CRM, inquiry → WhatsApp → calendar, invoices auto. You own it.</p>
						<div class="mt-4 rounded-xl bg-charcoal border border-white/5 p-3 font-mono text-xs text-slate-400">M-Pesa <span class="text-electric">→</span> Sheets <span class="text-electric">→</span> WhatsApp <span class="text-electric">→</span> Calendar</div>
						<a href="/automation" class="mt-6 inline-flex w-fit rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 hover:border-electric/60 hover:text-white">See workflows →</a>
					</div>
				</div>
			</div>
		</section>
		<!-- Dashboards — jacked -->
		<section class="relative overflow-hidden border-t border-white/5 py-20">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute -top-40 left-1/4 h-[420px] w-[700px] rounded-full bg-neon/10 blur-[130px]"></div></div>
			<div class="relative mx-auto max-w-7xl px-5">
				<div class="grid gap-8 lg:grid-cols-2 lg:items-center">
					<div>
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Dashboards — from 19,999</p>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">Your numbers, one screen.</h2>
						<p class="mt-4 text-slate-400">Live M-Pesa, bookings and stock wired to your real data — opens on any phone. Dashboard Care 5,999/mo keeps it true.</p>
						<div class="mt-6 flex flex-wrap gap-2">{["M-Pesa feed","Bookings","Stock · CSV"].map(t=> <span class="rounded-full border border-edge bg-charcoal px-3 py-1 font-mono text-xs text-slate-300">{t}</span>)}</div>
						<a href="/dashboards" class="mt-8 inline-flex rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20 magnetic">See dashboards — 19,999 → 39,999</a>
					</div>
					<div data-tilt class="glow-border edge-glow card-shine rounded-2xl p-6 magnetic hover-lift">
						<div class="flex items-center justify-between"><p class="font-mono text-xs uppercase tracking-widest text-slate-400">Genthub — this week</p><span class="h-2 w-2 rounded-full bg-emerald-400"></span></div>
						<div class="mt-4 grid grid-cols-2 gap-3">
							<div class="rounded-xl bg-charcoal p-3 border border-white/5"><p class="text-xs text-slate-400">Revenue</p><p class="text-lg font-extrabold text-white">KES 48.5k</p></div>
							<div class="rounded-xl bg-charcoal p-3 border border-white/5"><p class="text-xs text-slate-400">Bookings</p><p class="text-lg font-extrabold text-white">132</p></div>
						</div>
						<div class="mt-4 h-16 flex items-end gap-1.5">{[40,65,90,55,75,45,80].map(h=> <div class="flex-1 rounded-t bg-gradient-to-t from-neon/40 to-electric" style={`height:${h}%`}></div>)}</div>
						<p class="mt-3 text-[10px] font-mono uppercase tracking-widest text-slate-500">M-Pesa live · no app install</p>
					</div>
				</div>
			</div>
		</section>
		<FAQ />
		<CtaBand title="Your competitors are online. Are you?" text="One message. One website. More customers. 10% off new orders ends 30 September." />
	</main>
	<FloatingActions />
	<Footer />
</Layout>

