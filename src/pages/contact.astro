---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import PageHero3D from "../components/react/PageHero3D.tsx";
---

<Layout
	title="Contact Us — Get a Free Quote | Orbit Web Designs & Marketing"
	description="Get a free quote for your website or marketing project. Chat with us on WhatsApp or send a message through our contact form — we reply within minutes."
>
	<Navbar client:load />
	<main id="main" class="page-reveal stagger">
		<section class="relative overflow-hidden border-b border-white/5">
			<PageHero3D client:load variant="contact" />
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/10 blur-[130px]"></div>
				<div class="film-grain"></div>
				<div class="vignette"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<h1 class="hero-anim max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Start a <span class="text-gradient">Conversation</span>
				</h1>
				<p class="hero-anim mt-5 max-w-2xl text-lg text-slate-400" style="animation-delay:120ms">
					Tell us what you're building. We'll reply with a clear plan, timeline, and quote — no pressure.
				</p>
			</div>
		</section>

		<Contact />
	</main>
	<Footer />
</Layout>

