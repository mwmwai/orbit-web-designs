---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";

const posts = [
	{
		href: "/blog/website-cost-kenya",
		tag: "Pricing guide",
		title: "How much does a website cost in Kenya?",
		blurb: "Market range 5k–250k, breakdown table + hidden-cost checklist. Works with any designer.",
	},
	{
		href: "/blog/website-care-kenya",
		tag: "Maintenance",
		title: "Website care in Kenya: DIY vs managed",
		blurb: "30-min/month DIY routine with free tools + what Orbit Care 7,499–13,999 actually covers.",
	},
	{
		href: "/blog/ecommerce-kenya-guide",
		tag: "E-commerce",
		title: "E-commerce in Kenya: launch checklist",
		blurb: "4 systems + margin math + pre-launch checklist. Try your fees in the calculator.",
	},
	{
		href: "/blog/seo-small-business-kenya",
		tag: "SEO",
		title: "SEO for small businesses: 30-day plan",
		blurb: "Business Profile, buyer keywords, speed and reviews — copy-paste weekly plan.",
	},
	{
		href: "/blog/best-web-designer-kenya",
		tag: "Choosing",
		title: "How to choose a web designer: scorecard",
		blurb: "Neutral 6-question scorecard + red flags — score any quote, including ours.",
	},
	{
		href: "/blog/mpesa-till-vs-paybill",
		tag: "M-Pesa",
		title: "M-Pesa Till vs Paybill: pick right once",
		blurb: "Decision tree + fee table — walk-in vs tracked money, tested with calculator.",
	},
	{
		href: "/blog/whatsapp-business-kenya",
		tag: "WhatsApp",
		title: "Turn WhatsApp into your best salesperson",
		blurb: "Profile, greeting/away, quick replies (/price) and wa.me link — copy-paste templates.",
	},
];
---

<Layout
	title="Guides — SEO, Pricing & Growth for Kenyan Businesses | Orbit"
	description="Free guides for Kenyan SMEs: website pricing, SEO basics, M-Pesa selling and growth tactics that actually work."
>
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Learn the game. <span class="text-gradient">Then win it.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					Actionable, not advertorial — checklists, fee math and templates you can use even if you don't hire us. Numbers included.
				</p>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto grid max-w-7xl gap-6 px-5 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((p) => (
					<a href={p.href} class="glow-border group rounded-2xl p-8 transition duration-300 hover:-translate-y-1.5">
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">{p.tag}</p>
						<h2 class="mt-3 text-xl font-bold text-white transition group-hover:text-electric">{p.title}</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{p.blurb}</p>
						<p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-electric">Read <span aria-hidden>→</span></p>
					</a>
				))}
			</div>
		</section>

		<CtaBand title="Rather just have it done?" text="Read the guides or hand the whole job to us — reply in minutes, Mon–Sat." />
	</main>
	<Footer />
</Layout>
