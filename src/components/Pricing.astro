---
interface Props {
	only?: string[];
}

import { whatsappLink } from "../config";

const { only } = Astro.props;

const 	allPlans = [
	{
		name: "Starter",
		price: "KES 35,999",
		usd: "≈ $277",
		eur: "≈ €255",
		care: "+ KES 7,499/mo Orbit Care",
		blurb: "5 pages that sell — live in 5 days, no excuses.",
		features: [
			"5 custom pages (Home, About, Services, Contact +1)",
			"Mobile-first — perfect on every phone",
			"WhatsApp + call buttons on every page",
			"Basic SEO + Google Business Profile done",
			"Selling copy polished for 3 pages",
			"Free domain + SSL setup",
			"Analytics + Search Console wired",
			"Live in 5 days",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Business",
		price: "KES 47,999",
		usd: "≈ $369",
		eur: "≈ €340",
		care: "+ KES 10,999/mo Orbit Care",
		blurb: "10 pages + blog & bookings — you rank, they book.",
		features: [
			"10 custom pages + blog setup",
			"Full SEO — titles, schema, sitemap, 90+ score",
			"Booking / lead capture (WhatsApp / Calendly)",
			"Copywriting for every page",
			"Free domain + hosting + email forwards",
			"Analytics + Search Console + speed tuned",
			"Loads in under 2 seconds, guaranteed",
			"Live in 1 week",
		],
		cta: "Get started",
		featured: true,
	},
	{
		name: "Master",
		price: "KES 59,999",
		usd: "≈ $462",
		eur: "≈ €425",
		care: "+ KES 13,999/mo Orbit Care",
		blurb: "15+ pages or full store — M-Pesa native, you own it.",
		features: [
			"15+ pages or full store / booking system",
			"M-Pesa Till+Paybill, cards & PayPal — native Daraja",
			"Advanced buyer SEO (product + local schema)",
			"Inventory / bookings auto-sync + low-stock alerts",
			"Everything in Business included",
			"Priority support — jump the queue",
			"Abandoned-cart + review-request automations",
			"Training + handover video — run it yourself",
			"Free domain + hosting + SSL + backups",
			"Live in 2 weeks",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Custom SaaS App",
		price: "from KES 59,999",
		usd: "≈ $462",
		eur: "≈ €425",
		blurb: "Your idea as a real app — dashboards, payments, ready to sell.",
		features: [
			"Auth, roles & onboarding flow",
			"Admin + user dashboards",
			"Business dashboard: sales, M-Pesa feed, bookings at a glance",
			"M-Pesa, card & PayPal payments",
			"Deployed, documented & handed over",
			"CSV export + business reports",
			"Training so you're never stuck",
			"Free domain + SSL setup",
			"3 months of support",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Graphic Design",
		price: "KES 17,999+",
		usd: "≈ $138+",
		eur: "≈ €127+",
		blurb: "Logos to full brand kits — 17,999 to 29,999, you own it.",
		features: [
			"Logos from KES 17,999 — 3 concepts, unlimited polish",
			"Social kits that actually match your site",
			"Full brand identity up to KES 29,999",
			"Marketing creatives & flyers that convert",
			"Source files + brand guideline sheet",
			"Print-ready + social-ready exports",
			"Fast turnaround, revisions included",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Custom AI Agent",
		price: "KES 59,999",
		usd: "≈ $462",
		eur: "≈ €425",
		blurb: "Trained on YOUR business — replies in seconds, books while you sleep.",
		features: [
			"WhatsApp / site chat / email — one brain",
			"Lead qualification + booking on autopilot",
			"Human handover — never loses a hot lead",
			"30 days tuning + hallucination guards",
			"Your API keys, you own it forever",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Workflow Automation",
		price: "KES 47,999",
		usd: "≈ $369",
		eur: "≈ €340",
		blurb: "Per workflow — manual work, gone for good.",
		features: [
			"M-Pesa → Sheets / CRM — no copy-paste",
			"Inquiry → WhatsApp → calendar — auto",
			"Invoices & receipts auto-sent",
			"You own it, documented + handover",
			"Bundle 3+ workflows = 15% off",
		],
		cta: "Get started",
		featured: false,
	},
	{
		name: "Business Dashboard",
		price: "KES 32,999",
		usd: "≈ $254",
		eur: "≈ €234",
		blurb: "Your money, bookings, stock — one screen, no guessing.",
		features: [
			"Live sales, M-Pesa feed, bookings",
			"Password login for staff",
			"Charts, filters, CSV export",
			"Works on any phone, offline-friendly",
			"3 data sources wired + alerts",
		],
		cta: "Get started",
		featured: false,
	},
];

function linkForPlan(p: typeof allPlans[number]) {
	if (["Starter","Business","Master"].includes(p.name)) return whatsappLink(`Hi Orbit! I want ${p.name} website (${p.price}) — my business is...`);
	if (p.name === "Custom AI Agent") return "/automation";
	if (p.name === "Workflow Automation") return "/automation";
	if (p.name === "Custom SaaS App") return "/saas";
	if (p.name === "Business Dashboard") return "/dashboards";
	if (p.name === "Graphic Design") return "/design";
	return "/contact";
}

const plans = only?.length ? allPlans.filter((p) => only.includes(p.name)) : allPlans;
---

<section id="pricing" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Pricelist</p>
			<p class="mt-3 text-sm text-slate-400">★★★★★ Trusted by 50+ Kenyan businesses — salons, shops, restaurants.</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Straight-line pricing.
			</h2>
			<p class="mt-4 max-w-xl text-slate-400">
				{plans.length === 3 ? "Three packages" : "Five packages"} built for growing businesses — flexible payment, delivered fast.
			</p>
		</div>

		<div class="grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				plans.map((p, i) => (
					<article class="reveal" style={`transition-delay:${i * 70}ms`}>
						<div
							data-tilt
							class={`relative flex h-full flex-col rounded-2xl p-8 card-shine edge-glow hover-lift magnetic ${
								p.featured
									? "border border-electric/50 bg-gradient-to-b from-electric/10 to-transparent shadow-2xl shadow-electric/10"
									: "glow-border"
							}`}
						>
							{p.featured && (
								<span class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">
									Most popular
								</span>
							)}
							<h3 class="text-lg font-semibold text-white">{p.name}</h3>
							<p class="mt-2 text-sm text-slate-400">{p.blurb}</p>
							<p class="mt-6">
								<span class="text-gradient text-4xl font-extrabold tracking-tight">{p.price}</span>
								<span class="mt-2 block text-sm font-semibold text-slate-300">{p.usd} <span class="text-stone">·</span> {p.eur}</span>
								{p.care && <span class="mt-1 block text-xs font-medium text-electric">{p.care}</span>}
							</p>
							<ul class="mt-8 grid flex-1 content-start gap-3">
								{p.features.map((f) => (
									<li class="flex items-start gap-3 text-sm text-slate-300">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0">
											<path d="M20 6L9 17l-5-5" />
										</svg>
										{f}
									</li>
								))}
							</ul>
							{p.name === "Master" && (
								<a href="/mpesa-fee-calculator" class="mt-4 inline-flex text-xs font-medium text-electric hover:underline">→ Price your margins with M-Pesa fee calculator</a>
							)}
							<a
								href={linkForPlan(p)}
								target={linkForPlan(p).startsWith("https://wa.me") ? "_blank" : undefined}
								rel={linkForPlan(p).startsWith("https://wa.me") ? "noopener noreferrer" : undefined}
								class={`promo-cta mt-8 block rounded-full py-3 text-center font-semibold transition ${
									p.featured
										? "btn-gradient text-white shadow-lg shadow-electric/25 hover:-translate-y-0.5"
										: "border border-edge bg-panel text-slate-200 hover:border-electric/60 hover:text-white"
								}`}
							>
								{p.cta}
							</a>
						</div>
					</article>
				))
			}
		</div>

		<p class="reveal mt-8 text-sm text-slate-500">
			Need something different? <a href="/contact" class="text-electric hover:underline">Ask for a custom quote</a> — <a href="/mpesa-fee-calculator" class="text-electric hover:underline">M-Pesa calculator</a> · <a href="/blog/website-care-kenya" class="text-electric hover:underline">Care plans</a> · <a href="/automation" class="text-electric hover:underline">Agents & Workflows</a>
		</p>
	</div>

</section>

<section id="payments" class="border-t border-white/5 pb-8 pt-4">
	<div class="mx-auto max-w-7xl px-5">
		<div class="glow-border reveal flex flex-col items-start gap-6 rounded-2xl px-8 py-8 md:flex-row md:items-center md:justify-between">
			<div>
				<h3 class="text-lg font-semibold text-white">Payments, handled quietly.</h3>
				<p class="mt-1 max-w-md text-sm text-slate-400">M-Pesa, cards and PayPal — secure, verified, no drama.</p>
			</div>
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest">
				<span class="border border-edge px-4 py-2 text-stone">M-Pesa</span>
				<span class="border border-edge px-4 py-2 text-stone">Card</span>
				<span class="border border-edge px-4 py-2 text-stone">PayPal</span>
			</div>
		</div>
	</div>
</section>


