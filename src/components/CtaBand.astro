---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";

interface Props {
	title?: string;
	text?: string;
}

const {
	title = "Ready to grow your business online?",
	text = "Get a free quote today — we reply within minutes on WhatsApp.",
} = Astro.props;
---

<section class="border-t border-white/5 py-20">
	<div class="reveal glass hover-lift relative mx-auto flex max-w-7xl flex-col items-start gap-8 rounded-2xl px-8 py-10 md:flex-row md:px-12">
		<div class="relative flex-1 min-w-0">
			<h2 class="display-md text-white">{title}</h2>
			<p class="mt-3 max-w-lg text-slate-400 text-wrap-pretty">{text}</p>
		</div>
		<div class="relative flex flex-wrap gap-3 shrink-0">
			<a
				href={whatsappLink(DEFAULT_WA_MESSAGE)}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-gradient rounded-full px-6 py-3 font-semibold text-white press"
			>
				Get a Free Quote
			</a>
			<a
				href="/contact"
				class="rounded-full border border-edge/50 bg-panel/50 px-6 py-3 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white press focus-ring"
			>
				Contact Us
			</a>
		</div>
	</div>
</section>



