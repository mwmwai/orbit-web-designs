---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { SITE_URL, SITE_NAME } from "../../config";
import rss from "@astrojs/rss";

const posts = [
	{
		slug: "how-long-does-a-website-take",
		tag: "Timelines",
		title: "How long does a website take? Real timelines",
		blurb: "DIY weekend to 3-month agency — realistic ranges + the delay checklist that keeps projects on date.",
		date: "2026-10-14",
		updated: "2026-10-14",
	},
	{
		slug: "website-cost-kenya",
		tag: "Pricing guide",
		title: "How much does a website cost in Kenya?",
		blurb: "Market range 5k–250k, breakdown table + hidden-cost checklist. Works with any designer.",
		date: "2026-09-11",
		updated: "2026-10-03",
	},
	{
		slug: "website-care-kenya",
		tag: "Maintenance",
		title: "Website care in Kenya: DIY vs managed",
		blurb: "30-min/month DIY routine with free tools + what Orbit Care 4,999–9,999 actually covers.",
		date: "2026-09-18",
		updated: "2026-10-03",
	},
	{
		slug: "ecommerce-kenya-guide",
		tag: "E-commerce",
		title: "E-commerce in Kenya: launch checklist",
		blurb: "4 systems + margin math + pre-launch checklist. Try your fees in the calculator.",
		date: "2026-09-25",
		updated: "2026-10-03",
	},
	{
		slug: "seo-small-business-kenya",
		tag: "SEO",
		title: "SEO for small businesses: 30-day plan",
		blurb: "Business Profile, buyer keywords, speed and reviews — copy-paste weekly plan.",
		date: "2026-10-02",
		updated: "2026-10-03",
	},
	{
		slug: "best-web-designer-kenya",
		tag: "Choosing",
		title: "How to choose a web designer: scorecard",
		blurb: "Neutral 6-question scorecard + red flags — score any quote, including ours.",
		date: "2026-09-11",
		updated: "2026-10-03",
	},
	{
		slug: "mpesa-till-vs-paybill",
		tag: "M-Pesa",
		title: "M-Pesa Till vs Paybill: pick right once",
		blurb: "Decision tree + fee table — walk-in vs tracked money, tested with calculator.",
		date: "2026-09-20",
		updated: "2026-10-03",
	},
	{
		slug: "whatsapp-business-kenya",
		tag: "WhatsApp",
		title: "Turn WhatsApp into your best salesperson",
		blurb: "Profile, greeting/away, quick replies (/price) and wa.me link — copy-paste templates.",
		date: "2026-10-01",
		updated: "2026-10-03",
	},
	{
		slug: "web-design-kenya-guide",
		tag: "Pillar Guide",
		title: "Web Design Kenya: The Complete Guide",
		blurb: "3000+ word definitive guide: pricing, process, M-Pesa, SEO, and how to pick a designer.",
		date: "2026-09-28",
		updated: "2026-10-03",
	},
	{
		slug: "choose-web-designer-kenya",
		tag: "Buyer's Guide",
		title: "How to Choose a Web Designer in Kenya",
		blurb: "Decision framework with scoring rubric — budget, timeline, M-Pesa, ownership, support.",
		date: "2026-09-15",
		updated: "2026-10-03",
	},
	{
		slug: "orbit-vs-competitors",
		tag: "Comparison",
		title: "Orbit vs Competitors: Honest Comparison",
		blurb: "Head-to-head vs freelancers, agencies, DIY — on price, speed, M-Pesa, ownership, support.",
		date: "2026-10-04",
		updated: "2026-10-04",
	},
	{
		slug: "mpesa-daraja-website-kenya",
		tag: "M-Pesa",
		title: "M-Pesa Daraja on Your Site: Till + Paybill + Cards",
		blurb: "STK flow, fees and limits, setup timeline — Till vs Paybill vs cards, how it works.",
		date: "2026-09-22",
		updated: "2026-10-03",
	},
	{
		slug: "business-not-showing-google-maps-kenya",
		tag: "Local SEO",
		title: "Why Your Business Isn't on Google Maps",
		blurb: "1-day diagnostic: claim, verify, category, duplicates — plus the website fix that holds rankings.",
		date: "2026-10-05",
		updated: "2026-10-05",
	},
];

const blogLd = {
	"@context": "https://schema.org",
	"@type": "Blog",
	"@id": `${SITE_URL}/blog/#blog`,
	name: `${SITE_NAME} Guides`,
	url: `${SITE_URL}/blog/`,
	description: "Free guides for Kenyan SMEs: website pricing, SEO basics, M-Pesa selling and growth tactics that actually work.",
	inLanguage: "en-KE",
	blogPost: posts.map((p) => ({
		"@type": "BlogPosting",
		"@id": `${SITE_URL}/blog/${p.slug}#blogpost`,
		url: `${SITE_URL}/blog/${p.slug}`,
		headline: p.title,
		datePublished: p.date,
		dateModified: p.updated,
	})),
	publisher: {
		"@type": "Organization",
		name: SITE_NAME,
		url: SITE_URL,
		logo: { "@type": "ImageObject", url: `${SITE_URL}/logo.webp` },
	},
};

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{ "@type": "Question", name: "What guides does Orbit Web Designs offer?", acceptedAnswer: { "@type": "Answer", text: "Free guides covering website pricing, SEO for small businesses, e-commerce launch, M-Pesa integration, WhatsApp Business, website care, and how to choose a web designer." } },
		{ "@type": "Question", name: "Are the guides really free?", acceptedAnswer: { "@type": "Answer", text: "Yes. All guides are free to read. They include checklists, templates and real numbers you can use even if you don't hire us." } },
		{ "@type": "Question", name: "What is the best guide for a beginner?", acceptedAnswer: { "@type": "Answer", text: "Start with the Web Design Kenya Complete Guide — it covers pricing, process, M-Pesa, SEO and how to pick a designer." } },
		{ "@type": "Question", name: "Do I need technical skills to use the guides?", acceptedAnswer: { "@type": "Answer", text: "No. The guides are written for business owners, not developers. Step-by-step checklists and copy-paste templates included." } },
	],
};

const breadcrumbs = [
	{ name: "Home", url: "/" },
	{ name: "Guides", url: "/blog/" },
];
---

<Layout
	title="Guides — SEO, Pricing & Growth for Kenyan Businesses | Orbit"
	description="Free guides for Kenyan SMEs: website pricing, SEO basics, M-Pesa selling and growth tactics that actually work."
	breadcrumbs={breadcrumbs}
>
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Learn the game. <span class="text-gradient">Then win it.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					Actionable, not advertorial — checklists, fee math and templates you can use even if you don't hire us. Numbers included.
				</p>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto grid max-w-7xl gap-6 px-5 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((p) => (
					<a href={`/blog/${p.slug}`} class="glow-border group rounded-2xl p-8 transition duration-300 hover:-translate-y-1.5">
						<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">{p.tag}</p>
						<h2 class="mt-3 text-xl font-bold text-white transition group-hover:text-electric">{p.title}</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{p.blurb}</p>
						<time class="mt-3 block text-xs text-slate-500" dateTime={p.updated}>Updated {new Date(p.updated).toLocaleDateString("en-KE", { year: "numeric", month: "long", day: "numeric" })}</time>
						<p class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-electric">Read <span aria-hidden="true">→</span></p>
					</a>
				))}
			</div>
		</section>

		<CtaBand title="Rather just have it done?" text="Read the guides or hand the whole job to us." />
		<RelatedPosts currentSlug="index" />
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(blogLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
	<Footer />
</Layout>