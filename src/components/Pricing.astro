---
const plans = [
	{
		name: "Basic",
		price: "KES 15,000",
		blurb: "A focused landing — for portfolios and local profiles.",
		features: ["One high-converting page", "Responsive + WhatsApp", "Basic SEO", "5-day delivery", "1 month support"],
		cta: "Start with Basic",
		featured: false,
	},
	{
		name: "Business",
		price: "KES 25,000",
		blurb: "A complete site — custom layouts and room to grow.",
		features: ["Up to 6 pages", "Custom layouts", "Integrations", "Advanced SEO", "10–14 days", "3 months support"],
		cta: "Choose Business",
		featured: true,
	},
	{
		name: "Commerce",
		price: "KES 35,000+",
		blurb: "A store that sells — payments and inventory, handled.",
		features: ["Full store", "M-Pesa + cards", "Inventory", "WhatsApp orders", "3–4 weeks", "6 months support"],
		cta: "Launch Commerce",
		featured: false,
	},
];
---

<section id="pricing" class="border-t border-edge/40 py-28 md:py-36">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="reveal mb-16 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Packages</p>
			<h2 class="mt-4 font-display text-3xl leading-none tracking-tight text-cream md:text-4xl">Honest pricing. <span class="italic font-light text-metal">No surprises.</span></h2>
			<p class="mt-6 max-w-lg leading-relaxed text-stone">One-time. No retainers you didn't ask for.</p>
		</div>

		<div class="grid items-stretch gap-6 lg:grid-cols-3 lg:gap-8">
			{
				plans.map((p, i) => (
					<article class="reveal" style={`transition-delay:${i * 70}ms`}>
						<div
							data-tilt
							class={`flex h-full flex-col border p-8 md:p-10 ${p.featured ? "border-metal/40 bg-panel" : "border-edge bg-panel/60"}`}
						>
							{p.featured && <span class="font-mono text-xs uppercase tracking-widest text-metal">Most chosen</span>}
							<h3 class="mt-3 font-display text-xl text-cream">{p.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-stone">{p.blurb}</p>
							<p class="mt-8">
								<span class="font-display text-3xl tracking-tight text-cream">{p.price}</span>
								<span class="ml-2 font-mono text-xs uppercase tracking-widest text-stone">one-time</span>
							</p>
							<ul class="mt-8 grid flex-1 content-start gap-3">
								{p.features.map((f) => (
									<li class="flex items-start gap-3 font-mono text-xs uppercase tracking-widest text-stone">
										<span class="mt-1 h-px w-3 shrink-0 bg-metal/60"></span>
										{f}
									</li>
								))}
							</ul>
							<a href="/contact" class={p.featured ? "link-underline mt-10" : "link-underline mt-10 opacity-80 hover:opacity-100"}>
								{p.cta} <span aria-hidden>→</span>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<section id="payments" class="border-t border-edge/40 py-12">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="reveal flex flex-col items-start gap-6 border border-edge bg-panel px-8 py-8 md:flex-row md:items-center md:justify-between">
			<div>
				<h3 class="font-display text-lg text-cream">Payments, handled quietly.</h3>
				<p class="mt-2 max-w-md text-sm leading-relaxed text-stone">M-Pesa, cards, and PayPal — secure, verified. No drama.</p>
			</div>
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest">
				<span class="border border-edge px-4 py-2 text-stone">M-Pesa</span>
				<span class="border border-edge px-4 py-2 text-stone">Card</span>
				<span class="border border-edge px-4 py-2 text-stone">PayPal</span>
			</div>
		</div>
	</div>
</section>
