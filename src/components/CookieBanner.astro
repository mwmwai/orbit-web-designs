---
---

<div id="cookie-banner" class="fixed bottom-0 inset-x-0 z-[100] hidden translate-y-full border-t border-white/10 bg-ink/95 backdrop-blur-md transition-transform duration-500 ease-out">
	<div class="mx-auto max-w-7xl px-5 py-3 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
		<p class="text-xs text-slate-400">Cookies for analytics only. <a href="/cookie-policy" class="text-electric hover:underline">Policy</a> · <a href="/privacy-policy" class="text-electric hover:underline">Privacy</a></p>
		<div class="flex gap-2 shrink-0">
			<button id="cookie-accept" class="rounded-full btn-gradient px-5 py-1.5 text-xs font-semibold text-white">Accept</button>
			<button id="cookie-decline" class="rounded-full border border-edge bg-panel px-5 py-1.5 text-xs font-semibold text-slate-200">Decline</button>
		</div>
	</div>
</div>
<script>
	(() => {
		const k = "orbit_cookie_consent";
		const banner = document.getElementById("cookie-banner");
		if (!banner || banner.dataset.bound) return;
		banner.dataset.bound = "1";
		const consent = localStorage.getItem(k);
		// Always show on every page load (3s after settle), per site owner.
		// Choice still saves, but the banner returns each visit.
		setTimeout(() => {
			banner.classList.remove("hidden");
			requestAnimationFrame(() => requestAnimationFrame(() => {
				banner.classList.remove("translate-y-full");
			}));
		}, 3000);
		if (consent === "accepted") (window as any).orbitAnalyticsOK = true;
		const dismiss = () => {
			banner.classList.add("translate-y-full");
			setTimeout(() => banner.classList.add("hidden"), 500);
		};
		document.getElementById("cookie-accept")?.addEventListener("click", () => {
			localStorage.setItem(k, "accepted");
			document.cookie = "orbit_cookie_consent=accepted; path=/; max-age=31536000; SameSite=Lax";
			(window as any).orbitAnalyticsOK = true;
			dismiss();
			// Load GA if not already loaded
			if (import.meta.env.PUBLIC_GA_ID && !(window as any).gtag) {
				const script = document.createElement("script");
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`;
				document.head.appendChild(script);
				window.dataLayer = window.dataLayer || [];
				function gtag() { dataLayer.push(arguments); }
				(window as any).gtag = gtag;
				gtag('js', new Date());
				gtag('config', import.meta.env.PUBLIC_GA_ID, { anonymize_ip: true });
			}
		});
		document.getElementById("cookie-decline")?.addEventListener("click", () => {
			localStorage.setItem(k, "declined");
			document.cookie = "orbit_cookie_consent=declined; path=/; max-age=31536000; SameSite=Lax";
			dismiss();
		});
	})();
</script>
