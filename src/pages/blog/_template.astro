function getRelated(currentSlug: string, limit = 3) {
	return posts.filter((p) => p.slug !== currentSlug).slice(0, limit);
}

const breadcrumbs = [
	{ name: "Home", url: "/" },
	{ name: "Guides", url: "/blog/" },
];

const speakableLd = {
	"@context": "https://schema.org",
	"@type": "SpeakableSpecification",
	cssSelector: ["article h1", "article h2", "article p:first-of-type"],
};
---

<Layout
	title="Blog Post Template — SEO Meta"
	description=""
	breadcrumbs={breadcrumbs}
>
	<script type="application/ld+json" set:html={JSON.stringify(speakableLd)} />
	<Navbar />
	<BreadcrumbSchema items={breadcrumbs} />
	<main id="main">
		<article>
			{/* Template — replace with actual post content */}
		</article>
