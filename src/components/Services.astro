---
const services = [
	{
		icon: "M8 6l-4 6 4 6M16 6l4 6-4 6M13 4l-2 16",
		num: "01",
		title: "Web Design & Development",
		description: "Landing pages, business sites, and custom web apps — built quiet, fast, and for conversion.",
		tags: ["Landing pages", "Business sites", "Custom apps"],
	},
	{
		icon: "M3 11l18-7-7 18-2.5-7.5zM14 12l7-8",
		num: "02",
		title: "Digital Marketing",
		description: "Measured strategies that grow your audience and keep you visible to the right people.",
		tags: ["Social", "SEO", "Email"],
	},
	{
		icon: "M3 6h18l-1.5 9h-15zM6 6V4h12v2M9 20a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z",
		num: "03",
		title: "E-commerce & Custom",
		description: "Stores and tailored features for how you sell — payments, inventory, and beyond.",
		tags: ["Stores", "Payments", "Integrations"],
	},
];
---

<section id="services" class="border-t border-edge/40 py-28 md:py-36">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="reveal mb-16 max-w-2xl md:mb-20">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-stone">What we do</p>
			<h2 class="mt-4 font-display text-3xl leading-none tracking-tight text-cream md:text-4xl">Focus. Craft. <span class="italic font-light text-metal">Restraint.</span></h2>
			<p class="mt-6 max-w-lg leading-relaxed text-stone">
				End-to-end services, delivered with space to breathe.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3 md:gap-8">
			{
				services.map((s, i) => (
					<article
						class="reveal group relative border border-edge bg-panel p-8 transition duration-500 hover:border-metal/30 md:p-10"
						style={`transition-delay:${i * 80}ms`}
						data-tilt
					>
						<div class="font-mono text-xs tracking-widest text-metal">{s.num}</div>
						<div class="mt-6 inline-flex h-10 w-10 items-center justify-center border border-edge text-stone transition group-hover:border-metal/30 group-hover:text-cream">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
								<path d={s.icon} />
							</svg>
						</div>
						<h3 class="mt-8 font-display text-xl leading-tight text-cream">{s.title}</h3>
						<p class="mt-3 text-sm leading-relaxed text-stone">{s.description}</p>
						<div class="mt-8 flex flex-wrap gap-2">
							{s.tags.map((t) => (
								<span class="border border-edge px-2.5 py-1 font-mono text-xs uppercase tracking-widest text-stone">{t}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
