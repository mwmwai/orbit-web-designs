---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";

const services = [
	{
		title: "Web Design & Development",
		description:
			"From single landing pages to full custom web applications — every build is fast, mobile-first, and designed to convert visitors into customers.",
		points: [
			"Landing pages that convert",
			"Multi-page business websites",
			"Custom web apps & dashboards",
			"Website redesigns & speed optimization",
		],
		image:
			"https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=60&w=800&auto=format&fit=crop",
		alt: "Laptop showing code in a dark workspace",
	},
	{
		title: "Digital Marketing",
		description:
			"Targeted online marketing strategies that grow your customer base, boost visibility, and turn attention into revenue.",
		points: [
			"Social media advertising",
			"Search engine optimization (SEO)",
			"Google Business Profile setup",
			"Email campaigns & remarketing",
		],
		image:
			"https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=60&w=800&auto=format&fit=crop",
		alt: "Analytics dashboard on a laptop screen",
	},
	{
		title: "E-commerce & Custom Features",
		description:
			"Sell online with a store built around how you actually work — payments, inventory, and tailored features included.",
		points: [
			"Full online stores",
			"M-Pesa & card payment integration",
			"Product & inventory management",
			"Booking systems & custom portals",
		],
		image:
			"https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?q=60&w=800&auto=format&fit=crop",
		alt: "Customer paying by card at checkout",
	},
	{
		title: "Custom SaaS App Development",
		description:
			"Your idea as a real app: auth, dashboards, M-Pesa payments — deployed, documented and ready to sell.",
		points: [
			"Auth, roles & onboarding",
			"Admin + user dashboards",
			"Business dashboard wired to their sales & bookings",
			"M-Pesa, card & PayPal payments",
			"Deployed & handed over with training",
		],
		image:
			"https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?q=60&w=800&auto=format&fit=crop",
		alt: "Hand holding a smartphone showing a mobile app",
	},
	{
		title: "Graphic Design",
		description:
			"Logos, brand kits and marketing creatives — from single logos to full identity systems.",
		points: [
			"Custom logos",
			"Social media kits",
			"Full brand identity systems",
			"Flyers & marketing creatives",
		],
		image:
			"https://images.unsplash.com/photo-1561070791-2526d30994b5?q=60&w=800&auto=format&fit=crop",
		alt: "Designer workspace with color swatches and sketches",
	},
	{
		title: "Custom AI Agent",
		description:
			"A tireless teammate that lives inside your Workplace: answers instantly, qualifies leads, books jobs — then hands the hot ones to you.",
		points: [
			"Replies in seconds, day and night",
			"Qualifies leads & books jobs",
			"Hands hot leads to you",
			"Tuned on your business for a month",
		],
		image:
			"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=60&w=800&auto=format&fit=crop",
		alt: "Person chatting with customers on phone and laptop",
	},
	{
		title: "Workflow Automation",
		description:
			"Kill the copy-paste: payments log themselves, inquiries book themselves, receipts send themselves.",
		points: [
			"M-Pesa → records, automatically",
			"Inquiry → WhatsApp → calendar",
			"Receipts sent without lifting a finger",
			"Documented so staff can run it",
		],
		image:
			"https://images.unsplash.com/photo-1518770660439-4636190af475?q=60&w=800&auto=format&fit=crop",
		alt: "Close-up of a circuit board powering automation",
	},
	{
		title: "Business Dashboard",
		description:
			"Your whole business on one screen: live sales, M-Pesa till feed, bookings — open it on any phone.",
		points: [
			"Live charts that move with your money",
			"M-Pesa till feed + low-stock alerts",
			"Staff logins with roles",
			"No app install — just a link",
		],
		image:
			"https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=60&w=800&auto=format&fit=crop",
		alt: "Professional analytics dashboard with charts on a monitor",
	},
];

const steps = [
	["Discover", "We learn your business, goals, and what success looks like."],
	["Design", "You get a modern mockup for approval before we write code."],
	["Build", "Fast, responsive development with weekly progress updates."],
	["Launch & Grow", "We deploy, monitor, and help you market it."],
];
---

<Layout
	title="Services — Web Design, Digital Marketing & E-commerce | Orbit Web Designs & Marketing"
	description="Custom web design and development, targeted digital marketing, and e-commerce stores with payment integrations. Fast, mobile-first, built to convert."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<h1 class="hero-anim max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Services that <span class="text-gradient">move the needle.</span>
				</h1>
				<p class="hero-anim mt-5 max-w-2xl text-lg text-slate-400" style="animation-delay:120ms">
					Everything you need to launch online and keep growing — under one roof.
				</p>
			</div>
		</section>

		{
			services.map((s, i) => (
				<section class="border-b border-white/5 py-20">
					<div class={`mx-auto grid max-w-7xl items-center gap-12 px-5 lg:grid-cols-2 ${i % 2 === 1 ? "" : ""}`}>
						<div class={`reveal ${i % 2 === 1 ? "lg:order-2" : ""}`}>
							<span class="text-sm font-bold uppercase tracking-[0.25em] text-electric">
								0{i + 1}
							</span>
							<h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-3xl">{s.title}</h2>
							<p class="mt-4 leading-relaxed text-slate-400">{s.description}</p>
							<ul class="mt-6 grid gap-3">
								{s.points.map((p) => (
									<li class="flex items-start gap-3 text-sm text-slate-300">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
											<path d="M20 6L9 17l-5-5" />
										</svg>
										{p}
									</li>
								))}
							</ul>
						</div>
						<div class={`reveal overflow-hidden rounded-2xl glow-border ${i % 2 === 1 ? "lg:order-1" : ""}`} style={`transition-delay:120ms`}>
							<img src={s.image} alt={s.alt} loading="lazy" decoding="async" width="1000" height="600" class="h-72 w-full object-cover transition duration-500 hover:scale-105 lg:h-96" />
						</div>
					</div>
				</section>
			))
		}

		<section class="py-20">
			<div class="mx-auto max-w-7xl px-5">
				<h2 class="reveal text-2xl font-bold tracking-tight text-white sm:text-3xl">How we work</h2>
				<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						steps.map(([title, text], i) => (
							<article class="reveal glow-border rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
								<span class="text-gradient text-3xl font-extrabold">{i + 1}</span>
								<h3 class="mt-3 font-semibold text-white">{title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-slate-400">{text}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-5">
				<span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Keep exploring:</span>
				<a href="/about" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">About Orbit</a>
				<a href="/guides" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Guides</a>
				<a href="/faq" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">FAQ</a>
				<a href="/reviews" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Reviews</a>
			</div>
		</section>

		<CtaBand title="Have a project in mind?" text="Tell us what you need — we'll send a free quote and timeline within hours." />
	</main>
	<Footer />
</Layout>
