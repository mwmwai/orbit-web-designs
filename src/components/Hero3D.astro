---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<section id="top" class="relative overflow-hidden">
	<div class="absolute inset-0" aria-hidden="true">
		<canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
		<div class="absolute inset-0 bg-gradient-to-b from-ink/90 via-ink/70 to-ink/95" aria-hidden="true"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 pb-16 pt-16 md:px-5 md:pb-24 md:pt-24 lg:pt-36">
		<p class="hero-anim mb-6 inline-flex items-center gap-2 rounded-full border border-edge bg-panel/50 px-4 py-1.5 text-xs font-medium text-slate-300" style="animation-delay:0ms">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-electric opacity-60"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-electric"></span>
			</span>
			Now boarding — limited slots
		</p>

		<h1 class="hero-anim display-xl max-w-3xl font-extrabold text-white text-wrap-balance" style="animation-delay:100ms">
			<span class="word-reveal" style="--i:0">We</span>
			<span class="word-reveal" style="--i:1">Build</span>
			<span class="word-reveal" style="--i:2">High-Performance</span>
			<span class="word-reveal" style="--i:3">Websites</span>
			<span class="word-reveal text-gradient" style="--i:4">&&nbsp;Drive</span>
			<span class="word-reveal text-gradient" style="--i:5">Real</span>
			<span class="word-reveal text-gradient" style="--i:6">Growth.</span>
		</h1>

		<p class="hero-anim mt-6 max-w-2xl text-lg leading-relaxed text-slate-400" style="animation-delay:250ms">
			High-performance websites built to convert visitors into customers — fast, reliable, and M-Pesa ready.
		</p>

		<div class="hero-anim mt-8 flex flex-col sm:flex-row gap-4" style="animation-delay:350ms">
			<a
				href={whatsappLink(DEFAULT_WA_MESSAGE)}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full btn-gradient px-6 py-3.5 font-semibold text-white shadow-xl shadow-electric/30 hover:-translate-y-0.5 hover:shadow-electric/50 magnetic ripple w-full sm:w-auto text-center"
			>
				Get customers this week — chat now
			</a>
			<a
				href="/packages"
				class="rounded-full border border-edge bg-panel/50 px-6 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white magnetic ripple w-full sm:w-auto text-center"
			>
				View pricing
			</a>
		</div>

		<dl class="hero-anim mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4" style="animation-delay:450ms">
			{
				[
					["50+", "Websites shipped"],
					["25+", "M-Pesa stores"],
					["10+", "Industries"],
					["15min", "Avg reply time"],
				].map(([value, label]) => (
					<div data-tilt class="glass hover-lift rounded-xl px-4 py-4 transition duration-300 press">
						<dt class="text-gradient counter-num text-xl font-extrabold sm:text-2xl" data-counter>{value}</dt>
						<dd class="mt-1 text-xs sm:text-sm text-slate-400">{label}</dd>
					</div>
				))
			}
		</dl>

		<div class="hero-anim mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4" style="animation-delay:550ms">
			{
				[["75", "Performance"], ["100", "Best Practices"], ["100", "SEO"], ["95+", "PageSpeed"]].map(([v, l]) => (
					<div class="glass px-3 py-2 text-center rounded-lg">
						<p class="text-gradient text-lg font-extrabold sm:text-xl">{v}</p>
						<p class="font-mono text-[9px] uppercase tracking-widest text-slate-400">{l}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<div class="marquee border-y border-white/5 bg-charcoal/40" aria-hidden="true">
	<div class="marquee-track font-mono text-xs uppercase tracking-[0.25em] text-slate-400">
		<span>50+ sites live</span><span class="text-electric">·</span><span>M-Pesa ready</span><span class="text-electric">·</span><span>Live in days, not months</span><span class="text-electric">·</span><span>Reply in minutes</span><span class="text-electric">·</span>
		<span>50+ sites live</span><span class="text-electric">·</span><span>M-Pesa ready</span><span class="text-electric">·</span><span>Live in days, not months</span><span class="text-electric">·</span><span>Reply in minutes</span><span class="text-electric">·</span>
		<span aria-hidden="true">50+ sites live</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">M-Pesa ready</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">Live in days, not months</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">Reply in minutes</span><span class="text-electric" aria-hidden="true">·</span>
		<span aria-hidden="true">50+ sites live</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">M-Pesa ready</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">Live in days, not months</span><span class="text-electric" aria-hidden="true">·</span><span aria-hidden="true">Reply in minutes</span><span class="text-electric" aria-hidden="true">·</span>
	</div>
</div>

<script>
	(() => {
		async function initHero3D() {
			const canvas = document.getElementById("hero-canvas");
			if (!canvas || canvas.dataset.bound) return;
			canvas.dataset.bound = "1";
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			// Lazy-load Three.js after first paint so LCP is never blocked
			await new Promise((r) => requestIdleCallback ? requestIdleCallback(r, { timeout: 2000 }) : setTimeout(r, 800));
			const THREE = await import("three");

			const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "high-performance" });
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			renderer.setPixelRatio(dpr);
			renderer.setSize(window.innerWidth, window.innerHeight);

			const scene = new THREE.Scene();
			const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
			camera.position.set(0, 0, 50);

			// Geometric shapes representing "building blocks" of web design
			const shapes = [];
			const shapeGeometries = [
				new THREE.IcosahedronGeometry(1.5, 0),
				new THREE.OctahedronGeometry(1.8, 0),
				new THREE.TetrahedronGeometry(2, 0),
				new THREE.DodecahedronGeometry(1.3, 0),
				new THREE.BoxGeometry(2, 2, 2),
			];

			const material = new THREE.MeshPhysicalMaterial({
				color: 0x00c8ff,
				metalness: 0.1,
				roughness: 0.3,
				transmission: 0.3,
				thickness: 0.5,
				transparent: true,
				opacity: 0.15,
				wireframe: false,
			});

			const wireMaterial = new THREE.MeshBasicMaterial({
				color: 0x00c8ff,
				transparent: true,
				opacity: 0.08,
				wireframe: true,
			});

			for (let i = 0; i < 18; i++) {
				const geom = shapeGeometries[i % shapeGeometries.length];
				const mesh = new THREE.Mesh(geom, material);
				const wire = new THREE.Mesh(geom, wireMaterial);
				wire.scale.setScalar(1.02);

				const group = new THREE.Group();
				group.add(mesh);
				group.add(wire);

				group.position.set(
					(Math.random() - 0.5) * 80,
					(Math.random() - 0.5) * 50,
					(Math.random() - 0.5) * 60 - 20
				);
				group.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
				group.userData = {
					rotSpeed: { x: (Math.random() - 0.5) * 0.002, y: (Math.random() - 0.5) * 0.003, z: (Math.random() - 0.5) * 0.001 },
					floatOffset: Math.random() * Math.PI * 2,
					floatSpeed: 0.0005 + Math.random() * 0.0005,
					initialY: group.position.y,
				};
				scene.add(group);
				shapes.push(group);
			}

			// Ambient particles
			const particleCount = 800;
			const particleGeom = new THREE.BufferGeometry();
			const positions = new Float32Array(particleCount * 3);
			const colors = new Float32Array(particleCount * 3);
			const sizes = new Float32Array(particleCount);
			for (let i = 0; i < particleCount; i++) {
				positions[i * 3] = (Math.random() - 0.5) * 200;
				positions[i * 3 + 1] = (Math.random() - 0.5) * 120;
				positions[i * 3 + 2] = (Math.random() - 0.5) * 150 - 30;
				const colorChoice = Math.random();
				if (colorChoice < 0.5) {
					colors[i * 3] = 0; colors[i * 3 + 1] = 0.78; colors[i * 3 + 2] = 1; // electric
				} else if (colorChoice < 0.75) {
					colors[i * 3] = 0.74; colors[i * 3 + 1] = 0.95; colors[i * 3 + 2] = 1; // neon
				} else {
					colors[i * 3] = 1; colors[i * 3 + 1] = 1; colors[i * 3 + 2] = 1; // white
				}
				sizes[i] = Math.random() * 1.5 + 0.5;
			}
			particleGeom.setAttribute("position", new THREE.BufferAttribute(positions, 3));
			particleGeom.setAttribute("color", new THREE.BufferAttribute(colors, 3));
			particleGeom.setAttribute("size", new THREE.BufferAttribute(sizes, 1));
			const particleMat = new THREE.PointsMaterial({
				size: 1.5,
				vertexColors: true,
				transparent: true,
				opacity: 0.6,
				sizeAttenuation: true,
			});
			const particles = new THREE.Points(particleGeom, particleMat);
			scene.add(particles);

			// Subtle lights
			const ambient = new THREE.AmbientLight(0xffffff, 0.4);
			scene.add(ambient);
			const dirLight = new THREE.DirectionalLight(0x00c8ff, 0.3);
			dirLight.position.set(10, 20, 15);
			scene.add(dirLight);
			const dirLight2 = new THREE.DirectionalLight(0x3a8bff, 0.2);
			dirLight2.position.set(-10, -10, -10);
			scene.add(dirLight2);

			let mouseX = 0, mouseY = 0;
			let targetX = 0, targetY = 0;
			document.addEventListener("mousemove", (e) => {
				mouseX = (e.clientX / window.innerWidth) * 2 - 1;
				mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
			}, { passive: true });

			function animate(t) {
				const time = t * 0.001;
				targetX = mouseX * 0.15;
				targetY = mouseY * 0.15;
				camera.position.x += (targetX - camera.position.x) * 0.02;
				camera.position.y += (targetY - camera.position.y) * 0.02;
				camera.lookAt(0, 0, 0);

				shapes.forEach((g) => {
					g.rotation.x += g.userData.rotSpeed.x;
					g.rotation.y += g.userData.rotSpeed.y;
					g.rotation.z += g.userData.rotSpeed.z;
					g.position.y = g.userData.initialY + Math.sin(time * 1000 * g.userData.floatSpeed + g.userData.floatOffset) * 1.5;
				});

				particles.rotation.y += 0.00003;
				particles.rotation.x += 0.00001;

				renderer.render(scene, camera);
				requestAnimationFrame(animate);
			}

			function onResize() {
				const w = window.innerWidth, h = window.innerHeight;
				renderer.setSize(w, h);
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
			}
			window.addEventListener("resize", onResize, { passive: true });

			const observer = new IntersectionObserver((entries) => {
				if (entries[0].isIntersecting) requestAnimationFrame(animate);
			}, { rootMargin: "100px" });
			observer.observe(canvas);

			document.addEventListener("visibilitychange", () => {
				if (document.hidden) observer.unobserve(canvas);
				else observer.observe(canvas);
			});

			requestAnimationFrame(animate);
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initHero3D, { once: true });
		} else {
			initHero3D();
		}
		document.addEventListener("astro:page-load", initHero3D);
	})();
</script>