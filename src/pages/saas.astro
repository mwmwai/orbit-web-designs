---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config";
---

<Layout
	title="Custom SaaS — From KES 59,999 | Orbit"
	description="Custom SaaS apps from KES 59,999 — auth, dashboards, M-Pesa, deployed and handed over. You own it. Built in Nairobi, worldwide."
>
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-electric/15 blur-[140px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Custom SaaS</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Your idea as a <span class="text-gradient">real app.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">Auth, roles, onboarding, admin + user dashboards, M-Pesa + cards — deployed, documented, handed over with 3 months support. You own everything.</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={whatsappLink("Hi Orbit! I want a Custom SaaS App from 59,999 — my idea is...")} target="_blank" rel="noopener noreferrer" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-lg shadow-electric/20">Scope my SaaS — WhatsApp</a>
					<a href="/packages" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 hover:border-electric/60 hover:text-white">See pricing</a>
				</div>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto max-w-7xl px-5">
				<div class="grid gap-6 md:grid-cols-3">
					<div class="glow-border rounded-2xl p-6"><h3 class="font-semibold text-white">Auth & Roles</h3><p class="mt-2 text-sm text-slate-400">Login, roles, onboarding, permissions — ready for real users.</p></div>
					<div class="glow-border rounded-2xl p-6"><h3 class="font-semibold text-white">Dashboards</h3><p class="mt-2 text-sm text-slate-400">Admin + user views, sales/M-Pesa/bookings at a glance + CSV reports.</p></div>
					<div class="glow-border rounded-2xl p-6"><h3 class="font-semibold text-white">Payments</h3><p class="mt-2 text-sm text-slate-400">M-Pesa, cards, PayPal native — you own the keys and the money.</p></div>
				</div>
				<div class="mt-6 glow-border rounded-2xl p-8">
					<p class="font-semibold text-white">From KES 59,999 — what's included</p>
					<ul class="mt-4 grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
						<li class="flex gap-2"><span class="text-electric">✓</span> Auth, roles & onboarding flow</li>
						<li class="flex gap-2"><span class="text-electric">✓</span> Admin + user dashboards</li>
						<li class="flex gap-2"><span class="text-electric">✓</span> M-Pesa, card & PayPal</li>
						<li class="flex gap-2"><span class="text-electric">✓</span> Deployed, documented & handed over</li>
						<li class="flex gap-2"><span class="text-electric">✓</span> CSV export + business reports</li>
						<li class="flex gap-2"><span class="text-electric">✓</span> 3 months support + training</li>
					</ul>
					<a href={whatsappLink("Hi Orbit! I want a Custom SaaS App (from 59,999). My idea is...")} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block rounded-full btn-gradient px-8 py-3 font-semibold text-white">WhatsApp to scope →</a>
					<p class="mt-3 text-xs text-slate-500">Stay live with <a href="/care" class="text-electric hover:underline">SaaS Care 15,999/mo</a></p>
				</div>
			</div>
		</section>

		<CtaBand title="Have an idea?" text="Tell us what it does — we reply with scope, timeline and honest price." />
	</main>
	<Footer />
</Layout>
