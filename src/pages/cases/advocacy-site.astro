---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE_URL } from "../../config";

const caseStudyLd = {
	"@context": "https://schema.org",
	"@type": "CaseStudy",
	"@id": `${SITE_URL}/cases/advocacy-site#case-study`,
	name: "Advocacy Website Speed Case Study",
	description: "Advocacy website maintaining under 2s load time after 12 months through Orbit Care monthly speed tuning and optimization.",
	author: { "@type": "Organization", name: "Orbit Web Designs & Marketing", url: SITE_URL },
	publisher: { "@type": "Organization", name: "Orbit Web Designs & Marketing", url: SITE_URL },
	datePublished: "2026-09-01",
	about: {
		"@type": "Service",
		name: "Website Speed Optimization & Care",
		provider: { "@type": "Organization", name: "Orbit Web Designs & Marketing" },
	},
	result: "95+ PageSpeed score maintained 12 months post-launch; Business Care 7,999/mo; built 5 days, Business 39,999",
	url: `${SITE_URL}/cases/advocacy-site`,
};
const faqs = [
	{ q: "How did the site stay under 2 seconds for a year?", a: "Built 95+ speed with no bloat, then kept fast via monthly Care re-checks as content grew — compression, updates, speed audits. Built as Business (39,999) in 5 days, kept on Business Care (7,999/mo)." },
	{ q: "What does website care actually do each month?", a: "Hosting, SSL, backups, security patches, speed checks, content updates and WhatsApp support. Orbit Care: 4,999 (Starter) / 7,999 (Business) / 9,999 (Master) monthly, cancel anytime." },
	{ q: "Who owns the website and its files?", a: "You do — domain, content, files and credentials from day one at Orbit. Cancel Care anytime; the site keeps running." },
];

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---
<Layout title="Case — Advocacy Site Still <2s After 12 Months | Orbit" description="Advocacy site built for speed — still under 2s after a year via monthly Care tuning.">
	<script type="application/ld+json" set:html={JSON.stringify(caseStudyLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<Navbar />
	<main id="main">
		<section class="border-b border-white/5 py-16 pt-24">
			<div class="mx-auto max-w-3xl px-5">
				<p class="font-mono text-xs uppercase tracking-widest text-electric">■ Case · Advocacy · 12 months later</p>
				<h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Still &lt;2s after a year.</h1>
				<p class="mt-4 text-slate-400">Built 95+ speed, kept fast via monthly Care re-checks as content grew. No bloat, no plugin tax.</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-3 text-sm">
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Launch</p><p class="text-slate-400">Business 39,999, 5 days</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Care</p><p class="text-slate-400">Business Care 7,999/mo</p></div>
					<div class="glow-border rounded-xl p-4"><p class="font-semibold text-white">Now</p><p class="text-slate-400"><span data-counter>95</span>+ PageSpeed, 12mo later</p></div>
				</div>
				<p class="mt-6 text-xs text-slate-500"><a href="/care" class="text-electric hover:underline">How Care keeps speed →</a></p>
			</div>
		</section>
		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-3xl px-5">
				<h2 class="text-2xl font-bold tracking-tight text-white">Case questions</h2>
				<div class="mt-6 grid gap-4">
					{faqs.map((f) => (
						<details class="glow-border rounded-2xl p-6"><summary class="cursor-pointer list-none font-semibold text-white">{f.q}</summary><p class="mt-3 text-sm text-slate-400">{f.a}</p></details>
					))}
				</div>
			</div>
		</section>
		<CtaBand />
	</main>
	<Footer />
</Layout>


