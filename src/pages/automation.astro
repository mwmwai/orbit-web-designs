---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config";

const plans = [
	{
		name: "Custom AI Agent",
		price: "KES 57,999",
		usd: "≈ $385",
		eur: "≈ €355",
		blurb: "One agent that does one job brilliantly — replies, qualifies, books, follows up.",
		features: [
			"Trained on your business data",
			"WhatsApp / site chat / email",
			"Lead qualification & booking",
			"Handover to human when needed",
			"Deployed + 1 month tuning",
		],
		api: "Needs an AI API key (pay-per-use, a few dollars/month for most SMEs) + WhatsApp API fees for 24/7 bots. Your accounts, your bill — we wire it all.",
		cta: "Get my Agent",
		featured: true,
		icon: "M12 8V4H8M12 8l4-4M12 8v8m-4 4h8M9 16h6M10 12a2 2 0 114 0 2 2 0 01-4 0z",
		grad: "from-electric to-neon",
	},
	{
		name: "Workflow Automation",
		price: "KES 45,999",
		suffix: "/ workflow",
		usd: "≈ $310",
		eur: "≈ €285",
		blurb: "Remove the manual work — one workflow, end to end.",
		features: [
			"M-Pesa → Sheets / CRM logging",
			"Inquiry → WhatsApp → calendar",
			"Invoice / receipt auto-send",
			"No-code where possible, you own it",
			"Bundle discounts for 3+ workflows",
		],
		api: "Connector tools (Make, Zapier or self-hosted n8n) bill to you if used — usually under $20/month. Our fee is the build + handover.",
		cta: "Automate a workflow",
		featured: false,
		icon: "M13 10V3L4 14h7v7l9-11h-7z",
		grad: "from-violet-500 to-electric",
	},
	{
		name: "WhatsApp Responder",
		price: "KES 33,999",
		usd: "≈ $277",
		eur: "≈ €255",
		blurb: "Your WhatsApp Business replies instantly — day and night.",
		features: [
			"Greeting + away + quick replies",
			"Catalog + labels setup",
			"Click-to-chat button on your site",
			"Meta Business setup done for you",
			"One-time, you own it",
		],
		api: "This tier uses the free WhatsApp Business app — no API, no monthly fees. Full 24/7 auto-replies need Meta's API (first 1,000 conversations/month free, then Meta per-message rates).",
		cta: "Setup Responder",
		featured: false,
		icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
		grad: "from-[#25D366] to-emerald-400",
	},
];
---

<Layout
	title="AI Agents & Workflow Automation — From KES 33,999 | Orbit"
	description="Custom AI agents (KES 57,999), workflow automations (KES 45,999) and WhatsApp responders (KES 33,999). You pay the APIs, we do the work — M-Pesa native, deployed fast."
>
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Agents & Workflows</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					AI agents & workflows that <span class="text-gradient">do the work.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					We build one honest agent per job — no “24/7 employee” hype. Our fee is the build; the API bills stay in your name, on your accounts.
				</p>
				<div class="mt-6 flex max-w-2xl items-start gap-3 rounded-2xl border border-electric/30 bg-electric/5 px-6 py-4">
					<span class="text-electric">◈</span>
					<p class="text-sm leading-relaxed text-slate-300">
						<strong class="text-white">You pay the APIs, we do the work.</strong> AI usage, connector tools and WhatsApp message fees bill directly to you (usually a few dollars a month for an SME). We set everything up under your accounts — you own it all, no middleman markup, cancel anything anytime.
					</p>
				</div>
			</div>
		</section>

		<section class="py-20">
			<div class="mx-auto max-w-7xl px-5">
				<div class="grid items-stretch gap-6 lg:grid-cols-3">
					{plans.map((p, i) => (
						<article class="reveal" style={`transition-delay:${i * 70}ms`}>
							<div data-tilt class={`relative flex h-full flex-col rounded-2xl p-8 card-shine edge-glow hover-lift magnetic ${p.featured ? "border border-electric/50 bg-gradient-to-b from-electric/10 to-transparent shadow-2xl shadow-electric/10" : "glow-border"}`}>
								{p.featured && (
									<span class="mb-4 inline-flex w-fit rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">Most popular</span>
								)}
								<div class={`inline-flex w-fit rounded-xl bg-gradient-to-br ${p.grad} p-3.5 ring-1 ring-white/10`}>
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
								</div>
								<h3 class="mt-5 text-lg font-semibold text-white">{p.name}</h3>
								<p class="mt-2 text-sm text-slate-400">{p.blurb}</p>
								<p class="mt-6">
									<span class="text-gradient text-4xl font-extrabold tracking-tight">{p.price}</span>
									{p.suffix && <span class="text-sm text-stone">{p.suffix}</span>}
									<span class="mt-2 block text-sm font-semibold text-slate-300">{p.usd} <span class="text-stone">·</span> {p.eur}</span>
								</p>
								<ul class="mt-8 grid flex-1 content-start gap-3">
									{p.features.map((f) => (
										<li class="flex items-start gap-3 text-sm text-slate-300">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0"><path d="M20 6L9 17l-5-5" /></svg>
											{f}
										</li>
									))}
								</ul>
								<p class="mt-6 rounded-xl border border-white/10 bg-charcoal/60 px-4 py-3 text-xs leading-relaxed text-slate-400">
									<span class="font-semibold text-slate-200">API costs: </span>{p.api}
								</p>
								<a href={whatsappLink(`Hi Orbit! I'm interested in ${p.name} (${p.price}). Can you scope it for my business?`)} target="_blank" rel="noopener noreferrer" class={`mt-6 block rounded-full py-3 text-center font-semibold transition ${p.featured ? "btn-gradient text-white shadow-lg shadow-electric/25 hover:-translate-y-0.5" : "border border-edge bg-panel text-slate-200 hover:border-electric/60 hover:text-white"}`}>{p.cta}</a>
							</div>
						</article>
					))}
				</div>
				<p class="reveal mt-8 text-sm text-slate-500">Need something custom? <a href="/contact" class="text-electric hover:underline">Ask for a quote</a> — we scope honestly, APIs and all.</p>
			</div>
		</section>

		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-7xl px-5">
				<h2 class="text-2xl font-bold tracking-tight text-white">How we ship</h2>
				<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{[["Map", "We map the job + your data + which APIs it needs."], ["Build", "Agent or workflow wired to your accounts and tools."], ["Train", "Tested on your real chats and cases, tuned with you."], ["Launch", "You own everything. 1 month tuning included."]].map(([t, d], i) => (
						<article class="glow-border reveal rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
							<span class="text-gradient text-3xl font-extrabold">{i + 1}</span>
							<h3 class="mt-3 font-semibold text-white">{t}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-400">{d}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<CtaBand title="Want an agent or workflow?" text="Tell us the one job you want off your plate — we reply with scope, timeline, honest price and the API costs upfront." />
	</main>
	<Footer />
</Layout>
