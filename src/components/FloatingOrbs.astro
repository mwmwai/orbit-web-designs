---
// FloatingOrbs — lightweight CSS-3D decorative orbs for section backgrounds.
// SEO-safe: aria-hidden, no layout shift, respects reduced motion.
interface Props {
	variant?: "default" | "left" | "right" | "center";
}
const { variant = "default" } = Astro.props;
---

<div class={`orb-field orb-${variant}`} aria-hidden="true">
	<span class="orb orb-1"></span>
	<span class="orb orb-2"></span>
	<span class="orb orb-3"></span>
</div>

<style>
	.orb-field {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		perspective: 1000px;
	}
	.orb {
		position: absolute;
		border-radius: 50%;
		transform-style: preserve-3d;
		filter: blur(60px);
		opacity: 0.5;
	}
	.orb-1 {
		width: 320px; height: 320px;
		background: radial-gradient(circle, rgb(0 212 255 / 0.18), transparent 65%);
		animation: orbFloat1 14s ease-in-out infinite;
	}
	.orb-2 {
		width: 240px; height: 240px;
		background: radial-gradient(circle, rgb(58 139 255 / 0.15), transparent 65%);
		animation: orbFloat2 18s ease-in-out infinite;
	}
	.orb-3 {
		width: 160px; height: 160px;
		background: radial-gradient(circle, rgb(0 212 255 / 0.12), transparent 65%);
		animation: orbFloat3 11s ease-in-out infinite;
	}
	.orb-default .orb-1, .orb-right .orb-1 { right: -80px; top: -60px; }
	.orb-default .orb-2, .orb-right .orb-2 { right: 10%; bottom: -80px; }
	.orb-default .orb-3, .orb-right .orb-3 { right: 30%; top: 20%; }
	.orb-left .orb-1 { left: -80px; top: -60px; }
	.orb-left .orb-2 { left: 10%; bottom: -80px; }
	.orb-left .orb-3 { left: 30%; top: 20%; }
	.orb-center .orb-1 { left: 50%; top: -100px; transform: translateX(-50%); }
	.orb-center .orb-2 { left: 20%; bottom: -60px; }
	.orb-center .orb-3 { right: 20%; bottom: -40px; }
	@keyframes orbFloat1 {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(-30px, 25px, 40px) scale(1.08); }
	}
	@keyframes orbFloat2 {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(25px, -20px, -30px) scale(0.94); }
	}
	@keyframes orbFloat3 {
		0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
		50% { transform: translate3d(-15px, -25px, 50px) scale(1.12); }
	}
	@media (prefers-reduced-motion: reduce) {
		.orb { animation: none; }
	}
	@media (max-width: 640px) {
		.orb-1 { width: 200px; height: 200px; }
		.orb-2 { width: 150px; height: 150px; }
		.orb-3 { width: 100px; height: 100px; }
	}
</style>