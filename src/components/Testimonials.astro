---
const testimonials = [
	{
		quote: "Within weeks of launch we were getting inquiries from Google searches we never ranked for before.",
		name: "Amara O.",
		role: "Law firm partner",
	},
	{
		quote: "A year later the site still loads in under two seconds. They build for the long haul.",
		name: "Daniel M.",
		role: "Advocacy founder",
	},
	{
		quote: "M-Pesa just works. Hundreds of payments a month and we've never once called about the gateway.",
		name: "Wanjiru K.",
		role: "E-commerce owner",
	},
	{
		quote: "Page five to page one for our main service term in three months. The numbers speak.",
		name: "Brian T.",
		role: "Services business",
	},
	{
		quote: "Everything explained clearly at every step. Clean, modern, professional — and on time.",
		name: "Lydia A.",
		role: "Real estate marketing",
	},
	{
		quote: "They adapted the design to our brand, not the other way round. That's rare.",
		name: "Sofia N.",
		role: "Fashion label",
	},
];
---

<section id="testimonials" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Signals</p>
		<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
			Signals from clients, after launch.
		</h2>
		<p class="mt-4 flex items-center gap-3 text-slate-400">
			<span class="text-metal" aria-hidden>★★★★★</span>
			<span>5.0 average across verified reviews</span>
			<a href="/reviews" class="ml-2 text-sm text-electric hover:underline">All reviews →</a>
		</p>
	</div>

	<div class="marquee mt-10" aria-label="Client testimonials">
		<div class="marquee-track" style="animation-duration: 55s">
			{[...testimonials, ...testimonials].map((t) => (
				<figure class="glow-border edge-glow card-shine shrink-0 w-[360px] md:w-[420px] rounded-2xl p-6 mx-3">
					<div class="text-metal" aria-label="5 out of 5 stars">★★★★★</div>
					<blockquote class="mt-3 text-sm leading-relaxed text-slate-200">"{t.quote}"</blockquote>
					<figcaption class="mt-4 border-t border-edge/60 pt-3 flex items-center justify-between">
						<div><div class="text-sm font-semibold text-white">{t.name}</div><div class="mt-0.5 font-mono text-xs uppercase tracking-widest text-stone">{t.role}</div></div>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
	<p class="mt-4 text-center"><a href="/reviews" class="text-sm text-electric hover:underline">All reviews →</a></p>
</section>


