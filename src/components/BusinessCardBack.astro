---
import { SITE_NAME, SITE_URL, SITE_EMAIL, SITE_PHONE_DISPLAY } from "../config";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<style>
	.card-back {
		width: 3.5in;
		height: 2in;
		position: relative;
		overflow: hidden;
		background: #0A0F1D;
		color: #E7E9F2;
		border-radius: 0.125in;
		box-shadow:
			0 0 0 1px rgba(0, 200, 255, 0.08) inset,
			0 20px 50px rgba(0, 0, 0, 0.5),
			0 0 60px -10px rgba(0, 200, 255, 0.1);
	}

	.card-back::before {
		content: "";
		position: absolute;
		inset: 0;
		opacity: 0.04;
		background-image:
			linear-gradient(to right, #23233a 1px, transparent 1px),
			linear-gradient(to bottom, #23233a 1px, transparent 1px);
		background-size: 0.28in 0.28in;
		pointer-events: none;
	}

	.card-back::after {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 70%, transparent 40%, rgba(10, 15, 29, 0.9) 100%);
		pointer-events: none;
	}

	.content {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		padding: 0.22in 0.26in;
		gap: 0.18in;
	}

	.left-section {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		min-width: 0;
	}

	.logo-small {
		width: 0.55in;
		height: 0.55in;
	}

	.right-section {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: center;
		min-width: 0;
		flex: 1;
	}

	.contact-grid {
		display: flex;
		flex-direction: column;
		gap: 0.105in;
		width: 100%;
		max-width: 2.1in;
	}

	.headline {
		font-size: 10.5pt;
		font-weight: 800;
		line-height: 1.15;
		color: #FFFFFF;
		margin-bottom: 0.075in;
		letter-spacing: 0.01em;
		text-align: right;
	}

	.headline .grad {
		background: linear-gradient(90deg, #00C8FF, #2F7BFF);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.contact-row {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.11in;
	}

	.contact-row .ico {
		flex: none;
		width: 0.20in;
		height: 0.20in;
		border-radius: 0.05in;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, rgba(0, 200, 255, 0.16), rgba(47, 123, 255, 0.16));
		border: 1px solid rgba(0, 200, 255, 0.35);
	}

	.contact-row .ico svg {
		width: 0.12in;
		height: 0.12in;
		stroke: #00C8FF;
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.contact-row .txt {
		font-size: 7.6pt;
		color: #CBD5E1;
		white-space: nowrap;
		text-align: right;
	}

	.contact-row .txt b {
		color: #FFFFFF;
		font-weight: 700;
	}

	.qr-side {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.06in;
	}

	.qr-tile {
		width: 0.72in;
		height: 0.72in;
		background: #FFFFFF;
		border-radius: 0.07in;
		padding: 0.045in;
		box-shadow:
			0 0 0 1px rgba(0, 200, 255, 0.35),
			0 4px 14px rgba(0, 200, 255, 0.15);
	}

	.qr-tile svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	.scan-hint {
		font-size: 5.6pt;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #64748B;
		white-space: nowrap;
	}
</style>

<div class={`card-back ${className}`} role="img" aria-label="Orbit Web Designs business card back with contact details">
	<div class="content">
		<div class="left-section">
			<img src="/logo-mark-cropped.png" width="52" height="52" alt="Orbit logo" class="logo-small" style="mix-blend-mode:screen;border-radius:8px" />
		</div>

		<div class="right-section">
			<div class="contact-grid">
				<div class="headline">Get Your Business <span class="grad">Online</span></div>

				<div class="contact-row">
					<span class="ico" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					</span>
					<span class="txt"><b>{SITE_PHONE_DISPLAY}</b></span>
				</div>

				<div class="contact-row">
					<span class="ico" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
					</span>
					<span class="txt">WhatsApp <b>{SITE_PHONE_DISPLAY}</b></span>
				</div>

				<div class="contact-row">
					<span class="ico" aria-hidden="true">
						<svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
					</span>
					<span class="txt"><b>{SITE_EMAIL}</b></span>
				</div>

				<div class="contact-row">
					<span class="ico" aria-hidden="true">
						<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
					</span>
					<span class="txt"><b>orbitwebdesigns.co.ke</b></span>
				</div>
			</div>

			<div class="qr-side">
				<div class="qr-tile" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29 29" shape-rendering="crispEdges">
						<path fill="#FFFFFF" d="M0 0h29v29H0z"/>
						<path stroke="#0A0F1D" d="M0 0.5h7m2 0h2m4 0h2m2 0h2m1 0h7M0 1.5h1m5 0h1m2 0h1m2 0h1m4 0h2m3 0h1m5 0h1M0 2.5h1m1 0h3m1 0h1m1 0h3m1 0h1m1 0h1m1 0h1m2 0h2m1 0h1m1 0h3m1 0h1M0 3.5h1m1 0h3m1 0h1m1 0h2m6 0h4m2 0h1m1 0h3m1 0h1M0 4.5h1m1 0h3m1 0h1m1 0h1m2 0h1m1 0h3m1 0h4m1 0h1m1 0h3m1 0h1M0 5.5h1m5 0h1m1 0h1m2 0h7m2 0h1m1 0h1m5 0h1M0 6.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M8 7.5h4m1 0h1m1 0h1m2 0h3M0 8.5h1m1 0h5m5 0h1m1 0h2m1 0h1m4 0h5M0 9.5h4m5 0h3m3 0h2m1 0h3m1 0h3m3 0h1M0 10.5h1m5 0h2m1 0h1m2 0h1m4 0h2m1 0h1m2 0h2M0 11.5h4m3 0h1m2 0h1m1 0h1m1 0h1m1 0h1m4 0h1m3 0h1m1 0h1M1 12.5h1m1 0h4m3 0h2m4 0h2m1 0h1m5 0h2M0 13.5h2m1 0h2m2 0h2m1 0h2m1 0h3m1 0h4m1 0h3m3 0h1M0 14.5h1m3 0h3m1 0h2m1 0h1m1 0h5m2 0h1m4 0h2M1 15.5h1m2 0h1m2 0h3m1 0h1m1 0h1m1 0h1m3 0h1m2 0h1m1 0h1m2 0h1M1 16.5h3m2 0h1m1 0h2m2 0h1m1 0h2m1 0h2m1 0h1m4 0h2M0 17.5h2m2 0h2m2 0h1m2 0h2m2 0h10m1 0h1m1 0h1M0 18.5h1m1 0h1m1 0h1m1 0h2m1 0h1m1 0h1m5 0h1m2 0h1m5 0h1M0 19.5h1m2 0h1m4 0h4m2 0h1m1 0h1m1 0h1m1 0h1m3 0h1m2 0h1M0 20.5h1m1 0h1m3 0h1m1 0h2m2 0h1m3 0h2m2 0h5m1 0h3M8 21.5h1m1 0h1m1 0h4m1 0h2m1 0h1m3 0h5M0 22.5h7m2 0h3m1 0h8m1 0h1m1 0h3M0 23.5h1m5 0h1m1 0h1m1 0h4m1 0h1m3 0h2m3 0h1M0 24.5h1m1 0h3m1 0h1m1 0h1m1 0h1m1 0h2m1 0h1m2 0h5m1 0h1m1 0h1M0 25.5h1m1 0h3m1 0h1m1 0h6m1 0h2m1 0h1m4 0h1m1 0h2M0 26.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h1m5 0h1m1 0h7M0 27.5h1m5 0h1m9 0h1m3 0h2m1 0h1m1 0h1m1 0h1M0 28.5h7m1 0h2m4 0h1m3 0h2m1 0h3m2 0h1"/>
					</svg>
				</div>
				<div class="scan-hint">Scan to visit</div>
			</div>
		</div>
	</div>
</div>