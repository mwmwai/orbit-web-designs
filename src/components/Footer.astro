---
import { SITE_NAME, SITE_EMAIL, NAV_LINKS } from "../config";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 py-12">
	<div class="mx-auto max-w-7xl px-5">
		<div class="flex flex-col items-start justify-between gap-8 md:flex-row">
			<div>
				<a href="/" class="inline-flex items-center gap-4">
					<img src="/logo-mark.png" alt="Orbit logo" width={52} height={52} />
					<span class="leading-none">
						<span class="block bg-gradient-to-r from-slate-100 via-slate-300 to-slate-400 bg-clip-text text-2xl font-black tracking-[0.3em] text-transparent">ORBIT</span>
						<span class="mt-2 block text-[11px] font-semibold uppercase tracking-[0.26em] text-slate-500">Web Designs &amp; Marketing</span>
					</span>
				</a>
				<p class="mt-3 max-w-xs text-sm text-slate-500">
					Websites and digital marketing that grow your business.
				</p>
			</div>

			<nav class="grid grid-cols-2 gap-x-12 gap-y-3 text-sm sm:flex sm:gap-8" aria-label="Footer">
				{NAV_LINKS.map((l) => (
					<a href={l.href} class="text-slate-400 transition hover:text-white">{l.label}</a>
				))}
				<a href={`mailto:${SITE_EMAIL}`} class="text-slate-400 transition hover:text-white">Email Us</a>
			</nav>
		</div>

		<div class="mt-10 border-t border-white/5 pt-6 text-xs text-slate-500">
			© {year} {SITE_NAME}. All rights reserved.
		</div>
	</div>
</footer>


