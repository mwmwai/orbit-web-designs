---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config";
---

<Layout
	title="Web Design Nairobi — Business Websites from KES 29,999 | Orbit"
	description="Web designer in Nairobi building fast, mobile-first business websites from KES 29,999. Live in days, M-Pesa ready, Google optimized. Chat on WhatsApp."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Nairobi · Kenya</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Web design in Nairobi, <span class="text-gradient">built to bring customers.</span>
				</h1>
				<p class="mt-5 max-w-2xl text-lg text-slate-400">
					We design fast, mobile-first websites for Nairobi businesses — salons, shops, restaurants, firms. From KES 29,999, live in days, found on Google.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a href={whatsappLink("Hi Orbit! I need a website for my Nairobi business. What package fits me?")} target="_blank" rel="noopener noreferrer" class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white magnetic ripple">Get customers this week — chat now</a>
					<a href="/packages" class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">View pricing</a>
				</div>
			</div>
		</section>

		<section class="py-16">
			<div class="mx-auto grid max-w-7xl gap-6 px-5 md:grid-cols-3">
				{[
					["Starter 29,999", "1 landing page, mobile-first, WhatsApp button, basic SEO. Live in 48–72 hours."],
					["Business 39,999", "Up to 7 pages, full SEO setup, booking integration. Live in about 5 days."],
					["Master 49,999", "Online store or booking system, M-Pesa checkout, advanced SEO. Live in 7–10 days."],
				].map(([t, d]) => (
					<div class="glow-border rounded-2xl p-8">
						<h2 class="text-xl font-bold text-white">{t}</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{d}</p>
					</div>
				))}
			</div>
		</section>

		<section class="border-t border-white/5 py-16">
			<div class="mx-auto max-w-3xl px-5">
				<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Why Nairobi businesses pick Orbit</h2>
				<ul class="mt-6 grid gap-3 text-slate-300">
					<li class="flex items-start gap-3"><span class="text-electric">→</span> Reply in minutes, Mon–Sat — talk to the builder, not a sales desk.</li>
					<li class="flex items-start gap-3"><span class="text-electric">→</span> M-Pesa wired in from day one — checkout in under a minute.</li>
					<li class="flex items-start gap-3"><span class="text-electric">→</span> Found on Google — SEO setup and Business Profile included.</li>
					<li class="flex items-start gap-3"><span class="text-electric">→</span> Honest timelines — 48–72 hours for Starter, days not months for the rest.</li>
				</ul>
			</div>
		</section>

		<CtaBand title="Your competitors are online. Are you?" text="One message. One website. More customers. 10% off ends 30 September." />
	</main>
	<Footer />
</Layout>
