---
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<section id="top" class="relative overflow-hidden">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(to right, #23233a 1px, transparent 1px), linear-gradient(to bottom, #23233a 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(80% 70% at 20% 30%, black, transparent 80%)"></div>
		<div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-electric/15 blur-[140px]" style="animation: floaty 10s ease-in-out infinite"></div>
		<div class="absolute top-40 right-0 h-[400px] w-[400px] rounded-full bg-neon/10 blur-[120px]" style="animation: floaty 12s ease-in-out 2s infinite reverse"></div>
		<div class="film-grain"></div>
		<div class="vignette"></div>
		<div class="light-streak"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-5 pb-24 pt-24 md:pt-36">
		<p class="hero-anim mb-6 inline-flex items-center gap-2 rounded-full border border-edge bg-panel px-4 py-1.5 text-xs font-medium text-slate-300" style="animation-delay:0ms">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-electric opacity-60"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-electric"></span>
			</span>
			Websites that work
		</p>

		<h1 class="hero-anim max-w-3xl text-5xl font-extrabold leading-[1.05] tracking-tight text-white" style="animation-delay:100ms">
			We Build High-Performance Websites
			<span class="text-gradient">& Drive Real Growth.</span>
		</h1>

		<p class="hero-anim mt-6 max-w-2xl text-lg leading-relaxed text-slate-400" style="animation-delay:200ms">
			Web design, e-commerce, SEO & growth marketing — built to convert.
		</p>

		<div class="hero-anim mt-10 flex flex-wrap items-center gap-4" style="animation-delay:300ms">
			<a
				href={whatsappLink(DEFAULT_WA_MESSAGE)}
				target="_blank"
				rel="noopener noreferrer"
				class="rounded-full btn-gradient px-8 py-3.5 font-semibold text-white shadow-xl shadow-electric/30 hover:-translate-y-0.5 hover:shadow-electric/50 magnetic ripple"
			>
				Start your project
			</a>
			<a
				href="/packages"
				class="rounded-full border border-edge bg-panel px-8 py-3.5 font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white magnetic ripple"
			>
				View pricing
			</a>
		</div>

		<dl class="hero-anim mt-16 grid max-w-4xl grid-cols-2 gap-6 sm:grid-cols-4" style="animation-delay:420ms">
			{
				[
					["50+", "Websites shipped"],
					["25+", "M-Pesa stores"],
					["10+", "Industries"],
					["24h", "Reply time"],
				].map(([value, label]) => (
					<div data-tilt class="glow-border edge-glow hover-lift rounded-2xl px-6 py-5 transition duration-300 hover:-translate-y-1">
						<dt class="text-gradient counter-num text-2xl font-extrabold sm:text-3xl" data-counter>{value}</dt>
						<dd class="mt-1 text-sm text-slate-400">{label}</dd>
					</div>
				))
			}
		</dl>

		<div class="hero-anim mt-12 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-4" style="animation-delay:500ms">
			{
				["PageSpeed 95+", "Core Web Vitals Pass", "SEO Ready", "Mobile 100"].map((b) => (
					<div class="flex items-center gap-2 border border-edge/70 bg-charcoal/60 px-3 py-2.5 font-mono text-xs text-slate-300">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
						{b}
					</div>
				))
			}
		</div>
	</div>
</section>

<div class="marquee bg-charcoal/40" aria-hidden="true">
	<div class="marquee-track">
		{[0, 1].map(() => (
			<div class="flex shrink-0 items-center gap-14 font-mono text-xs uppercase tracking-[0.3em] text-stone">
				{["Web Design", "E-commerce", "M-Pesa", "SEO", "Branding", "Web Apps", "Care Plans"].map((t) => (
					<span class="flex items-center gap-14">
						{t}
						<span class="text-electric">✦</span>
					</span>
				))}
			</div>
		))}
	</div>
</div>
