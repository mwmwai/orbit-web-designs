<section id="services" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ What we do</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Our Core Services — Web Design, E-Commerce, SEO & Marketing
			</h2>
			<p class="mt-4 max-w-xl text-slate-400">
				Everything your brand needs to leave the ground — handled end-to-end.
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				services.map((s, i) => (
					<article
						data-tilt
						class="reveal card-shine glow-border edge-glow group relative flex flex-col rounded-2xl p-8 transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-electric/10 hover-lift magnetic"
						style={`transition-delay:${(i % 3) * 70}ms`}
					>
						<div class="flex items-start justify-between">
							<div class="inline-flex rounded-xl bg-gradient-to-br from-electric/20 to-neon/20 p-3.5 ring-1 ring-electric/30">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d={s.icon} stroke="#8fb8ff" />
								</svg>
							</div>
							<span class="font-mono text-sm text-stone/60">{s.num}</span>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-white">{s.title}</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400">{s.description}</p>
						<div class="mt-6 flex flex-wrap gap-2">
							{s.tags.map((t) => (
								<li class="list-none rounded-full border border-edge bg-charcoal px-3 py-1 font-mono text-xs text-slate-300">{t}</li>
							))}
						</div>
						<a href={s.link} class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-electric transition group-hover:gap-3">
							Explore <span aria-hidden>→</span>
						</a>
