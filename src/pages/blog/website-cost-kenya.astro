---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import Comments from "../../components/Comments.astro";
import { whatsappLink } from "../../config";

const faqs = [
	{
		q: "What should a business website cost in Kenya in 2026?",
		a: "KES 5k–15k for template/DIY, 25k–60k for a custom pro build (our range 29,999–49,999), 80k+ for agencies/marketplaces. The spread is page count, M-Pesa, copy and who does the work.",
	},
	{
		q: "How fast can my website go live?",
		a: "3–5 days for a 1–3 page starter if you have photos/text/logo, 1–2 weeks for 5–7 pages, 2–3 weeks for a store — anywhere else, demand a date in writing.",
	},
	{
		q: "Is there a monthly cost after launch?",
		a: "Hosting/SSL/backups are always monthly; cheap 'no monthly' offers either resell slow shared hosting or leave you to fix hacks alone. Budget 2k–12k/mo depending on care level.",
	},
];

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};

const articleJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: "How Much Does a Website Cost in Kenya?",
	description: "Market prices 2026: DIY to agency, what drives the price, hidden costs checklist and where Orbit 29,999–49,999 sits.",
	author: { "@type": "Organization", name: "Orbit Web Designs & Marketing" },
	datePublished: "2026-09-14",
};
---

<Layout
	title="How Much Does a Website Cost in Kenya? (2026 Prices) | Orbit"
	description="Market website prices in Kenya 2026: from KES 5k templates to 50k+ pro builds. Breakdown, hidden-cost checklist and honest comparison."
>
	<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<Navbar />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Pricing guide · 2026 · 6 min</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					How much does a website <span class="text-gradient">cost in Kenya?</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">Real market numbers — not just ours — and a checklist to avoid overpaying whether you hire us or not.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<!-- Market range -->
			<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">The market in 60 seconds</h2>
			<div class="mt-6 overflow-hidden rounded-2xl border border-edge">
				<table class="w-full text-left text-sm">
					<thead class="bg-panel text-xs uppercase tracking-widest text-slate-400"><tr><th class="px-5 py-3">Tier</th><th class="px-5 py-3">Typical price</th><th class="px-5 py-3">What you get</th></tr></thead>
					<tbody class="divide-y divide-edge text-slate-300">
						<tr><td class="px-5 py-3 font-semibold text-white">Template / DIY (Wix, WordPress)</td><td class="px-5 py-3">5k–15k</td><td class="px-5 py-3">You build it; slow support; plugin M-Pesa</td></tr>
						<tr><td class="px-5 py-3 font-semibold text-white">Freelancer pro</td><td class="px-5 py-3">25k–60k</td><td class="px-5 py-3">Custom design, copy, native M-Pesa, speed tuned</td></tr>
						<tr><td class="px-5 py-3 font-semibold text-white">Agency / marketplace</td><td class="px-5 py-3">80k–250k+</td><td class="px-5 py-3">Team, retainers, brand system, often overkill for SME</td></tr>
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm text-slate-400">Rule: under 10k you're buying your own time. Over 80k you're buying process you may not need.</p>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">What actually drives the price?</h2>
			<ul class="mt-6 grid gap-3 text-slate-300">
				<li class="flex items-start gap-3"><span class="text-electric">→</span> <span><strong class="text-white">Pages & content</strong> — each page needs design + real copy + images + tested forms.</span></li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> <span><strong class="text-white">Payments</strong> — native Daraja (Till/Paybill) wiring vs flaky plugin.</span></li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> <span><strong class="text-white">Copy & SEO</strong> — titles/descriptions/Business Profile that someone has to write.</span></li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> <span><strong class="text-white">Speed & ownership</strong> — PageSpeed 90+ and who owns domain/files.</span></li>
			</ul>

			<!-- Hidden cost checklist -->
			<div class="mt-10 rounded-2xl border border-amber-500/20 bg-amber-500/5 p-6">
				<h3 class="font-semibold text-white">Hidden-cost checklist — ask before you pay</h3>
				<ul class="mt-3 grid gap-2 text-sm text-slate-300">
					<li>☐ Domain + SSL + hosting included? For how long?</li>
					<li>☐ Monthly after launch? What does it cover (backups/security/updates/support)?</li>
					<li>☐ Who owns domain, files, M-Pesa credentials?</li>
					<li>☐ Revisions included? Design approval before launch in writing?</li>
					<li>☐ PageSpeed on cheap phone data, not fibre?</li>
				</ul>
			</div>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">Where Orbit sits (and when not to pick us)</h2>
			<div class="mt-6 grid gap-4">
				<div class="glow-border rounded-2xl p-6"><h3 class="font-semibold text-white">Starter — 29,999</h3><p class="mt-2 text-sm text-slate-400">1–3 pages, mobile-first, WhatsApp, basic SEO, polished copy. Live 3–5 days. Pick this if you're proving demand.</p></div>
				<div class="glow-border rounded-2xl p-6 border-electric/30"><h3 class="font-semibold text-white">Business — 39,999 · most picked</h3><p class="mt-2 text-sm text-slate-400">Up to 7 pages, full SEO, bookings, copy everywhere. Live 1–2 weeks.</p></div>
				<div class="glow-border rounded-2xl p-6"><h3 class="font-semibold text-white">Master — 49,999</h3><p class="mt-2 text-sm text-slate-400">Store/booking, M-Pesa+cards, advanced SEO, automations, training. 2–3 weeks. Price your margins first: <a href="/mpesa-fee-calculator" class="text-electric hover:underline">M-Pesa calculator →</a></p></div>
			</div>
			<p class="mt-6 text-sm text-slate-400">If you need 12 pages + ERP + multi-currency on day one, we're not the fit — an agency is. If you can DIY on Wix and only need a placeholder, do that and save the cash.</p>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">How to avoid overpaying — 4 moves</h2>
			<ol class="mt-6 grid gap-3 text-slate-300">
				<li class="flex gap-3"><span class="font-bold text-electric">1.</span> Start smallest that fits; grow into Master later — saves 10–20k upfront.</li>
				<li class="flex gap-3"><span class="font-bold text-electric">2.</span> Prep photos/text/logo one folder before briefing — every delay week is a cost.</li>
				<li class="flex gap-3"><span class="font-bold text-electric">3.</span> Get live-date + price in writing, with approval gate before launch.</li>
				<li class="flex gap-3"><span class="font-bold text-electric">4.</span> Read the terms on ownership — details on our <a href="/terms-of-service" class="text-electric hover:underline">Terms</a>.</li>
			</ol>

			<div class="mt-14 rounded-2xl border border-electric/40 bg-gradient-to-r from-electric/10 via-transparent to-neon/10 px-8 py-6">
				<p class="font-semibold text-white">Want a number for *your* business?</p>
				<p class="mt-1 text-sm text-slate-400">One WhatsApp, honest fit — even if the answer is "start smaller".</p>
				<a href={whatsappLink("Hi Orbit! I read your pricing guide — what package fits my business and what do I need to prepare?")} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-full btn-gradient px-8 py-3 font-semibold text-white">Get my fit on WhatsApp</a>
			</div>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">Quick answers</h2>
			<div class="mt-6 grid gap-4">
				{faqs.map((f) => (
					<details class="glow-border group rounded-2xl p-6">
						<summary class="cursor-pointer list-none font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">{f.q}</summary>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
					</details>
				))}
			</div>
		</article>

		<Comments slug="website-cost-kenya" />
		<CtaBand title="Still comparing?" text="Send any quote — we'll tell you if you're overpaying, even if it means not hiring us." />
	</main>
	<Footer />
</Layout>
