---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react/Navbar";
import Footer from "../components/Footer.astro";
import Pricing from "../components/Pricing.astro";
import CtaBand from "../components/CtaBand.astro";

const faqs = [
	{
		q: "How long does it take to build my website?",
		a: "It depends on the package. Basic landing pages are delivered in about 5 days, Full Business websites in 10–14 days, and e-commerce or custom builds in 3–4 weeks.",
	},
	{
		q: "Are revisions included?",
		a: "Yes. Every package includes revisions during the design and build stages — we refine layouts, content, and features until you are happy before launch.",
	},
	{
		q: "Do you write the content for me?",
		a: "Yes. Basic copywriting is included in every package. We structure your pages and write clear, conversion-focused copy based on the information you provide about your business.",
	},
	{
		q: "What happens after launch? Do you offer maintenance and support?",
		a: "Every package includes free support after launch — 1 month on Basic, 3 months on Business, and 6 months on E-commerce/Custom. Ongoing maintenance and marketing plans are available afterwards if you want us to keep growing your site.",
	},
];

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: f.a,
		},
	})),
};
---

<Layout
	title="Packages & Pricing — Websites from KES 29,999 | Orbit Web Designs & Marketing"
	description="Honest flexible pricing in Kenyan shillings. Professional websites from KES 29,999 — pay securely via M-Pesa, card, or PayPal. No hidden fees."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-7xl px-5 pb-16 pt-20 md:pt-28">
				<h1 class="hero-anim max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Simple packages, <span class="text-gradient">serious results.</span>
				</h1>
				<p class="hero-anim mt-5 max-w-2xl text-lg text-slate-400" style="animation-delay:120ms">
					Honest, flexible pricing in KES — no hidden fees. Pay securely with M-Pesa, card, or PayPal.
				</p>
			</div>
		</section>

		<Pricing />

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto max-w-7xl px-5">
				<div class="reveal flex flex-col items-start justify-between gap-6 rounded-2xl border border-edge/70 bg-charcoal/50 px-8 py-8 md:flex-row md:items-center">
					<div>
						<p class="text-lg font-semibold text-white">Need an agent, workflow or dashboard?</p>
					 <p class="mt-1 max-w-md text-sm text-slate-400">They live on their own pages with honest pricing and API costs upfront.</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a href="/automation" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Agents & Workflows</a>
						<a href="/dashboards" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Dashboards</a>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-20">
			<div class="mx-auto max-w-7xl px-5">
				<div class="reveal mb-10 max-w-xl">
					<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Frequently asked questions</h2>
					<p class="mt-4 text-slate-400">Everything you need to know before we start building.</p>
				</div>
				<div class="grid gap-4 lg:grid-cols-2">
					{
						faqs.map((f, i) => (
							<details class="reveal glow-border group rounded-2xl p-6" style={`transition-delay:${i * 80}ms`}>
								<summary class="cursor-pointer list-none font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">
									{f.q}
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-white/5 py-14">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-5">
				<span class="font-mono text-xs uppercase tracking-[0.18em] text-slate-500">Keep exploring:</span>
				<a href="/about" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">About Orbit</a>
				<a href="/guides" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Guides</a>
				<a href="/faq" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">FAQ</a>
				<a href="/reviews" class="rounded-full border border-edge bg-panel px-6 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-electric/60 hover:text-white">Reviews</a>
			</div>
		</section>

		<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

		<CtaBand />
	</main>
	<Footer />
</Layout>

