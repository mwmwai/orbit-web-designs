---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import { whatsappLink } from "../../config";

const faqs = [
	{
		q: "How much does a website cost in Kenya?",
		a: "Starter KES 24,999 (1 landing page), Business KES 34,999 (up to 5 pages), Master KES 44,999 (online store or booking system). Custom SaaS apps from KES 44,999 and graphic design from KES 14,999.",
	},
	{
		q: "How fast can my website go live?",
		a: "48–72 hours once we have your photos, text and logo. You approve the design before anything goes live.",
	},
	{
		q: "Do I pay monthly?",
		a: "Yes — a small monthly covers hosting, security, updates and support, so your site stays fast, safe and online.",
	},
];

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};

const articleJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: "How Much Does a Website Cost in Kenya?",
	description: "Honest 2026 website prices in Kenya: Starter KES 24,999, Business KES 34,999, Master KES 44,999. What affects the price and how to avoid overpaying.",
	author: { "@type": "Organization", name: "Orbit Web Designs & Marketing" },
	datePublished: "2026-09-14",
};
---

<Layout
	title="How Much Does a Website Cost in Kenya? (2026 Prices) | Orbit"
	description="Honest website prices in Kenya: Starter KES 24,999, Business KES 34,999, Master KES 44,999. What drives the price, monthly costs explained, and how to avoid overpaying."
>
	<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Pricing guide · 2026</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					How much does a website <span class="text-gradient">cost in Kenya?</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">Straight answer: <strong class="text-white">KES 24,999–44,999</strong> for a professional business website. Below is exactly what each price buys — and the traps that make people overpay.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<div class="grid gap-6">
				<div class="glow-border rounded-2xl p-8">
					<h2 class="text-2xl font-bold text-white">Starter — KES 24,999</h2>
					<p class="mt-3 leading-relaxed text-slate-400">One landing page that brings customers: mobile-first design, WhatsApp chat button, basic SEO, polished copy. Perfect for salons, barbershops, eateries and shops getting online for the first time. Live in 48–72 hours.</p>
				</div>
				<div class="glow-border rounded-2xl p-8">
					<h2 class="text-2xl font-bold text-white">Business — KES 34,999 <span class="ml-2 rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">Most popular</span></h2>
					<p class="mt-3 leading-relaxed text-slate-400">Up to 5 pages with full SEO setup, booking integration and copywriting for every page. For businesses ready to be found on Google and take bookings while they sleep.</p>
				</div>
				<div class="glow-border rounded-2xl p-8">
					<h2 class="text-2xl font-bold text-white">Master — KES 44,999</h2>
					<p class="mt-3 leading-relaxed text-slate-400">A full online store or booking system: M-Pesa, card and PayPal checkout, advanced SEO that targets buyers, and priority support. This is the one that pays for itself.</p>
				</div>
			</div>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">What makes websites expensive?</h2>
			<ul class="mt-6 grid gap-3 text-slate-300">
				<li class="flex items-start gap-3"><span class="text-electric">→</span> Page count — each extra page needs design, copy and testing.</li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> Payments — M-Pesa checkout and dashboards take real engineering.</li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> Copywriting — writing that sells is a separate skill from design.</li>
				<li class="flex items-start gap-3"><span class="text-electric">→</span> SEO — ranking on Google needs setup most cheap builders skip.</li>
			</ul>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">The monthly question, answered honestly</h2>
			<p class="mt-4 leading-relaxed text-slate-400">Yes, there is a small monthly after launch — it covers your hosting, security, updates and support. Without it, sites go slow, get hacked, or quietly die. Anyone selling you a website with zero ongoing cost is selling you a future problem.</p>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">How to avoid overpaying</h2>
			<ul class="mt-6 grid gap-3 text-slate-300">
				<li class="flex items-start gap-3"><span class="text-electric">1.</span> Start with the smallest package that fits — you can grow into Master later.</li>
				<li class="flex items-start gap-3"><span class="text-electric">2.</span> Prepare photos, text and logo upfront — delays cost money.</li>
				<li class="flex items-start gap-3"><span class="text-electric">3.</span> Insist on approving the design before launch — in writing.</li>
				<li class="flex items-start gap-3"><span class="text-electric">4.</span> Ask who owns what — read the terms before you pay a shilling.</li>
			</ul>

			<div class="mt-14 rounded-2xl border border-electric/40 bg-gradient-to-r from-electric/10 via-transparent to-neon/10 px-8 py-6">
				<p class="font-semibold text-white">Running now: 10% off new orders — ends 30 September.</p>
				<a href={whatsappLink("Hi Orbit! I read your pricing guide. I want a website — what package fits my business?")} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-full btn-gradient px-8 py-3 font-semibold text-white">Get my 10% off</a>
			</div>

			<h2 class="mt-14 text-2xl font-bold tracking-tight text-white sm:text-3xl">Quick answers</h2>
			<div class="mt-6 grid gap-4">
				{faqs.map((f) => (
					<details class="glow-border group rounded-2xl p-6">
						<summary class="cursor-pointer list-none font-semibold text-white marker:hidden [&::-webkit-details-marker]:hidden">{f.q}</summary>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{f.a}</p>
					</details>
				))}
			</div>
		</article>

		<CtaBand title="Your competitors are online. Are you?" text="One message. One website. More customers. 10% off ends 30 September." />
	</main>
	<Footer />
</Layout>
