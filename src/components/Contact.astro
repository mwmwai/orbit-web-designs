---
import ContactForm from "./react/ContactForm";
import { DEFAULT_WA_MESSAGE, whatsappLink } from "../config";
---

<section id="contact" class="border-t border-edge/40 py-28 md:py-36">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
			<div>
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Contact</p>
				<h2 class="mt-4 font-display text-3xl leading-none tracking-tight text-cream md:text-4xl">
					Let's build <span class="italic font-light text-metal">together.</span>
				</h2>
				<p class="mt-6 max-w-md leading-relaxed text-stone">
					Fill in the form. Or reach us directly — we reply within hours.
				</p>

				<a
					href={whatsappLink(DEFAULT_WA_MESSAGE)}
					target="_blank"
					rel="noopener noreferrer"
					class="link-underline mt-10"
				>
					Chat on WhatsApp <span aria-hidden>↗</span>
				</a>

				<div class="mt-12 grid gap-3 border-t border-edge/60 pt-8 font-mono text-xs uppercase tracking-widest text-stone">
					<p><span class="text-cream">Email</span> — <a href="mailto:mwmwai@gmail.com" class="underline decoration-edge underline-offset-4 transition hover:text-cream hover:decoration-metal">mwmwai@gmail.com</a></p>
					<p><span class="text-cream">Serving</span> — Clients worldwide, remote first</p>
					<p><span class="text-cream">Hours</span> — Mon–Sat, flexible</p>
				</div>
			</div>

			<div class="reveal border border-edge bg-panel p-8 md:p-10">
				<ContactForm client:visible />
			</div>
		</div>
	</div>
</section>
