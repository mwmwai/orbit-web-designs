---
const projects = [
	{ name: "Genthub Barbershop", type: "Booking", description: "Gallery and deposits, built to feel calm and fast.", image: "https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=70&w=900&auto=format&fit=crop", alt: "Barber at work" },
	{ name: "Sokoni Fresh", type: "E-commerce", description: "Groceries, M-Pesa, inventory — without the noise.", image: "https://images.unsplash.com/photo-1542838132-92c53300491e?q=70&w=900&auto=format&fit=crop", alt: "Fresh produce" },
	{ name: "Zawadi Crafts", type: "Storefront", description: "A quiet store that tripled inquiries.", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=70&w=900&auto=format&fit=crop", alt: "Product" },
	{ name: "Tatu Heights", type: "Real Estate", description: "Listings with filters, made effortless.", image: "https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=70&w=900&auto=format&fit=crop", alt: "Building" },
	{ name: "Mama Oliech", type: "Hospitality", description: "Menu, reservations, maps — one calm page.", image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=70&w=900&auto=format&fit=crop", alt: "Restaurant" },
	{ name: "FitZone Gym", type: "Landing", description: "Schedules and sign-up, no friction.", image: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=70&w=900&auto=format&fit=crop", alt: "Gym" },
];
---

<section id="work" class="border-t border-edge/40 py-28 md:py-36">
	<div class="mx-auto max-w-7xl px-6 md:px-8">
		<div class="reveal mb-16 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-stone">Selected work</p>
			<h2 class="mt-4 font-display text-3xl leading-none tracking-tight text-cream md:text-4xl">Built to <span class="italic font-light text-metal">last.</span></h2>
			<p class="mt-6 max-w-lg leading-relaxed text-stone">Six recent builds. Fast, quiet, and made to convert.</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
			{
				projects.map((p, i) => (
					<article class="reveal group overflow-hidden border border-edge bg-panel transition duration-500 hover:border-metal/20" style={`transition-delay:${(i % 3) * 70}ms`} data-tilt>
						<div class="relative h-56 overflow-hidden bg-charcoal">
							<img src={p.image} alt={p.alt} loading="lazy" class="h-full w-full object-cover opacity-80 grayscale contrast-[0.95] transition duration-700 group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-100" />
							<div class="absolute inset-0 bg-ink/20"></div>
							<span class="absolute left-4 top-4 border border-edge bg-ink/60 px-2.5 py-1 font-mono text-xs uppercase tracking-widest text-cream backdrop-blur">
								{p.type}
							</span>
						</div>
						<div class="p-6 md:p-7">
							<h3 class="font-display text-lg leading-tight text-cream">{p.name}</h3>
							<p class="mt-2 text-sm leading-relaxed text-stone">{p.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
