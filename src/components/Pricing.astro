---
const plans = [
	{
		name: "Starter",
		price: "KES 20,000",
		usd: "≈ $155",
		eur: "≈ €140",
		blurb: "1 landing page that brings customers.",
		features: [
			"1 custom landing page",
			"Mobile optimized — perfect on phones",
			"WhatsApp chat button built in",
			"Basic SEO so Google finds you",
			"Selling copy polished for you",
			"Live in 48–72 hours",
		],
		cta: "Claim 10% off",
		featured: false,
	},
	{
		name: "Business",
		price: "KES 30,000",
		usd: "≈ $230",
		eur: "≈ €215",
		blurb: "Up to 5 pages + bookings.",
		features: [
			"Up to 5 custom pages",
			"Full SEO setup — titles, Google profile",
			"Booking integration (WhatsApp/Calendly)",
			"Mobile optimized throughout",
			"Copywriting for every page",
			"Live in 48–72 hours",
		],
		cta: "Claim 10% off",
		featured: true,
	},
	{
		name: "Master",
		price: "KES 40,000",
		usd: "≈ $310",
		eur: "≈ €285",
		blurb: "Store or booking system that sells.",
		features: [
			"E-commerce or full booking system",
			"M-Pesa, card & PayPal checkout",
			"Advanced SEO that targets buyers",
			"Everything in Business included",
			"Priority support — jump the queue",
			"Training so you run it yourself",
		],
		cta: "Claim 10% off",
		featured: false,
	},
	{
		name: "Custom SaaS App",
		price: "KES 40,000",
		usd: "≈ $310",
		eur: "≈ €285",
		blurb: "Your idea as a real app — dashboards, payments, ready to sell.",
		features: [
			"Auth, roles & onboarding flow",
			"Admin + user dashboards",
			"M-Pesa, card & PayPal payments",
			"Deployed, documented & handed over",
			"Training so you're never stuck",
			"3 months of support",
		],
		cta: "Claim 10% off",
		featured: false,
	},
	{
		name: "Graphic Design",
		price: "KES 10,000+",
		usd: "≈ $78+",
		eur: "≈ €70+",
		blurb: "Logos to full brand kits — from 10k to 20k.",
		features: [
			"Logos from KES 10,000",
			"Social media kits",
			"Brand identity up to KES 20,000",
			"Marketing creatives & flyers",
			"Fast turnaround",
			"Revisions included",
		],
		cta: "Claim 10% off",
		featured: false,
	},
];
---

<section id="pricing" class="section-glow border-t border-white/5 py-24">
	<div class="mx-auto max-w-7xl px-5">
		<div class="text-reveal mb-14 max-w-2xl">
			<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Pricelist</p>
			<p class="mt-3 text-sm text-slate-400">★★★★★ Trusted by 50+ Kenyan businesses — salons, shops, restaurants.</p>
			<h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Straight-line pricing. Clear as the night sky.
			</h2>
			<p class="mt-4 max-w-xl text-slate-400">
				Five packages built for growing businesses — flexible payment, delivered fast.
			</p>
		</div>

		<div class="reveal mb-10 flex flex-col items-center justify-between gap-4 rounded-2xl border border-electric/40 bg-gradient-to-r from-electric/10 via-transparent to-neon/10 px-8 py-5 md:flex-row">
			<p class="text-sm font-semibold text-white sm:text-base">10% off new orders — <span class="text-gradient">ends 30 September.</span> <span class="text-slate-400">New clients only, one per business.</span></p>
			<a href="/contact" class="rounded-full btn-gradient px-6 py-2.5 text-sm font-semibold text-white">Claim 10% off</a>
		</div>

		<div class="grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				plans.map((p, i) => (
					<article class="reveal" style={`transition-delay:${i * 70}ms`}>
						<div
							data-tilt
							class={`relative flex h-full flex-col rounded-2xl p-8 card-shine edge-glow hover-lift magnetic ${
								p.featured
									? "border border-electric/50 bg-gradient-to-b from-electric/10 to-transparent shadow-2xl shadow-electric/10"
									: "glow-border"
							}`}
						>
							{p.featured && (
								<span class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-electric to-neon px-3 py-1 font-mono text-xs uppercase tracking-widest text-white">
									Most popular
								</span>
							)}
							<h3 class="text-lg font-semibold text-white">{p.name}</h3>
							<p class="mt-2 text-sm text-slate-400">{p.blurb}</p>
							<p class="mt-6">
								<span class="text-gradient text-4xl font-extrabold tracking-tight">{p.price}</span>
								<span class="mt-2 block text-sm font-semibold text-slate-300">{p.usd} <span class="text-stone">·</span> {p.eur}</span>
							</p>
							<ul class="mt-8 grid flex-1 content-start gap-3">
								{p.features.map((f) => (
									<li class="flex items-start gap-3 text-sm text-slate-300">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5fe6ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0">
											<path d="M20 6L9 17l-5-5" />
										</svg>
										{f}
									</li>
								))}
							</ul>
							<a
								href="/contact"
								class={`mt-8 block rounded-full py-3 text-center font-semibold transition ${
									p.featured
										? "btn-gradient text-white shadow-lg shadow-electric/25 hover:-translate-y-0.5"
										: "border border-edge bg-panel text-slate-200 hover:border-electric/60 hover:text-white"
								}`}
							>
								{p.cta}
							</a>
						</div>
					</article>
				))
			}
		</div>

		<p class="reveal mt-8 text-sm text-slate-500">
			Need something different? <a href="/contact" class="text-electric hover:underline">Ask for a custom quote</a> — or browse care plans on request.
		</p>
	</div>
</section>

<section id="payments" class="border-t border-white/5 pb-8 pt-4">
	<div class="mx-auto max-w-7xl px-5">
		<div class="glow-border reveal flex flex-col items-start gap-6 rounded-2xl px-8 py-8 md:flex-row md:items-center md:justify-between">
			<div>
				<h3 class="text-lg font-semibold text-white">Payments, handled quietly.</h3>
				<p class="mt-1 max-w-md text-sm text-slate-400">M-Pesa, cards and PayPal — secure, verified, no drama.</p>
			</div>
			<div class="flex flex-wrap items-center gap-3 font-mono text-xs uppercase tracking-widest">
				<span class="border border-edge px-4 py-2 text-stone">M-Pesa</span>
				<span class="border border-edge px-4 py-2 text-stone">Card</span>
				<span class="border border-edge px-4 py-2 text-stone">PayPal</span>
			</div>
		</div>
	</div>
</section>


