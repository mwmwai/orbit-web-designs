---
interface Props {
	slug: string;
}

const { slug } = Astro.props;
---

<section class="mx-auto max-w-3xl px-5 pb-20" data-comments={slug}>
	<h2 class="text-2xl font-bold tracking-tight text-white">Comments</h2>
	<div class="mt-6 grid gap-4" data-comment-list>
		<p class="text-sm text-slate-500" data-comment-empty>Be the first to comment.</p>
	</div>
	<form class="mt-8 grid gap-3" data-comment-form>
		<div class="grid gap-3 sm:grid-cols-2">
			<input
				type="text"
				name="name"
				required
				maxlength="60"
				placeholder="Your name"
				aria-label="Your name"
				class="rounded-xl border border-edge bg-charcoal px-4 py-3 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-electric"
			/>
		</div>
		<textarea
			name="text"
			required
			rows={3}
			maxlength="1000"
			placeholder="Say something useful — comments appear after approval."
			aria-label="Your comment"
			class="resize-y rounded-xl border border-edge bg-charcoal px-4 py-3 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-electric"
		></textarea>
		<div>
			<button type="submit" class="rounded-full btn-gradient px-6 py-2.5 text-sm font-semibold text-white">Post comment</button>
		</div>
		<p class="hidden text-xs text-slate-400" data-comment-msg></p>
	</form>
</section>

<script>
	(() => {
		const root = document.querySelector("[data-comments]") as HTMLElement | null;
		if (!root || root.dataset.bound) return;
		root.dataset.bound = "1";
		const slug = root.dataset.comments as string;
		const list = root.querySelector("[data-comment-list]") as HTMLElement;
		const form = root.querySelector("[data-comment-form]") as HTMLFormElement;
		const msg = root.querySelector("[data-comment-msg]") as HTMLElement;
		const empty = root.querySelector("[data-comment-empty]") as HTMLElement | null;

		const URL = (import.meta as unknown as { env: Record<string, string | undefined> }).env.PUBLIC_SUPABASE_URL;
		const KEY = (import.meta as unknown as { env: Record<string, string | undefined> }).env.PUBLIC_SUPABASE_ANON_KEY;

		function esc(s: string) {
			return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
		}

		async function load() {
			if (!URL || !KEY) return;
			try {
				const res = await fetch(`${URL}/rest/v1/comments?slug=eq.${encodeURIComponent(slug)}&approved=eq.true&select=name,text,created_at&order=created_at.asc`, {
					headers: { apikey: KEY, Authorization: `Bearer ${KEY}` },
				});
				if (!res.ok) return;
				const rows = (await res.json()) as Array<{ name: string; text: string; created_at: string }>;
				if (!rows.length) return;
				empty?.remove();
				for (const r of rows) {
					const d = document.createElement("div");
					d.className = "rounded-2xl border border-edge/70 bg-charcoal/50 px-5 py-4";
					const when = new Date(r.created_at).toLocaleDateString("en-KE", { year: "numeric", month: "short", day: "numeric" });
					d.innerHTML = `<p class="text-sm font-semibold text-white">${esc(r.name)} <span class="ml-2 font-normal text-slate-500">${esc(when)}</span></p><p class="mt-2 text-sm leading-relaxed text-slate-300">${esc(r.text)}</p>`;
					list.appendChild(d);
				}
			} catch { /* silent — comments are a bonus, never break the page */ }
		}

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const data = new FormData(form);
			const name = String(data.get("name") || "").trim().slice(0, 60);
			const text = String(data.get("text") || "").trim().slice(0, 1000);
			if (!name || !text) return;
			msg.classList.remove("hidden");
			if (!URL || !KEY) {
				msg.textContent = "Comments are waking up — meanwhile, WhatsApp us your thought instead.";
				return;
			}
			msg.textContent = "Posting…";
			try {
				const res = await fetch(`${URL}/rest/v1/comments`, {
					method: "POST",
					headers: { apikey: KEY, Authorization: `Bearer ${KEY}`, "Content-Type": "application/json", Prefer: "return=minimal" },
					body: JSON.stringify({ slug, name, text }),
				});
				msg.textContent = res.ok
					? "Thanks! Your comment appears after a quick review."
					: "Couldn't post — try WhatsApp instead, we reply in minutes.";
				if (res.ok) form.reset();
			} catch {
				msg.textContent = "Couldn't post — try WhatsApp instead, we reply in minutes.";
			}
		});

		void load();
	})();
</script>
