---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import Comments from "../../components/Comments.astro";
import { whatsappLink } from "../../config";
---

<Layout
	title="M-Pesa Till vs Paybill: Which One for Your Business? | Orbit"
	description="Till vs Paybill in Kenya: fees, account numbers, which suits shops, salons and online stores. Plus how each wires into your website."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides · M-Pesa</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Till vs Paybill: <span class="text-gradient">pick right once.</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">Wrong choice costs you fees and headaches for years. Here's the 3-minute version.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<div class="grid gap-6 md:grid-cols-2">
				<div class="glow-border rounded-2xl p-8">
					<h2 class="text-xl font-bold text-white">Till — walk-in sales</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate-400">Customer pays to your number in person. No account number to type, money lands instantly. Perfect for shops, salons, eateries — anyone paid face to face.</p>
				</div>
				<div class="glow-border rounded-2xl p-8">
					<h2 class="text-xl font-bold text-white">Paybill — tracked sales</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate-400">Customer enters business number + account number. That account field auto-matches payments to invoices and clients — gold for online stores and retainers.</p>
				</div>
			</div>
			<div class="glow-border mt-6 rounded-2xl p-8">
				<h2 class="text-xl font-bold text-white">The rule of thumb</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate-400">Walk-in money → Till. Invoiced or online money → Paybill. Many businesses run both: till at the counter, paybill on the website. Our stores wire both, and our <a href="/mpesa-fee-calculator" class="text-electric hover:underline">fee calculator</a> shows what each costs you.</p>
			</div>
			<div class="mt-8">
				<a href={whatsappLink("Hi Orbit! I need help choosing Till vs Paybill for my business.")} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full btn-gradient px-8 py-3.5 font-semibold text-white">Ask us free on WhatsApp</a>
			</div>
		</article>

		<Comments slug="mpesa-till-vs-paybill" />
		<CtaBand title="Selling online or at the counter?" text="We wire both — tell us what you sell." />
	</main>
	<Footer />
</Layout>
