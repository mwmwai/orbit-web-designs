---
import { DEFAULT_WA_MESSAGE, whatsappLink, NAV_LINKS } from "../config";

const path = Astro.url.pathname;
const wa = whatsappLink(DEFAULT_WA_MESSAGE);
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4">
		<div class="flex items-center gap-6 lg:gap-10">
			<a href="/" class="flex items-center gap-2.5 lg:gap-3.5">
				<img src="/logo-mark.png" alt="Orbit logo" width="40" height="40" />
				<span class="leading-none">
					<span class="block bg-gradient-to-r from-slate-100 via-slate-300 to-slate-400 bg-clip-text text-lg lg:text-xl font-black tracking-[0.3em] text-transparent">ORBIT</span>
					<span class="mt-1 block text-[9px] lg:text-[10px] font-semibold uppercase tracking-[0.26em] text-slate-500">Web Designs <span class="text-electric">&</span> Marketing</span>
				</span>
			</a>
			<nav class="hidden items-center gap-4 lg:gap-7 lg:flex" aria-label="Main">
				{NAV_LINKS.map((l) => (
					<a href={l.href} class={`nav-link text-sm transition-colors duration-300 ${path === l.href ? "is-active font-semibold text-white" : "text-slate-300 hover:text-white"}`}>{l.label}</a>
				))}
			</nav>
		</div>
		<div class="flex items-center gap-2 lg:gap-3">
			<a href={wa} target="_blank" rel="noopener noreferrer" class="btn-gradient rounded-full px-4 py-2 text-xs font-semibold text-white shadow-lg shadow-electric/25 hover:shadow-electric/40 md:px-6 md:py-2.5 md:text-sm">Get started</a>
			<button type="button" id="nav-toggle" class="rounded-lg border border-edge p-2 text-slate-300 transition hover:border-electric/60 md:hidden" aria-label="Toggle menu" aria-expanded="false">
				<svg id="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
				<svg id="nav-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
		</div>
	</div>
	<nav id="nav-mobile" class="animate-menu hidden border-t border-white/5 px-4 pb-6 pt-3 md:hidden" aria-label="Mobile" style="max-width: 320px; margin: 0 auto;">
		{NAV_LINKS.map((l) => (
			<a href={l.href} class={`block px-4 py-3 rounded-xl transition ${path === l.href ? "bg-electric/10 font-semibold text-white" : "text-slate-300 hover:text-white hover:bg-white/5"}`}>{l.label}</a>
		))}
		<a href={wa} target="_blank" rel="noopener noreferrer" class="btn-gradient mt-4 block rounded-full px-6 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-electric/25">Get started</a>
	</nav>
</header>
<script>
	(() => {
		function initNav() {
			const btn = document.getElementById("nav-toggle");
			const menu = document.getElementById("nav-mobile");
			if (!btn || !menu || btn.dataset.bound) return;
			btn.dataset.bound = "1";
			const openI = document.getElementById("nav-icon-open");
			const closeI = document.getElementById("nav-icon-close");
			btn.addEventListener("click", () => {
				const closed = menu.classList.toggle("hidden");
				btn.setAttribute("aria-expanded", String(!closed));
				if (openI) openI.classList.toggle("hidden", !closed);
				if (closeI) closeI.classList.toggle("hidden", closed);
			});
			menu.querySelectorAll("a[href^='/']").forEach((a) => {
				a.addEventListener("click", () => {
					menu.classList.add("hidden");
					btn.setAttribute("aria-expanded", "false");
					if (openI) openI.classList.remove("hidden");
					if (closeI) closeI.classList.add("hidden");
				});
			});
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initNav, { once: true });
		} else {
			initNav();
		}
		document.addEventListener("astro:page-load", initNav);
	})();
</script>
