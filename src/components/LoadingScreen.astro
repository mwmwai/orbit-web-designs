---
---

<div id="loading-screen" class="fixed inset-0 z-[200] flex items-center justify-center bg-ink">
  <div class="flex flex-col items-center justify-center gap-8">
    <div class="relative w-28 h-28">
      <svg class="w-full h-full" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="electricGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#00c8ff" />
            <stop offset="100%" stop-color="#2f7bff" />
          </linearGradient>
        </defs>
        <!-- Outer orbit ring -->
        <circle class="orbit-ring" cx="28" cy="28" r="24" stroke="url(#electricGradient)" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" stroke-linecap="round" style="animation: orbitDraw 1s ease-out forwards, orbitRotate 4s linear infinite 1s; transform-origin: 28px 28px;" />
        <!-- Inner pulse ring -->
        <circle class="pulse-ring" cx="28" cy="28" r="14" stroke="#00c8ff" stroke-width="1.5" fill="none" stroke-opacity="0.3" style="animation: pulseRing 1.5s ease-out infinite 0.5s; transform-origin: 28px 28px;" />
        <!-- Logo mark -->
        <circle class="logo-mark" cx="28" cy="28" r="10" fill="url(#electricGradient)" style="animation: logoScale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s forwards; transform-origin: 28px 28px; opacity: 0;" />
        <!-- Orbit text -->
        <text x="28" y="32" class="orbit-text" text-anchor="middle" font-family="system-ui, sans-serif" font-size="3.5" font-weight="800" fill="#00c8ff" style="animation: textFade 0.3s ease-out 1.2s forwards; opacity: 0;">ORBIT</text>
      </svg>
    </div>
    <div class="loading-progress">
      <div class="progress-bar" style="animation: progressFill 1.2s ease-out forwards;"></div>
    </div>
    <p class="loading-text font-mono text-xs uppercase tracking-widest text-slate-500">Loading your orbit...</p>
  </div>
  <style>
    @keyframes orbitDraw {
      to { stroke-dashoffset: 0; }
    }
    @keyframes orbitRotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes pulseRing {
      0% { transform: scale(0.8); stroke-opacity: 0.4; }
      50% { transform: scale(1.2); stroke-opacity: 0.1; }
      100% { transform: scale(0.8); stroke-opacity: 0.4; }
    }
    @keyframes logoScale {
      0% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes textFade {
      to { opacity: 1; }
    }
    @keyframes progressFill {
      from { width: 0%; }
      to { width: 100%; }
    }
    .loading-progress {
      width: 160px;
      height: 4px;
      background: rgba(255,255,255,0.08);
      border-radius: 9999px;
      overflow: hidden;
      margin-top: 4px;
    }
    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #00c8ff, #2f7bff);
      border-radius: 9999px;
      box-shadow: 0 0 20px rgba(0, 200, 255, 0.5);
    }
    .loading-text {
      animation: textFade 0.3s ease-out 1.6s forwards;
      opacity: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .orbit-ring, .pulse-ring, .logo-mark, .orbit-text, .progress-bar, .loading-text {
        animation: none !important;
        stroke-dashoffset: 0;
        opacity: 1;
        transform: none;
        width: 100%;
      }
    }
  </style>
</div>
<script>
  (() => {
    const loadingScreen = document.getElementById('loading-screen');
    if (!loadingScreen) return;

    const hideLoading = () => {
      loadingScreen.style.opacity = '0';
      loadingScreen.style.transition = 'opacity 0.4s ease-out';
      setTimeout(() => loadingScreen.remove(), 400);
    };

    const minDisplayTime = 800;
    const startTime = Date.now();

    const checkReady = () => {
      const elapsed = Date.now() - startTime;
      if (document.readyState === 'complete') {
        const remaining = minDisplayTime - elapsed;
        setTimeout(hideLoading, Math.max(0, remaining));
      } else {
        window.addEventListener('load', () => {
          const elapsed = Date.now() - startTime;
          const remaining = minDisplayTime - elapsed;
          setTimeout(hideLoading, Math.max(0, remaining));
        }, { once: true });
      }
    };

    checkReady();
  })();
</script>