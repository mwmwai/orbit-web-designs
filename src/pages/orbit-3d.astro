import GlobalBackdrop from "../components/react/orbit3d/GlobalBackdrop.tsx";
import "../styles/global.css";

const wa = "https://wa.me/254741992308?text=" + encodeURIComponent("Hi Orbit! I want a full-3D website for my brand. Show me what you can do.");

const services = [
  { n: "01", t: "Web Design & Development", d: "Custom builds engineered for speed, clarity and conversion — landing pages to full platforms.", tags: ["Landing pages", "Business sites", "Custom apps"] },
  { n: "02", t: "E-commerce & M-Pesa", d: "Stores with M-Pesa, cards and PayPal wired in from day one — checkout in under a minute.", tags: ["Stores", "M-Pesa", "Inventory"] },
  { n: "03", t: "SEO & Growth", d: "Technical, on-page and local SEO that ranks you for searches that pay.", tags: ["Technical SEO", "Local SEO", "Google"] },
  { n: "04", t: "Digital Marketing", d: "Meta, Google and TikTok campaigns built around real funnels — measured, not guessed.", tags: ["Meta Ads", "Google Ads", "Funnels"] },
  { n: "05", t: "Brand & Identity", d: "Logos, identity systems, social kits and creatives that look the part everywhere.", tags: ["Logos", "Identity", "Social kits"] },
  { n: "06", t: "3D & Motion", d: "WebGL hero scenes, product configurators and scroll-driven 3D storytelling.", tags: ["WebGL", "Configurators", "Motion"] },
];

const work = [
  { name: "Genthub Barbershop", type: "Booking", img: "https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=70&w=800&auto=format&fit=crop" },
  { name: "Sokoni Fresh", type: "E-commerce", img: "https://images.unsplash.com/photo-1542838132-92c53300491e?q=70&w=800&auto=format&fit=crop" },
  { name: "Zawadi Crafts", type: "Storefront", img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?q=70&w=800&auto=format&fit=crop" },
  { name: "Tatu Heights", type: "Real Estate", img: "https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=70&w=800&auto=format&fit=crop" },
  { name: "Mama Oliech", type: "Hospitality", img: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=70&w=800&auto=format&fit=crop" },
  { name: "FitZone", type: "Landing", img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=70&w=800&auto=format&fit=crop" },
];

const steps = [
  { n: "01", t: "Ignite", d: "Map goals, audience and the orbit you want to own." },
  { n: "02", t: "Blueprint", d: "Wireframes and 3D mockups you approve first." },
  { n: "03", t: "Build", d: "Hand-crafted build with 3D, SEO and speed baked in." },
  { n: "04", t: "Lift-off", d: "Go live, get trained, and climb from day one." },
];

const testimonials = [
  { q: "Our bookings doubled in a month. The 3D hero makes us look twice our size.", who: "Genthub Barbershop · Nairobi" },
  { q: "M-Pesa checkout just works. Customers finish payment in under a minute.", who: "Sokoni Fresh · Kiambu" },
  { q: "Wholesale inquiries tripled. The site sells while we sleep.", who: "Zawadi Crafts · Online" },
];

const pricing = [
  { t: "Launch", p: "KES 20,000", d: "One-page cinematic site, WhatsApp + maps, live in 48–72h." },
  { t: "Business 3D", p: "KES 45,000", d: "Multi-section + 3D hero, M-Pesa ready, SEO baked in." },
  { t: "Commerce+", p: "KES 90,000", d: "Full store + interactive 3D stage, inventory, training." },
];
