---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
import Comments from "../../components/Comments.astro";
import { whatsappLink } from "../../config";
---

<Layout
	title="WhatsApp Business Setup Kenya: Get Customers Chatting | Orbit"
	description="Turn WhatsApp into your best salesperson: Business profile, catalog, quick replies, click-to-chat. Setup from KES 29,999 or free DIY steps inside."
>
	<Navbar client:load />
	<main id="main">
		<section class="relative overflow-hidden border-b border-white/5">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-40 left-1/3 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-electric/15 blur-[130px]"></div>
			</div>
			<div class="relative mx-auto max-w-3xl px-5 pb-14 pt-20 md:pt-28">
				<p class="font-mono text-xs uppercase tracking-[0.18em] text-electric">■ Guides · WhatsApp</p>
				<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
					Turn WhatsApp into <span class="text-gradient">your best salesperson.</span>
				</h1>
				<p class="mt-5 text-lg text-slate-400">Every Kenyan customer already lives in WhatsApp. Here's how to meet them there — free steps plus when to pay for setup.</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 py-16">
			<div class="grid gap-6">
				{[
					["Business profile, done right", "Logo, hours, location, catalog with prices. A complete profile converts browsers; an empty one repels them."],
					["Greeting + away messages", "Instant hellos and honest away hours. Customers forgive slow replies — never silence."],
					["Quick replies + labels", "One-tap answers for prices, hours, location. Labels sort chats: new, paid, pending, VIP."],
					["Click-to-chat everywhere", "Every page, receipt and flyer links straight to chat with a prefilled message. Zero friction between interest and inquiry."],
				].map(([t, d]) => (
					<div class="glow-border rounded-2xl p-8">
						<h2 class="text-xl font-bold text-white">{t}</h2>
						<p class="mt-3 text-sm leading-relaxed text-slate-400">{d}</p>
					</div>
				))}
			</div>
			<p class="mt-10 leading-relaxed text-slate-400">DIY all of the above in an afternoon — or our WhatsApp Responder setup (KES 29,999) does profile, catalog, labels, replies and site buttons for you in one go.</p>
			<div class="mt-8">
				<a href={whatsappLink("Hi Orbit! Set up my WhatsApp Business properly.")} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full btn-gradient px-8 py-3.5 font-semibold text-white">Set mine up</a>
			</div>
		</article>

		<Comments slug="whatsapp-business-kenya" />
		<CtaBand title="Your customers are already chatting." text="Be the business that answers first — reply in minutes, Mon–Sat." />
	</main>
	<Footer />
</Layout>
